---
// Dark closing band used on the services pages: book a call or get a free audit.
import { site } from '../../../data/site';
interface Props { title?: string; text?: string }
const {
  title = 'Ready to start?',
  text = 'Book a free 30 minute strategy call with Dom, or get a free audit of your product first.',
} = Astro.props;
---
<section class="sc-wrap">
  <div class="sc">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="bs">
      <a class="m-btn dk" href={site.bookPage}>Book a free call</a>
      <a class="m-btn lt" href="/audit">Get a free audit</a>
    </div>
  </div>
</section>

<style>
  .sc-wrap { width: min(960px, 100% - 32px); margin: 0 auto; padding: 56px 0 72px; }
  .sc { background: #111; color: #fff; border-radius: 4px; padding: 44px 48px; display: flex; align-items: center; justify-content: space-between; gap: 32px; }
  h2 { margin: 0; font-family: var(--m-serif); font-weight: 400; font-size: 30px; line-height: 1.15; letter-spacing: -.01em; }
  p { margin: 8px 0 0; color: #b2b2ae; font-size: 14.5px; max-width: 460px; }
  .bs { display: flex; gap: 8px; }
  .m-btn { height: 44px; padding: 0 18px; font-size: 14.5px; }
  .m-btn.dk { background: #fff; color: #111; box-shadow: 2px 2px 0 #3f3f3f; }
  .m-btn.lt { background: transparent; color: #fff; box-shadow: inset 0 0 0 1px #6a6a66; }
  @media (max-width: 720px) {
    .sc-wrap { padding: 40px 0 56px; }
    .sc { flex-direction: column; align-items: flex-start; padding: 28px 22px; gap: 20px; }
    h2 { font-size: 26px; }
    .bs { flex-direction: column; width: 100%; }
    .m-btn { width: 100%; }
  }
</style>
