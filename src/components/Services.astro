---
import { services, industries, site } from '../data/site';
const shapes: Record<string, string> = { a: 'M0 0H20V8H8V20H0Z', b: 'M0 0H20V20H12V8H0Z', c: 'M20 0V20H0V12H12V0Z', d: 'M0 0H8V12H20V20H0Z' };
---
<section id="services" class="container section">
  <div class="head" data-reveal>
    <div><p class="kicker">Services</p><h2 class="h2">Everything a SaaS product needs to look and feel world class.</h2></div>
    <a class="side" href={site.bookPage}>Discuss your project →</a>
  </div>
  <div class="panel tint-blue">
    {services.map((s, i) => (
      <a class="svc" href={`/services/${s.slug}`} data-reveal style={`transition-delay:${i * 70}ms`}>
        <div class="top">
          <span class="icon glass">
            <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><defs><linearGradient id={`sv${i}`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#7d89ff" /><stop offset="1" stop-color="#1a28d6" /></linearGradient></defs><path d={shapes[s.shape]} fill={`url(#sv${i})`} /></svg>
          </span>
          <span class="n">0{i + 1}</span>
        </div>
        <h3>{s.title}</h3>
        <p>{s.text}</p>
        <ul>{s.tags.map((t) => <li>{t}</li>)}</ul>
        <span class="more">Explore {s.title} <span aria-hidden="true">→</span></span>
      </a>
    ))}
  </div>
  <div class="inds"><span class="label">Industries</span>{industries.map((x) => <span class="ind glass"><span class="lift">{x}</span></span>)}</div>
</section>

<style>
  .section { padding-top: 140px; }
  .head { display: flex; justify-content: space-between; align-items: flex-end; gap: 40px; margin-bottom: 32px; }
  .head .kicker { margin: 0 0 12px; }
  .head .h2 { max-width: 760px; }
  .side { text-decoration: none; color: #4a4f5e; font-size: 15px; white-space: nowrap; padding-bottom: 6px; }
  .panel { border-radius: var(--radius-lg); padding: 20px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .svc { text-decoration: none; color: inherit; background: #fff; border-radius: var(--radius-md); box-shadow: 0 0 0 1px var(--line); padding: 30px; display: flex; flex-direction: column; gap: 16px; min-height: 290px; transition: transform .5s var(--ease-out), box-shadow .3s; }
  .svc:hover { box-shadow: 0 0 0 1px var(--line), 0 20px 40px rgba(20,30,90,.08); }
  .top { display: flex; justify-content: space-between; align-items: flex-start; }
  .icon { width: 48px; height: 48px; border-radius: 15px; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, rgba(255,255,255,.9), rgba(255,255,255,.5)); transition: transform .6s var(--ease-spring); }
  .icon svg { position: relative; z-index: 3; }
  .svc:hover .icon { transform: rotate(90deg); }
  .n { font-family: var(--mono); font-size: 12px; color: #a3a8b6; }
  h3 { margin: 0; font-size: 28px; letter-spacing: -0.03em; font-weight: 500; }
  p { margin: 0; font-size: 16px; line-height: 1.55; color: var(--muted); max-width: 460px; }
  .more { font-size: 14px; color: var(--blue); display: flex; gap: 6px; }
  .more span { transition: transform .3s var(--ease-spring); }
  .svc:hover .more span { transform: translateX(4px); }
  ul { margin: auto 0 0; padding: 0; list-style: none; display: flex; gap: 8px; flex-wrap: wrap; }
  li { border-radius: 999px; background: #f4f5f8; padding: 7px 12px; font-size: 13px; color: var(--ink-2); }
  .inds { display: flex; align-items: center; gap: 10px; margin-top: 20px; flex-wrap: wrap; }
  .label { font-family: var(--mono); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--muted-2); margin-right: 8px; }
  .ind { border-radius: 999px; padding: 8px 14px; font-size: 14px; }
  .lift { position: relative; z-index: 3; }
  @media (max-width: 860px) {
    .head { flex-direction: column; align-items: flex-start; gap: 16px; }
    .panel { grid-template-columns: 1fr; padding: 12px; gap: 12px; }
    .svc { padding: 24px; min-height: 0; }
  }
  @media (max-width: 720px) { .section { padding-top: 96px; } h3 { font-size: 24px; } }
</style>
