---
import Mark from './home/Mark.astro';
import { site } from '../data/site';
import { publishedPosts } from '../data/blog';
const hasBlog = (await publishedPosts()).length > 0;
const year = new Date().getFullYear();
---
<footer class="ft">
  <div class="row">
    <a class="fb" href="/"><span data-egg-trigger class="egg-mark"><Mark size={16} /></span><b>Fackt</b></a>
    <nav aria-label="Footer">
      <a href="/#work">Work</a><a href="/#services">Services</a><a href="/#pricing">Pricing</a>{hasBlog && <a href="/blog">Blog</a>}<a href="/audit">Free audit</a><a href={site.bookPage}>Book a call</a>
    </nav>
    <div class="so">{site.socials.map((s) => <a href={s.href} rel="noopener">{s.label}</a>)}</div>
  </div>
  <div class="row r2">
    <span class="lc">Product design for SaaS, {site.location}
      <span class="bdg">{site.badges.map((b) => {
        const inner = <><svg width="12" height="12" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.6 2.1 3.3-.3.9 3.2 2.9 1.6-1.2 3.1 1.2 3.1-2.9 1.6-.9 3.2-3.3-.3L12 22l-2.6-2.1-3.3.3-.9-3.2-2.9-1.6 1.2-3.1-1.2-3.1 2.9-1.6.9-3.2 3.3.3z" fill="#111"></path><path d="M8 12.3l2.6 2.6L16 9.5" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg>{b.label}</>;
        return b.href ? <a class="b" href={b.href} rel="noopener">{inner}</a> : <span class="b">{inner}</span>;
      })}</span>
    </span>
    <a href={`mailto:${site.email}`}>{site.email}</a>
    <span class="lg"><a href="/privacy">Privacy</a><a href="/privacy#cookies" data-consent-open>Cookie settings</a><span>&copy; {year} Fackt Labs LLC</span></span>
  </div>
</footer>

<style>
  .ft { width: min(960px, 100% - 32px); margin: 0 auto; padding: 26px 0 30px; border-top: 1px solid #dcdcd8; font-size: 13.5px; color: #111; }
  .ft a { color: inherit; text-decoration: none; }
  .ft a:hover { text-decoration: underline; }
  .row { display: flex; align-items: center; gap: 24px; }
  .fb { display: flex; align-items: center; gap: 8px; }
  .fb b { font-weight: 500; }
  .egg-mark { display: inline-flex; cursor: pointer; }
  nav { display: flex; gap: 22px; margin-left: 24px; }
  .so { display: flex; gap: 18px; margin-left: auto; }
  .r2 { margin-top: 18px; font-size: 12.5px; color: #8a8a86; justify-content: space-between; }
  .lc { display: inline-flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .bdg { display: inline-flex; gap: 6px; }
  .lg { display: inline-flex; gap: 16px; flex-wrap: wrap; }
  .bdg .b { display: inline-flex; align-items: center; gap: 5px; height: 22px; padding: 0 8px 0 6px; border-radius: 3px; box-shadow: inset 0 0 0 1px #dcdcd8; background: #fff; color: #111; font-size: 11.5px; font-weight: 500; }
  .ft .bdg a.b:hover { text-decoration: none; box-shadow: inset 0 0 0 1px #111; }
  @media (max-width: 720px) {
    .row { flex-wrap: wrap; gap: 14px 18px; }
    nav { margin-left: 0; flex-basis: 100%; order: 2; flex-wrap: wrap; gap: 12px 18px; }
    .so { order: 1; }
    .r2 { flex-direction: column; align-items: flex-start; gap: 6px; }
  }
</style>
