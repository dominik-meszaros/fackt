---
// Centred section heading with one of the homepage sketch icons above it (service and niche pages).
import sketch from '../../generated/sketch.json';
interface Props { icon?: keyof typeof sketch.sections; eyebrow: string; title: string; sub?: string; as?: 'h2' | 'h3' }
const { icon, eyebrow, title, sub } = Astro.props;
const svg = icon ? sketch.sections[icon].replace('class="sk"', 'class="sh-sk"') : '';
---
<div class="sh">
  {svg && <Fragment set:html={svg} />}
  <span class="sh-eb">{eyebrow}</span>
  <h2>{title}</h2>
  {sub && <p>{sub}</p>}
</div>
<style>
  .sh { text-align: center; }
  .sh :global(.sh-sk) { display: block; width: 84px; height: 84px; margin: 0 auto 12px; overflow: visible; }
  .sh-eb { display: block; font-size: 11px; font-weight: 500; letter-spacing: .06em; text-transform: uppercase; color: #8a8a86; }
  h2 { margin: 10px 0 0; font-family: var(--m-serif); font-weight: 400; font-size: 34px; line-height: 1.12; letter-spacing: -.01em; }
  p { margin: 10px auto 0; max-width: 520px; color: #6a6a66; font-size: 15px; }
  @media (max-width: 720px) {
    .sh :global(.sh-sk) { width: 64px; height: 64px; margin-bottom: 8px; }
    h2 { font-size: 28px; }
    p { font-size: 14px; }
  }
</style>
