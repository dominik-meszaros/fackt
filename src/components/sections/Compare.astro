---
// Before and after slider: both screens sit in the same spot, drag the handle (or use the arrow keys) to reveal.
interface Props { before: string; after: string; beforeAlt: string; afterAlt: string; beforeCap: string; afterCap: string; width?: number }
const { before, after, beforeAlt, afterAlt, beforeCap, afterCap, width = 260 } = Astro.props;
---
<div class="cmp" style={`--w:${width}px`} data-cmp>
  <span class="lab l">Before</span><span class="lab r">After</span>
  <div class="frame">
    <img class="b" src={before} alt={beforeAlt} loading="lazy" decoding="async" />
    <div class="a" style="--p:50%"><img src={after} alt={afterAlt} loading="lazy" decoding="async" /></div>
  </div>
  <div class="bar" style="left:50%" role="slider" tabindex="0" aria-label="Compare before and after" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50"><span class="knob">&#8596;</span></div>
  <p class="cap l">{beforeCap}</p><p class="cap r">{afterCap}</p>
</div>
<style>
  .cmp { position: relative; margin-top: 36px; height: 520px; border-radius: 4px; background: #f2f2f0; overflow: hidden; touch-action: pan-y; user-select: none; cursor: ew-resize; }
  .frame { position: absolute; left: 50%; top: 40px; width: var(--w); transform: translateX(-50%); }
  .frame img { width: 100%; border-radius: 12px; box-shadow: 0 0 0 1px #e0e0dc; pointer-events: none; }
  .a { position: absolute; inset: 0; clip-path: inset(0 0 0 var(--p)); }
  .bar { position: absolute; top: 0; bottom: 0; width: 1px; background: #111; outline: none; }
  .knob { position: absolute; left: -18px; top: calc(50% - 18px); width: 36px; height: 36px; border-radius: 50%; background: #fff; box-shadow: inset 0 0 0 1px #111, 2px 2px 0 #c8c8c4; display: flex; align-items: center; justify-content: center; font-size: 14px; transition: transform .25s cubic-bezier(.3, 1.4, .4, 1); }
  .bar:focus-visible .knob, .cmp:hover .knob { transform: scale(1.08); }
  .lab { position: absolute; top: 20px; z-index: 2; padding: 4px 9px; border-radius: 2px; background: #fff; box-shadow: inset 0 0 0 1px #dcdcd8; font-size: 12px; font-weight: 500; }
  .lab.l { left: 20px; } .lab.r { right: 20px; }
  .cap { position: absolute; bottom: 18px; margin: 0; width: 34%; font-size: 13.5px; color: #6a6a66; }
  .cap.l { left: 20px; } .cap.r { right: 20px; text-align: right; }
  @media (max-width: 720px) {
    .cmp { height: 440px; } .frame { width: min(var(--w), 62%); top: 54px; }
    .cap { display: none; }
  }
</style>
<script>
  // the bar's position sets where the "after" screen starts, measured against the screen itself
  document.querySelectorAll<HTMLElement>('[data-cmp]').forEach((root) => {
    const frame = root.querySelector<HTMLElement>('.frame')!, after = root.querySelector<HTMLElement>('.a')!, bar = root.querySelector<HTMLElement>('.bar')!;
    let pct = 50;
    const set = (p: number) => {
      pct = Math.max(0, Math.min(100, p));
      const fr = frame.getBoundingClientRect(), rr = root.getBoundingClientRect();
      after.style.setProperty('--p', `${pct}%`);
      bar.style.left = `${fr.left - rr.left + (fr.width * pct) / 100}px`;
      bar.setAttribute('aria-valuenow', String(Math.round(pct)));
    };
    const fromX = (x: number) => { const fr = frame.getBoundingClientRect(); set(((x - fr.left) / fr.width) * 100); };
    let drag = false;
    root.addEventListener('pointerdown', (e) => { drag = true; root.setPointerCapture(e.pointerId); fromX(e.clientX); });
    root.addEventListener('pointermove', (e) => { if (drag) fromX(e.clientX); });
    root.addEventListener('pointerup', () => { drag = false; });
    bar.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') set(pct - 5); if (e.key === 'ArrowRight') set(pct + 5); });
    addEventListener('resize', () => set(pct));
    set(50);
  });
</script>
