---
// Two columns, row by row: what most teams do, and what we do instead.
interface Props { left: string; right: string; rows: { them: string; us: string }[] }
const { left, right, rows } = Astro.props;
---
<div class="ct2">
  <div class="hd"><span>{left}</span><span>{right}</span></div>
  {rows.map((r) => (<div class="r"><p class="them">{r.them}</p><p class="us">{r.us}</p></div>))}
</div>
<style>
  .ct2 { margin: 36px auto 0; max-width: 860px; text-align: left; border-top: 1px solid #111; }
  .hd, .r { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
  .hd { padding: 12px 0; border-bottom: 1px solid #e6e6e2; font-size: 11px; font-weight: 500; letter-spacing: .06em; text-transform: uppercase; color: #8a8a86; }
  .r { padding: 16px 0; border-bottom: 1px solid #ececea; }
  p { margin: 0; font-size: 15px; }
  .them { color: #8a8a86; text-decoration: line-through; text-decoration-color: #b8b8b4; }
  .us { color: #111; font-weight: 500; }
  @media (max-width: 720px) { .hd { display: none; } .r { grid-template-columns: 1fr; gap: 4px; } }
</style>
