---
// Two 24 hour rulers, the client's city above ours, shifted by the time difference. Shaded bands show
// the call window (their morning) and the design hours (their night). Hours are local to each row.
interface Band { from: number; to: number; label: string; kind: 'call' | 'work' }
interface Props { city: string; home: string; diff: number; bands: Band[] }
const { city, home, diff, bands } = Astro.props;
const H = Array.from({ length: 25 }, (_, i) => i);
const fmt = (h: number) => { const x = ((h % 24) + 24) % 24; return x === 0 ? '12a' : x < 12 ? `${x}a` : x === 12 ? '12p' : `${x - 12}p`; };
const fmt24 = (h: number) => String(((h % 24) + 24) % 24).padStart(2, '0');
const pct = (h: number) => (h / 24) * 100;
---
<div class="dr">
  <div class="row">
    <span class="nm">{city}</span>
    <div class="track">
      {bands.map((b) => <span class:list={['band', b.kind]} style={`left:${pct(b.from)}%;width:${pct(b.to - b.from)}%`}><em>{b.label}</em></span>)}
      {H.filter((h) => h % 3 === 0).map((h) => <i style={`left:${pct(h)}%`}>{h < 24 ? fmt(h) : ''}</i>)}
    </div>
  </div>
  <div class="row">
    <span class="nm">{home}</span>
    <div class="track home">
      {bands.map((b) => <span class:list={['band', b.kind]} style={`left:${pct(b.from)}%;width:${pct(b.to - b.from)}%`} />)}
      {H.filter((h) => h % 3 === 0).map((h) => <i style={`left:${pct(h)}%`}>{h < 24 ? fmt24(h + diff) : ''}</i>)}
    </div>
  </div>
  <div class="key">
    {bands.map((b) => <span><b class:list={['sw', b.kind]} />{b.label}: {fmt(b.from)} to {fmt(b.to)} in {city}, {fmt24(b.from + diff)}:00 to {fmt24(b.to + diff)}:00 in {home}</span>)}
  </div>
</div>
<style>
  .dr { margin-top: 40px; text-align: left; }
  .row { display: grid; grid-template-columns: 140px 1fr; align-items: center; gap: 16px; }
  .row + .row { margin-top: 10px; }
  .nm { font-size: 13.5px; font-weight: 500; }
  .track { position: relative; height: 54px; border-radius: 4px; background: #f2f2f0; box-shadow: inset 0 0 0 1px #e6e6e2; }
  .track i { position: absolute; bottom: 6px; transform: translateX(-50%); font: 500 10.5px 'Geist Mono', ui-monospace, monospace; font-style: normal; color: #6a6a66; background: #f2f2f0; padding: 0 3px; border-radius: 2px; }
  .track i:first-of-type { transform: none; margin-left: 6px; }
  .track i::before { content: ''; position: absolute; left: 50%; bottom: 16px; width: 1px; height: 8px; background: #9a9a96; }
  .band { position: absolute; top: 0; bottom: 0; }
  .band.call { background: #111; }
  .band.work { background-image: repeating-linear-gradient(130deg, #c8c8c4 0 1px, transparent 1px 6px); box-shadow: inset 0 0 0 1px #c8c8c4; }
  .band em { position: absolute; left: 0; top: -22px; font-style: normal; font-size: 12px; font-weight: 500; white-space: nowrap; color: #111; }
  .dr { padding-top: 22px; }
  .key { display: flex; flex-wrap: wrap; gap: 8px 24px; margin-top: 16px; padding-left: 156px; font-size: 13px; color: #6a6a66; }
  .key span { display: inline-flex; align-items: center; gap: 8px; }
  .sw { width: 14px; height: 10px; border-radius: 2px; }
  .sw.call { background: #111; }
  .sw.work { background-image: repeating-linear-gradient(130deg, #9a9a96 0 1px, transparent 1px 4px); box-shadow: inset 0 0 0 1px #9a9a96; }
  @media (max-width: 720px) {
    .row { grid-template-columns: 1fr; gap: 6px; }
    .track { height: 46px; }
    .track i { font-size: 9.5px; }
    .band em { display: none; } .dr { padding-top: 0; }
    .key { padding-left: 0; flex-direction: column; }
  }
</style>
