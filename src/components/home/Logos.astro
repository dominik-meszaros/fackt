---
// CMS: Settings > Homepage > Logos. A logo image is optional; without one the name is set in type.
import { homeSettings } from '../../data/settings';
const { logosTitle, logos } = homeSettings;
---
<section class="m-sec lg" aria-label={logosTitle}>
  <span class="t">{logosTitle}</span>
  <ul>
    {logos.map((l) => <li>{l.logo ? <img src={l.logo} alt={l.name} loading="lazy" /> : l.name}</li>)}
  </ul>
</section>
<style>
  .lg { padding-top: 64px; }
  .t { font-size: 12.5px; color: #8a8a86; }
  ul { list-style: none; margin: 24px 0 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 22px 44px; width: min(820px, 100%); }
  li { font-size: 14px; font-weight: 500; color: #a3a3a3; letter-spacing: -.01em; display: flex; align-items: center; justify-content: center; min-height: 24px; }
  img { display: block; height: 22px; width: auto; max-width: 128px; object-fit: contain; opacity: .38; }
  @media (max-width: 720px) { ul { gap: 18px 28px; } img { height: 18px; max-width: 104px; } li { font-size: 13px; } }
</style>
