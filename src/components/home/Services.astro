---
import SectionHead from './SectionHead.astro';
import sketch from '../../generated/sketch.json';
import { services } from '../../data/site';
const icon = (slug: string) => ((sketch.services as Record<string, string>)[slug] ?? '').replace('class="sk"', 'class="si"');
---
<section class="m-sec" id="services">
  <SectionHead icon="design" title="What we design" lede="One studio from first flow to final pixel." />
  <div class="svcs">
    {services.map((s) => (
      <a class="svc" href={`/services/${s.slug}`}>
        <Fragment set:html={icon(s.slug)} />
        <b>{s.title}</b>
        <p>{s.text}</p>
        <div class="tags">{s.tags.join(', ')}</div>
      </a>
    ))}
  </div>
</section>
<style>
  .svcs { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: 40px; width: min(960px, 100%); text-align: left; border-top: 1px solid #ececea; }
  .svc { padding: 26px 22px 4px 0; color: inherit; text-decoration: none; }
  .svc + .svc { padding-left: 22px; border-left: 1px solid #ececea; }
  .svc :global(.si) { display: block; width: 64px; height: 64px; margin-left: -6px; overflow: visible; }
  b { display: block; margin-top: 14px; font-weight: 500; font-size: 15px; }
  .svc:hover b { text-decoration: underline; }
  p { margin: 6px 0 0; font-size: 13.5px; color: #6f6f6f; line-height: 1.5; }
  .tags { margin-top: 12px; font-size: 12px; color: #a3a3a3; }
  @media (max-width: 900px) and (min-width: 721px) { .svcs { grid-template-columns: 1fr 1fr; } .svc:nth-child(3) { padding-left: 0; border-left: 0; } }
  @media (max-width: 720px) {
    .svcs { grid-template-columns: 1fr; margin-top: 24px; }
    .svc, .svc + .svc { display: grid; grid-template-columns: 56px 1fr; column-gap: 12px; padding: 18px 0; border-left: 0; border-bottom: 1px solid #ececea; }
    .svc :global(.si) { grid-row: span 3; width: 56px; height: 56px; margin: 0; }
    b { margin-top: 2px; }
    p { font-size: 13px; }
    .tags { display: none; }
  }
</style>
