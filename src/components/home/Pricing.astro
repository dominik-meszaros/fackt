---
// CMS: Settings > Pricing.
import SectionHead from './SectionHead.astro';
import { pricingSettings as P } from '../../data/settings';
const ck = '<svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5L10 17.5L19 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>';
---
<section class="m-sec" id="pricing">
  <SectionHead icon="pricing" title={P.title} lede={P.text} />
  <div class="plans">
    {P.plans.map((p) => (
      <div class:list={['plan', { k: p.dark }]}>
        <div class="top"><span>{p.name}</span>{p.badge && <span class="pill">{p.badge}</span>}</div>
        <div class="pr">{p.prefix && <small class="pre">{p.prefix}</small>}{p.price}{p.period && <small>{p.period}</small>}</div>
        <p>{p.text}</p>
        <ul>{p.items.map((it) => <li><Fragment set:html={ck} />{it}</li>)}</ul>
        <a class="m-btn dk" href={p.ctaHref}>{p.cta}</a>
      </div>
    ))}
  </div>
</section>
<style>
  .plans { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 40px; width: min(960px, 100%); text-align: left; }
  .plan { background: #f2f2f0; border-radius: 4px; padding: 30px 30px 28px; display: flex; flex-direction: column; }
  .plan.k { background: #111; color: #fff; }
  .top { display: flex; justify-content: space-between; align-items: center; gap: 12px; font-size: 13.5px; }
  .pill { font-size: 12px; padding: 4px 10px; border-radius: 2px; background: rgba(255,255,255,.12); color: #c9c9c9; }
  .pr { margin-top: 22px; font-family: var(--m-serif); font-size: 44px; line-height: 1; letter-spacing: -.02em; }
  .pr small { font-family: Geist, sans-serif; font-size: 13px; color: #8a8a8a; letter-spacing: 0; margin-left: 4px; }
  .pr .pre { margin: 0 6px 0 0; }
  p { margin: 12px 0 0; font-size: 14px; color: #6f6f6f; }
  .k p { color: #b2b2ae; }
  ul { list-style: none; margin: 22px 0 26px; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 9px 14px; font-size: 13.5px; }
  li { display: flex; align-items: center; gap: 8px; }
  li :global(svg) { flex-shrink: 0; color: #111; }
  .k li :global(svg) { color: #fff; }
  .plan .m-btn { margin-top: auto; align-self: flex-start; }
  .k .m-btn.dk { background: #fff; color: #111; box-shadow: 2px 2px 0 #3f3f3f; }
  @media (max-width: 720px) {
    .plans { grid-template-columns: 1fr; gap: 12px; margin-top: 24px; }
    .plan { padding: 24px 20px 22px; }
    .pr { font-size: 38px; }
    ul { gap: 8px 10px; font-size: 13px; }
  }
</style>
