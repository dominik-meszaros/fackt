---
// Who we work with: the four kinds of teams we fit, plus the industries we have shipped for.
// Data: src/data/audience.ts. Full page: /who-we-work-with.
import SectionHead from './SectionHead.astro';
import { teams, industries } from '../../data/audience';
---
<section class="m-sec" id="who">
  <SectionHead icon="people" title="Who we work with" lede="Founders and product teams building SaaS and apps. This is where we fit best." />
  <div class="teams">
    {teams.map((t) => (
      <a class="tm" href={`/who-we-work-with#${t.id}`}>
        <b>{t.title}</b>
        <p>{t.text}</p>
        <span class="st">Usually starts with: {t.start}</span>
      </a>
    ))}
  </div>
  <div class="ind">
    <span>Industries we have shipped for:</span>
    {industries.map((i) => <a href={`/who-we-work-with#${i.id}`}>{i.title}</a>)}
  </div>
  <a class="more" href="/who-we-work-with">See who we work with &#8594;</a>
</section>
<style>
  .teams { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: 40px; width: min(960px, 100%); text-align: left; border-top: 1px solid #ececea; }
  .tm { padding: 24px 22px 4px 0; color: inherit; text-decoration: none; display: flex; flex-direction: column; }
  .tm + .tm { padding-left: 22px; border-left: 1px solid #ececea; }
  b { font-weight: 500; font-size: 15px; }
  .tm:hover b { text-decoration: underline; }
  p { margin: 8px 0 0; font-size: 13.5px; color: #6f6f6f; line-height: 1.5; flex: 1; }
  .st { margin-top: 14px; font-size: 12px; color: #8a8a86; }
  .ind { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 6px; margin-top: 36px; max-width: 760px; font-size: 13px; color: #6a6a66; }
  .ind span { margin-right: 4px; }
  .ind a { display: inline-flex; align-items: center; height: 30px; padding: 0 10px; border-radius: 2px; color: #111; text-decoration: none; background: #fff; box-shadow: inset 0 0 0 1px #dcdcd8; transition: box-shadow .2s; }
  .ind a:hover { box-shadow: inset 0 0 0 1px #111; }
  .more { margin-top: 26px; font-size: 13.5px; font-weight: 500; color: #111; text-decoration: none; border-bottom: 1px solid #111; }
  .more:hover { border-bottom-width: 2px; }
  @media (max-width: 900px) and (min-width: 721px) { .teams { grid-template-columns: 1fr 1fr; } .tm:nth-child(3) { padding-left: 0; border-left: 0; } }
  @media (max-width: 720px) {
    .teams { grid-template-columns: 1fr; margin-top: 24px; }
    .tm, .tm + .tm { padding: 18px 0; border-left: 0; border-bottom: 1px solid #ececea; }
    p { font-size: 13px; }
    .ind { margin-top: 24px; }
    .ind span { width: 100%; margin: 0 0 4px; }
    .ind a { height: 36px; padding: 0 12px; }
  }
</style>
