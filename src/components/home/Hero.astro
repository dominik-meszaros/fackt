---
// Hero: headline, quote switcher (CMS: Hero quotes), the work stage (CMS: Work with "Show in hero
// stage") and the ask-anything bar (CMS: Settings > Homepage > Ask suggestions).
import { site } from '../../data/site';
import { homeSettings } from '../../data/settings';

interface Project { slug: string; name: string; service: string; category: string; summary: string; keywords: string[]; image: string; imageKind: string; tint: string; stageLabel?: string; stageQuery?: string }
interface Quote { name: string; role: string; quote: string; photo?: string }
interface Props { stage: Project[]; all: Project[]; quotes: Quote[] }
const { stage, all, quotes } = Astro.props;
const h = homeSettings;
const initials = (n: string) => n.split(/\s+/).slice(0, 2).map((w) => w[0]).join('');
const pad = (n: number) => String(n).padStart(2, '0');
const index = {
  projects: all,
  stage: stage.map((p) => p.slug),
  ask: h.ask,
  hints: h.askHints,
  booking: site.bookPage,
};
---
<section class="hero">
  <h1>{h.heroTitle}<br /><span>{h.heroTitleMuted}</span></h1>
  <p class="sub">{h.heroText}</p>
  <div class="ctas">
    <a class="m-btn dk" href={site.bookPage}>Book a strategy call</a>
    <a class="m-btn lt" href="#work">View work</a>
  </div>

  {quotes.length > 0 && (
    <figure class="tq" data-quotes>
      <blockquote><span data-q-text>&#8220;{quotes[0].quote}&#8221;</span></blockquote>
      <div class="tqb">
        <div class="tqa" role="tablist" aria-label="Client quotes">
          {quotes.map((q, i) => (
            <button type="button" role="tab" class:list={['av', { on: i === 0 }]} aria-selected={i === 0 ? 'true' : 'false'} aria-label={`${q.name}, ${q.role}`}
              data-q={i} data-text={q.quote} data-name={q.name} data-role={q.role}>
              {q.photo ? <img src={q.photo} alt="" width="30" height="30" loading="lazy" /> : initials(q.name)}
            </button>
          ))}
        </div>
        <figcaption><b data-q-name>{quotes[0].name}</b><span data-q-role>{quotes[0].role}</span></figcaption>
        <span class="tqn" data-q-idx>01 / {pad(quotes.length)}</span>
      </div>
    </figure>
  )}

  <div class="stage" id="stage">
    <span class="tagl" data-stage-label>{stage[0]?.name}, {stage[0]?.service}</span>
    <span class="tagr" data-stage-idx>01 / {pad(stage.length)}</span>
    {stage.map((p, i) => (
      <a href={`/work/${p.slug}`} class:list={['shot', { ph: p.imageKind === 'phone', on: i === 0 }]} data-slug={p.slug}
        tabindex={i === 0 ? 0 : -1} aria-hidden={i === 0 ? undefined : 'true'}>
        <img src={p.image} alt={`${p.name}, ${p.service.toLowerCase()} by Fackt`} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
      </a>
    ))}

    <div class="ask" data-ask>
      <form class="askbar" role="search" action={site.bookPage} method="get" data-ask-form>
        <svg width="16" height="16" viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="6" fill="none" stroke="currentColor" stroke-width="1.8"></circle><path d="M13 13L18 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
        <label class="sr-only" for="ask">Ask about our work, pricing or process</label>
        <input id="ask" name="notes" type="text" autocomplete="off" spellcheck="false"
          role="combobox" aria-expanded="false" aria-controls="ask-panel" aria-autocomplete="list"
          placeholder={`Ask anything, e.g. “${h.askHints[0]}”`} data-ask-input />
        <span class="kb" aria-hidden="true">&#8984;K</span>
        <button class="go" type="submit">Ask</button>
      </form>
      <div class="panel" id="ask-panel" hidden data-ask-panel>
        <div class="ans" hidden data-ask-answer><span class="anh">Answer</span><p data-ask-answer-text></p><a href="#" data-ask-answer-link></a></div>
        <span class="ph" data-ask-head>Ask about work, pricing or process</span>
        <ul role="listbox" aria-label="Suggestions" data-ask-list></ul>
      </div>
    </div>
  </div>

  <div class="chips" role="group" aria-label="Show work">
    {stage.map((p, i) => (
      <button type="button" class:list={['chip', { on: i === 0 }]} data-chip={p.slug} aria-pressed={i === 0 ? 'true' : 'false'}>{p.stageLabel ?? p.service}</button>
    ))}
  </div>
  <script type="application/json" id="ask-index" set:html={JSON.stringify(index)} />
</section>

<style>
  .hero { padding: 52px 16px 0; display: flex; flex-direction: column; align-items: center; text-align: center; }
  h1 { margin: 0; font-family: var(--m-serif); font-weight: 400; font-size: 46px; line-height: 1.08; letter-spacing: -.02em; }
  h1 span { color: #9a9a96; }
  .sub { margin: 14px auto 0; max-width: 430px; color: #6f6f6f; }
  .ctas { display: flex; gap: 8px; margin-top: 22px; }

  .tq { margin: 24px auto 0; width: min(600px, 100%); text-align: left; background: #fff; box-shadow: inset 0 0 0 1px #dcdcd8; border-radius: 3px; padding: 18px 20px 14px; }
  .tq blockquote { margin: 0; min-height: 44px; font-family: var(--m-serif); font-style: italic; font-size: 16.5px; line-height: 1.38; color: #111; }
  .tqb { display: flex; align-items: center; gap: 14px; margin-top: 14px; padding-top: 12px; border-top: 1px solid #ececea; }
  .tqa { display: flex; gap: 6px; }
  .av { all: unset; cursor: pointer; box-sizing: border-box; width: 30px; height: 30px; border-radius: 2px; display: grid; place-items: center; overflow: hidden; background: #f2f2f0; color: #6a6a66; font: 500 11px Geist, system-ui, sans-serif; box-shadow: inset 0 0 0 1px #dcdcd8; transition: box-shadow .2s, color .2s; }
  .av img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1); opacity: .7; }
  .av:hover { color: #111; }
  .av.on { color: #fff; background: #111; box-shadow: 2px 2px 0 #c8c8c4; outline: 1.5px solid #111; outline-offset: 2px; }
  .av.on img { opacity: 1; }
  .av:focus-visible { outline: 2px solid #111; outline-offset: 2px; }
  figcaption { flex: 1; display: flex; flex-direction: column; font-size: 13px; line-height: 1.25; }
  figcaption b { font-weight: 500; color: #111; }
  figcaption span { color: #8a8a86; font-size: 12px; }
  .tqn { font: 500 12px Geist, system-ui, sans-serif; font-variant-numeric: tabular-nums; color: #8a8a86; }

  .stage { position: relative; width: min(1120px, 100%); height: 560px; margin: 40px auto 0; border-radius: 4px; background: #f2f2f0; box-shadow: inset 0 0 0 1px #dcdcd8; }
  .shot { position: absolute; left: 50%; top: 56px; width: min(760px, 86%); transform: translate(-50%, 16px) scale(.98); opacity: 0; pointer-events: none; transition: opacity .5s, transform .7s var(--m-ease); }
  .shot img { display: block; width: 100%; height: auto; border-radius: 3px; box-shadow: 0 0 0 1px #111, 6px 6px 0 rgba(17, 17, 17, .08); }
  .shot.ph { width: 260px; top: 40px; }
  .shot.ph img { border-radius: 14px; }
  .shot.on { opacity: 1; pointer-events: auto; transform: translate(-50%, 0); }
  .stage { overflow: hidden; }
  .tagl, .tagr { position: absolute; top: 20px; z-index: 2; font-size: 12.5px; font-weight: 500; font-variant-numeric: tabular-nums; color: #111; background: #fff; padding: 4px 9px; border-radius: 2px; box-shadow: inset 0 0 0 1px #dcdcd8; }
  .tagl { left: 24px; }
  .tagr { right: 24px; color: #6a6a66; }

  .ask { position: absolute; left: 50%; bottom: 26px; transform: translateX(-50%); z-index: 3; width: min(640px, 100% - 24px); text-align: left; }
  .askbar { height: 50px; display: flex; align-items: center; gap: 10px; padding: 0 6px 0 16px; border-radius: 3px; background: #fff; box-shadow: 0 0 0 1px #c8c8c4, 0 1px 2px rgba(0, 0, 0, .06), 0 12px 28px -14px rgba(0, 0, 0, .22); color: #111; }
  .askbar input { all: unset; flex: 1; min-width: 0; font-size: 14.5px; color: #111; }
  .askbar input::placeholder { color: #8a8a86; }
  .kb { font: 500 11px Geist, system-ui, sans-serif; color: #6a6a66; padding: 3px 6px; border-radius: 2px; box-shadow: inset 0 0 0 1px #dcdcd8, inset 0 -1px 0 #dcdcd8; }
  .go { all: unset; cursor: pointer; height: 36px; padding: 0 16px; display: grid; place-items: center; border-radius: 2px; background: #111; color: #fff; font-size: 13.5px; font-weight: 500; }
  .panel { position: absolute; left: 0; right: 0; bottom: 56px; max-height: 420px; overflow: auto; padding: 8px; background: #fff; border-radius: 3px; box-shadow: 0 0 0 1px #c8c8c4, 0 18px 36px -14px rgba(0, 0, 0, .28); }
  .panel[hidden] { display: none; }
  .ph { display: block; font-size: 11.5px; color: #8a8a86; padding: 4px 8px 6px; }
  .panel :global(ul) { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 1px; }
  .panel :global(.ar) { cursor: pointer; display: flex; align-items: center; gap: 10px; padding: 8px; border-radius: 2px; color: #111; font-size: 13.5px; }
  .panel :global(.ar span) { flex: 1; }
  .panel :global(.ar small) { font-size: 11.5px; color: #8a8a86; }
  .panel :global(.ar svg) { flex-shrink: 0; color: #6a6a66; }
  .panel :global(.ar:hover), .panel :global(.ar.hl) { background: #f2f2f0; }
  .panel :global(.ar.on) { background: #111; color: #fff; }
  .panel :global(.ar.on svg), .panel :global(.ar.on small) { color: #b2b2ae; }
  .ans { margin: 2px 2px 8px; padding: 12px 14px; border-radius: 2px; background: #f2f2f0; box-shadow: inset 0 0 0 1px #e2e2de; }
  .ans[hidden] { display: none; }
  .anh { font-size: 11px; color: #8a8a86; }
  .ans p { margin: 4px 0 6px; font-size: 14px; line-height: 1.45; color: #111; }
  .ans a { font-size: 13px; font-weight: 500; color: #111; }

  .chips { display: inline-flex; margin-top: 16px; box-shadow: inset 0 0 0 1px #c8c8c4; border-radius: 3px; overflow: hidden; max-width: 100%; }
  .chip { all: unset; cursor: pointer; height: 34px; padding: 0 12px; font-size: 12.5px; color: #6f6f6f; display: inline-flex; align-items: center; border-right: 1px solid #dcdcd8; white-space: nowrap; flex-shrink: 0; transition: background .2s, color .2s; }
  .chip:last-child { border-right: 0; }
  .chip:hover { color: #111; }
  .chip.on { background: #111; color: #fff; }
  .chip:focus-visible { outline: 2px solid #111; outline-offset: -2px; }

  @media (max-width: 720px) {
    .hero { padding: 28px 16px 0; }
    h1 { font-size: 34px; }
    .sub { font-size: 14px; max-width: 320px; }
    .tq { padding: 16px 16px 12px; }
    .tq blockquote { font-size: 15px; min-height: 62px; }
    .tqb { flex-wrap: wrap; gap: 10px; }
    figcaption { flex: 1 1 140px; }
    .tqn { display: none; }
    .stage { height: 350px; margin-top: 28px; }
    .shot { width: calc(100% - 28px); top: 52px; }
    .shot.ph { width: 122px; top: 48px; }
    .shot.ph img { border-radius: 20px; }
    .tagl, .tagr { top: 12px; font-size: 11.5px; padding: 3px 7px; }
    .tagl { left: 12px; } .tagr { right: 12px; }
    .ask { bottom: 12px; }
    .askbar { height: 46px; gap: 8px; padding: 0 5px 0 12px; }
    .askbar input { font-size: 16px; }
    .kb { display: none; }
    .go { height: 36px; padding: 0 12px; font-size: 13px; }
    .panel { bottom: 52px; max-height: 300px; }
    .panel :global(.ar small) { display: none; }
    .ans p { font-size: 13px; }
    .chips { max-width: 100%; overflow-x: auto; scrollbar-width: none; }
  }
</style>

<script>
  import { initHero } from '../../scripts/hero';
  initHero();
</script>
