---
// Phones only: once the hero is out of view, a slim bar keeps the two next steps one tap away.
// Hides again near the end of the page (the postcard and footer have their own buttons) and while the cookie bar is open.
---
<div class="pb" data-pb aria-hidden="true">
  <a class="w" href="/work" tabindex="-1" data-journey="Phone bar: see work">See work</a>
  <a class="a" href="/audit" tabindex="-1" data-journey="Phone bar: free audit">Get a free audit</a>
</div>
<style>
  .pb { display: none; }
  @media (max-width: 720px) {
    .pb { position: fixed; left: 12px; right: 12px; bottom: calc(12px + env(safe-area-inset-bottom)); z-index: 40; display: grid; grid-template-columns: 1fr 1.4fr; gap: 6px; padding: 6px; border-radius: 6px; background: #fff; box-shadow: 0 0 0 1px #111, 3px 3px 0 #111; transform: translateY(140%); transition: transform .32s var(--m-ease, ease); }
    .pb.on { transform: none; }
    .pb a { display: flex; align-items: center; justify-content: center; height: 42px; border-radius: 3px; font-size: 14.5px; font-weight: 500; text-decoration: none; }
    .pb .w { color: #111; box-shadow: inset 0 0 0 1px #dcdcd8; }
    .pb .a { background: #111; color: #fff; }
  }
  @media (max-width: 720px) and (prefers-reduced-motion: reduce) { .pb { transition: none; } }
</style>
<script>
  const bar = document.querySelector<HTMLElement>('[data-pb]');
  const hero = document.querySelector('.hero .ctas');
  const end = document.querySelector('footer.ft');
  if (bar && hero) {
    let pastHero = false, nearEnd = false;
    const consent = () => !!document.querySelector('[data-cs]:not([hidden])');
    const ask = () => document.documentElement.classList.contains('ask-lock');
    const set = () => {
      const on = pastHero && !nearEnd && !consent() && !ask();
      bar.classList.toggle('on', on);
      bar.setAttribute('aria-hidden', on ? 'false' : 'true');
      bar.querySelectorAll('a').forEach((a) => (a.tabIndex = on ? 0 : -1));
    };
    new IntersectionObserver(([e]) => { pastHero = !e.isIntersecting && e.boundingClientRect.top < 0; set(); }).observe(hero);
    if (end) new IntersectionObserver(([e]) => { nearEnd = e.isIntersecting; set(); }, { rootMargin: '0px 0px 200px 0px' }).observe(end);
    new MutationObserver(set).observe(document.documentElement, { attributes: true, attributeFilter: ['class'], subtree: false });
    const cs = document.querySelector('[data-cs]');
    if (cs) new MutationObserver(set).observe(cs, { attributes: true, attributeFilter: ['hidden'] });
  }
</script>
