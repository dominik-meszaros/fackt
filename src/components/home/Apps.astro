---
// "We ship our own apps too": the apps Fackt designed, built and owns (work entries with ownApp: true).
// Card cover at the card ratio, the real App Store icon, one line, three build numbers and two links.
import SectionHead from './SectionHead.astro';
import { site } from '../../data/site';
interface App { slug: string; name: string; tagline?: string; card?: string; preview?: string; image: string; icon?: string; appStore?: string; results: { value: string; label: string }[]; platform?: string; service: string }
interface Props { apps: App[] }
const { apps } = Astro.props;
const kind: Record<string, string> = { dozy: 'Sleep tracker and smart alarm', ritual: 'Habit tracker' };
---
{apps.length > 0 && (
  <section class="m-sec" id="apps">
    <SectionHead icon="apps" title="We ship our own apps too." lede="Same team, same process we use for clients: the name, the brand, every screen, the Swift code, the paywalls and the App Store page." />
    <div class="ag">
      {apps.map((a) => (
        <article class="ac">
          <a class="cv" href={`/work/${a.slug}`} tabindex="-1" aria-hidden="true"><img src={a.card ?? a.preview ?? a.image} alt="" loading="lazy" decoding="async" /></a>
          <div class="bd">
            <div class="id">
              {a.icon && <img src={a.icon} alt={`${a.name} app icon`} width="46" height="46" loading="lazy" />}
              <div><h3><a href={`/work/${a.slug}`}>{a.name}</a></h3><span>{kind[a.slug] ?? a.service} &#183; iOS</span></div>
            </div>
            {a.tagline && <p>{a.tagline}</p>}
            {a.results.length > 0 && <div class="st">{a.results.slice(0, 3).map((r) => <div><b>{r.value}</b><span>{r.label}</span></div>)}</div>}
            <div class="lk">
              <a class="tl" href={`/work/${a.slug}`}>Read the build story &#8594;</a>
              {a.appStore && <a class="as" href={a.appStore} target="_blank" rel="noopener">App Store &#8599;</a>}
            </div>
          </div>
        </article>
      ))}
    </div>
    <div class="cta"><p>Have an app idea? We can take it from the first sketch to the App Store.</p><a class="m-btn dk" href={site.bookPage}>Book a call</a></div>
  </section>
)}
<style>
  .ag { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 40px; width: min(960px, 100%); text-align: left; }
  .ac { display: flex; flex-direction: column; border-radius: 4px; overflow: hidden; background: #fff; box-shadow: inset 0 0 0 1px #dcdcd8; }
  .cv { display: block; aspect-ratio: 1.55; overflow: hidden; border-bottom: 1px solid #dcdcd8; }
  .cv img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .6s var(--m-ease); }
  .ac:hover .cv img { transform: scale(1.03); }
  .bd { display: flex; flex-direction: column; flex: 1; padding: 24px 26px 24px; }
  .id { display: flex; gap: 12px; align-items: center; }
  .id img { width: 46px; height: 46px; flex-shrink: 0; }
  h3 { margin: 0; font-family: var(--m-serif); font-weight: 400; font-size: 26px; line-height: 1; }
  h3 a { color: inherit; text-decoration: none; }
  .id span { display: block; margin-top: 4px; font-size: 12.5px; color: #6f6f6f; }
  p { margin: 14px 0 0; font-size: 14.5px; color: #3f3f3f; }
  .st { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 18px; border-top: 1px solid #dcdcd8; border-bottom: 1px solid #dcdcd8; }
  .st div { padding: 12px 12px 12px 0; }
  .st div + div { padding-left: 12px; border-left: 1px solid #dcdcd8; }
  .st b { display: block; font-family: var(--m-serif); font-weight: 400; font-size: 28px; line-height: 1; }
  .st span { display: block; margin-top: 6px; font-size: 12px; line-height: 1.3; color: #6f6f6f; }
  .lk { margin-top: auto; padding-top: 16px; display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .tl { font-size: 13.5px; font-weight: 500; color: var(--m-ink); text-decoration: none; border-bottom: 1px solid var(--m-ink); }
  .as { font-size: 13px; color: #6f6f6f; text-decoration: none; }
  .as:hover { color: var(--m-ink); }
  .cta { margin-top: 28px; display: flex; gap: 16px; align-items: center; justify-content: center; }
  .cta p { margin: 0; }
  @media (max-width: 720px) {
    .ag { grid-template-columns: 1fr; gap: 16px; margin-top: 28px; }
    .bd { padding: 18px 18px 20px; }
    h3 { font-size: 22px; }
    .id img { width: 40px; height: 40px; }
    .st b { font-size: 24px; }
    .cta { flex-direction: column; gap: 12px; margin-top: 22px; }
    .cta p { font-size: 14px; max-width: 300px; }
  }
</style>
