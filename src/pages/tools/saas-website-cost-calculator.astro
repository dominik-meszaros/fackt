---
// Free tool: SaaS website cost calculator. Estimates hours from scope, then prices them at typical
// freelancer, specialist studio and large agency rates. Assumptions are shown on the page.
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { site } from '../../data/site';
import '../../styles/faq.css';

const faq = [
  { q: 'How much does a SaaS website cost in 2026?', a: 'A single SaaS landing page, designed and built, usually costs about $2,000 to $6,500 with a freelancer, $4,000 to $10,500 with a specialist studio and $7,000 to $17,500 with a large agency. A five page marketing site is roughly twice that. Use the calculator for your own scope.' },
  { q: 'Why do quotes for the same website vary so much?', a: 'Mostly hourly rates and process. A large agency adds strategy workshops, account managers and review rounds. A freelancer is cheaper per hour but usually covers fewer skills, so copy, illustration or motion get added separately.' },
  { q: 'What makes a SaaS website more expensive?', a: 'More pages, custom illustration or 3D, motion, copywriting and a CMS for a blog or changelog. A brand identity from scratch is the biggest single extra.' },
  { q: 'Is Framer or Webflow cheaper to build in?', a: 'For most marketing sites the build costs about the same. Framer is usually faster for design-led pages, Webflow for large CMS setups. Both let your team edit the site without a developer after launch.' },
];
const ld = [
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'SaaS website cost calculator', applicationCategory: 'BusinessApplication', operatingSystem: 'Any', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, url: new URL('/tools/saas-website-cost-calculator', site.url).toString(), publisher: { '@type': 'Organization', name: 'Fackt', url: site.url } },
];
---
<Base title="SaaS website cost calculator (2026) | Fackt" description="Estimate what your SaaS website or landing page will cost with a freelancer, a specialist studio or a large agency, and how long it takes. Free, no signup.">
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <Nav />
  <main class="tl">
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">Fackt</a><span>/</span><b aria-current="page">Website cost calculator</b></nav>
    <header class="top">
      <span class="eb">Free tool</span>
      <h1>SaaS website cost calculator</h1>
      <p>Pick your scope and see what it costs with a freelancer, a specialist studio and a large agency, and how long it takes. No signup.</p>
    </header>

    <div class="calc" data-calc>
      <form class="in" onsubmit="return false">
        <fieldset>
          <legend>What do you need?</legend>
          <div class="seg" role="radiogroup">
            <label><input type="radio" name="kind" value="lp" checked /><span><b>Landing page</b><small>One page</small></span></label>
            <label><input type="radio" name="kind" value="site" /><span><b>Marketing site</b><small>Several pages</small></span></label>
            <label><input type="radio" name="kind" value="both" /><span><b>Site and product</b><small>Pages and app screens</small></span></label>
          </div>
        </fieldset>
        <fieldset data-show="site both">
          <legend>Pages <output data-out="pages">5</output></legend>
          <input type="range" name="pages" min="2" max="20" value="5" aria-label="Number of pages" />
        </fieldset>
        <fieldset data-show="both">
          <legend>Product screens <output data-out="screens">10</output></legend>
          <input type="range" name="screens" min="3" max="40" value="10" aria-label="Number of product screens" />
        </fieldset>
        <fieldset>
          <legend>Design only, or built too?</legend>
          <div class="seg two" role="radiogroup">
            <label><input type="radio" name="build" value="1" checked /><span><b>Design and build</b><small>Framer or Webflow</small></span></label>
            <label><input type="radio" name="build" value="0" /><span><b>Design only</b><small>Figma, your team builds</small></span></label>
          </div>
        </fieldset>
        <fieldset>
          <legend>Extras</legend>
          <div class="chk">
            <label><input type="checkbox" name="copy" /><span>Copywriting</span></label>
            <label><input type="checkbox" name="art" /><span>Custom illustration or 3D</span></label>
            <label><input type="checkbox" name="motion" /><span>Motion and animation</span></label>
            <label><input type="checkbox" name="cms" /><span>Blog or changelog (CMS)</span></label>
            <label><input type="checkbox" name="brand" /><span>New brand identity</span></label>
            <label><input type="checkbox" name="rush" /><span>Rush, under 3 weeks</span></label>
          </div>
        </fieldset>
      </form>

      <aside class="out" aria-live="polite">
        <span class="eb">Your estimate</span>
        <div class="row hl"><span>Specialist studio<small>Like Fackt</small></span><b data-r="studio">$0</b></div>
        <div class="row"><span>Freelancer</span><b data-r="free">$0</b></div>
        <div class="row"><span>Large agency</span><b data-r="agency">$0</b></div>
        <div class="tm"><span>Time to launch with a studio</span><b data-r="weeks">2 weeks</b></div>
        <p class="hrs">About <b data-r="hours">0</b> hours of work.</p>
        <a class="m-btn dk" href={site.bookPage} data-journey="cost calculator: book call">Get an exact quote in a 30 minute call</a>
        <a class="aud" href="/audit" data-journey="cost calculator: free audit">or get a free audit of your current site first &#8594;</a>
      </aside>
    </div>

    <section class="how">
      <h2>How the estimate works</h2>
      <p>We estimate the hours your scope takes, then price them at typical rates for each kind of team. These are ranges, not quotes, and they are based on what we see in our own projects and in the proposals founders show us.</p>
      <ul>
        <li><b>Hourly rates:</b> freelancer $40 to $90, specialist studio $90 to $150, large agency $150 to $250.</li>
        <li><b>Landing page:</b> about 30 to 45 hours of design, plus 15 to 25 hours to build.</li>
        <li><b>Each extra page:</b> 8 to 14 hours of design and 4 to 8 to build. Each product screen: 5 to 9 hours.</li>
        <li><b>Extras:</b> copy 8 to 15 hours, illustration or 3D 15 to 30, motion 10 to 25, CMS 8 to 16, brand identity 30 to 60.</li>
        <li><b>Rush:</b> plus 25 percent. <b>Timeline:</b> a studio covers about 25 hours a week, never less than 2 weeks.</li>
      </ul>
      <p>Fackt projects start at $5,000 for a landing page, designed and built, in 2 to 6 weeks. <a href="/services">See how we work</a>.</p>
      <p>The estimate covers design and build. For the monthly platform costs on top, see <a href="/blog/framer-website-cost">what a Framer website costs</a> and <a href="/blog/webflow-website-cost">what a Webflow website costs</a>.</p>
    </section>

    <section class="faq-sec">
      <h2>SaaS website costs, answered</h2>
      <div class="faq">{faq.map((f, i) => (<details open={i === 0}><summary>{f.q}</summary><p>{f.a}</p></details>))}</div>
    </section>
  </main>
  <Footer />
</Base>
<style>
  .tl { width: min(1120px, 100% - 32px); margin: 0 auto; padding-bottom: 64px; }
  .crumb { display: flex; gap: 8px; padding-top: 40px; font-size: 13px; color: #8a8a86; }
  .crumb a { color: inherit; text-decoration: none; } .crumb b { color: #111; font-weight: 400; }
  .top { padding: 24px 0 32px; max-width: 680px; }
  .eb { display: block; font-size: 11px; font-weight: 500; letter-spacing: .06em; text-transform: uppercase; color: #8a8a86; }
  h1 { margin: 10px 0 0; font-family: var(--m-serif); font-weight: 400; font-size: 52px; line-height: 1.04; letter-spacing: -.02em; }
  .top p { margin: 14px 0 0; font-size: 17px; color: #3f3f3f; }
  .calc { display: grid; grid-template-columns: 1.4fr 1fr; gap: 32px; align-items: start; }
  .in { display: grid; gap: 28px; }
  fieldset { border: 0; margin: 0; padding: 0; }
  fieldset[hidden] { display: none; }
  legend { font-weight: 500; font-size: 15px; margin-bottom: 10px; display: flex; gap: 8px; }
  legend output { color: #8a8a86; font-weight: 400; }
  .seg { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .seg.two { grid-template-columns: repeat(2, 1fr); }
  .seg label, .chk label { cursor: pointer; }
  .seg input, .chk input { position: absolute; opacity: 0; pointer-events: none; }
  .seg span { display: block; padding: 14px; border-radius: 8px; box-shadow: 0 0 0 1px #e0e0dc; height: 100%; box-sizing: border-box; }
  .seg b { display: block; font-weight: 500; font-size: 15px; } .seg small { color: #8a8a86; font-size: 13px; }
  .seg input:checked + span { box-shadow: 0 0 0 2px #111; }
  .seg input:focus-visible + span, .chk input:focus-visible + span { outline: 2px solid #2b6cff; outline-offset: 2px; }
  .chk { display: flex; flex-wrap: wrap; gap: 8px; }
  .chk span { display: inline-block; padding: 9px 14px; border-radius: 99px; box-shadow: 0 0 0 1px #e0e0dc; font-size: 14px; }
  .chk input:checked + span { background: #111; color: #fff; box-shadow: none; }
  input[type=range] { width: 100%; accent-color: #111; }
  .out { position: sticky; top: 88px; padding: 24px; border-radius: 10px; background: #111; color: #fff; display: grid; gap: 4px; }
  .out .eb { color: #9a9a96; margin-bottom: 8px; }
  .row { display: flex; justify-content: space-between; align-items: baseline; padding: 12px 0; border-bottom: 1px solid #2a2a2a; gap: 12px; }
  .row span { color: #b5b5b0; font-size: 14px; } .row small { display: block; color: #7a7a76; font-size: 12px; }
  .row b { font-weight: 500; font-size: 18px; white-space: nowrap; }
  .row.hl span { color: #fff; } .row.hl b { font-family: var(--m-serif); font-weight: 400; font-size: 34px; }
  .tm { display: flex; justify-content: space-between; padding: 14px 0 4px; font-size: 14px; color: #b5b5b0; } .tm b { color: #fff; font-weight: 500; }
  .hrs { margin: 0 0 16px; font-size: 13px; color: #7a7a76; } .hrs b { color: #b5b5b0; font-weight: 400; }
  .out .m-btn { background: #fff; color: #111; text-align: center; }
  .aud { margin-top: 10px; font-size: 13px; color: #b5b5b0; text-align: center; }
  .how { margin-top: 80px; max-width: 760px; }
  .how h2, .faq-sec h2 { font-family: var(--m-serif); font-weight: 400; font-size: 34px; margin: 0 0 12px; }
  .how p, .how li { color: #3f3f3f; font-size: 16px; line-height: 1.6; }
  .how ul { padding-left: 18px; } .how a { color: #111; }
  .faq-sec { margin-top: 64px; max-width: 760px; }
  .faq summary { cursor: pointer; padding: 16px 32px 16px 0; font-weight: 500; border-top: 1px solid #ececea; list-style: none; }
  .faq p { margin: 0 0 16px; color: #3f3f3f; }
  @media (max-width: 860px) {
    h1 { font-size: 38px; }
    .calc { grid-template-columns: 1fr; }
    .seg { grid-template-columns: 1fr; }
    .out { position: static; }
    .row { flex-wrap: wrap; }
    .row b { white-space: normal; }
    .row.hl b { font-size: 28px; }
  }
</style>
<script>
  const root = document.querySelector<HTMLElement>('[data-calc]')!;
  const form = root.querySelector('form')!;
  const fmt = (n: number) => '$' + (Math.round(n / 500) * 500).toLocaleString('en-US');
  const rates = { free: [40, 90], studio: [90, 150], agency: [150, 250] } as const;
  function run() {
    const f = new FormData(form);
    const kind = f.get('kind') as string;
    const build = f.get('build') === '1';
    const pages = kind === 'lp' ? 1 : Number(f.get('pages'));
    const screens = kind === 'both' ? Number(f.get('screens')) : 0;
    root.querySelectorAll<HTMLElement>('[data-show]').forEach((el) => (el.hidden = !el.dataset.show!.split(' ').includes(kind)));
    root.querySelector('[data-out=pages]')!.textContent = String(f.get('pages'));
    root.querySelector('[data-out=screens]')!.textContent = String(f.get('screens'));
    let lo = 30 + (pages - 1) * 8 + screens * 5, hi = 45 + (pages - 1) * 14 + screens * 9;
    if (build) { lo += 15 + (pages - 1) * 4; hi += 25 + (pages - 1) * 8; }
    const extra: Record<string, [number, number]> = { copy: [8, 15], art: [15, 30], motion: [10, 25], cms: [8, 16], brand: [30, 60] };
    for (const k in extra) if (f.get(k)) { lo += extra[k][0]; hi += extra[k][1]; }
    if (f.get('rush')) { lo *= 1.25; hi *= 1.25; }
    for (const k of ['free', 'studio', 'agency'] as const) {
      root.querySelector(`[data-r=${k}]`)!.textContent = `${fmt(lo * rates[k][0])} to ${fmt(hi * rates[k][1])}`;
    }
    const wk = Math.max(2, Math.ceil(((lo + hi) / 2) / 25));
    root.querySelector('[data-r=weeks]')!.textContent = `${wk} weeks`;
    root.querySelector('[data-r=hours]')!.textContent = `${Math.round(lo)} to ${Math.round(hi)}`;
  }
  form.addEventListener('input', run);
  run();
</script>
