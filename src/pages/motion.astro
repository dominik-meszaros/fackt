---
// Unlisted motion showcase: fackt.io/motion. Ten animated screens from Fackt's own shipped iOS apps
// (Dozy, Ritual, Fluo), each a live web port of the app's SwiftUI / SpriteKit with the same springs and art.
// Not in the nav or sitemap, noindex. Shared by link with prospects and past clients.
// Dom's comments: write them in `notes` below (one per screen). Empty notes are not shown.
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Mark from '../components/home/Mark.astro';
import screens from '../data/motion-screens.html?raw';
import '../styles/motion.css';
import { getCollection } from 'astro:content';

const notes: Record<string, string> = {
  wake: '',
  sleep: '',
  score: '',
  garden: '',
  breathe: '',
  done: '',
  mood: '',
  fix: '',
  voice: '',
  reply: '',
};
// App headers reuse the case study data (same card language as the homepage "We ship our own apps too").
const work = await getCollection('work');
const fromWork = (slug: string) => work.find((w) => w.id === slug)?.data as any;
const apps: Record<string, { name: string; kind: string; tagline: string; icon: string; results: { value: string; label: string }[]; story?: string; appStore: string }> = {
  dozy: { kind: 'Sleep tracker and smart alarm', ...pick('dozy') },
  ritual: { kind: 'Habit tracker', ...pick('ritual') },
  fluo: {
    name: 'Fluo', kind: 'AI keyboard', icon: '/motion/icon-fluo.png',
    tagline: 'A keyboard that fixes your typos, types what you say and drafts replies.',
    results: [{ value: '6', label: 'languages, switch mid chat' }, { value: '6', label: 'keyboard themes' }, { value: '1', label: 'tap to fix a message' }],
    appStore: 'https://apps.apple.com/us/app/fluo-ai-keyboard/id6831063211',
  },
};
function pick(slug: string) {
  const d = fromWork(slug) ?? {};
  return { name: d.name ?? slug, tagline: d.tagline ?? '', icon: `/motion/icon-${slug}.png`, results: (d.results ?? []).slice(0, 3), story: `/work/${slug}`, appStore: d.appStore ?? '' };
}
const head = (k: string) => {
  const a = apps[k];
  return `<div class="mo-app"><div class="mo-id"><img src="${a.icon}" alt="${a.name} app icon" width="56" height="56"><div><h2 id="h-${k}">${a.name}</h2><span>${a.kind} &#183; iOS</span></div></div>`
    + `<p class="mo-tl">${esc(a.tagline)}</p>`
    + `</div>`;
};
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const html = screens.replace(/<!--app:(\w+)-->/g, (_, k) => head(k)).replace(/<!--note:(\w+)-->/g, (_, k) =>
  notes[k] ? `<p class="mo-dom"><span class="mo-dom-k">Dom</span>${esc(notes[k])}</p>` : '');
---
<Base title="Motion in shipped apps | Fackt" description="Ten animated screens from three iOS apps Fackt designed and built: Dozy, Ritual and Fluo. Running code, not videos." noindex>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Urbanist:wght@600;700;800;900&family=Instrument+Serif:ital@0;1&family=Instrument+Sans:wght@400;500;600&family=Caveat:wght@500;700&family=Geologica:wght@300;400;500;600&family=Doto:wght@800&display=swap" />
  <div class="m-page">
    <Nav />
    <main class="mo">
      <header class="mo-hero m-wrap">
        <h1>Motion that ships.</h1>
        <p class="mo-lede">Ten animated screens from three iOS apps we designed and built end to end: <b>Dozy</b>, <b>Ritual</b> and <b>Fluo</b>, all live on the App Store. Nothing here is a video. Each screen runs as code, ported from the app's own SwiftUI and SpriteKit with the same springs, timings and artwork. Hit Replay on any screen and open the source under it to see what runs on the phone.</p>
        <div class="mo-facts"><span>SwiftUI</span><span>SpriteKit</span><span>Figma to production</span></div>
      </header>
      <div class="mo-body m-wrap" set:html={html} />
    </main>
    <Footer />
  </div>
</Base>

<script>
  import '../scripts/motion.js';
</script>

<style is:global>
  .mo .m-wrap { width: min(1240px, 100% - 32px); }
  .mo-hero { padding: 56px 0 36px; border-bottom: 1.5px solid var(--m-ink); display: grid; gap: 14px; }
  .mo-tag { display: inline-flex; align-items: center; gap: 7px; font: 500 12px 'Geist Mono', ui-monospace, monospace; letter-spacing: .06em; text-transform: uppercase; color: var(--m-mu); }
  .mo-hero h1 { margin: 0; font-family: var(--m-serif); font-weight: 400; font-size: clamp(44px, 7vw, 84px); line-height: .98; letter-spacing: -.025em; text-wrap: balance; }
  .mo-lede { margin: 0; max-width: 64ch; font-size: 16.5px; color: var(--m-ink-2); }
  .mo-lede b { font-weight: 500; color: var(--m-ink); }
  .mo-facts { display: flex; flex-wrap: wrap; gap: 8px; }
  .mo-facts span { font: 12px 'Geist Mono', ui-monospace, monospace; border-radius: 3px; box-shadow: inset 0 0 0 1px var(--m-line); padding: 4px 9px; color: var(--m-mu); }
  .mo-body { display: flex; flex-direction: column; gap: 72px; padding: 48px 0 24px; }
  /* App header: the same card language as the homepage "We ship our own apps too". */
  .mo-app { display: flex; flex-wrap: wrap; gap: 10px 32px; align-items: center; justify-content: space-between; padding: 22px 26px; border-radius: 4px; background: #fff; box-shadow: inset 0 0 0 1px var(--m-line), 3px 3px 0 var(--m-line-2); }
  .mo-id { display: flex; gap: 14px; align-items: center; grid-column: 1; }
  .mo-id img { width: 56px; height: 56px; border-radius: 22.5%; flex: none; box-shadow: inset 0 0 0 1px rgba(0,0,0,.06); }
  .mo-id h2 { margin: 0; font-family: var(--m-serif); font-weight: 400; font-size: 34px; line-height: 1; letter-spacing: -.01em; }
  .mo-id span { display: block; margin-top: 5px; font-size: 12.5px; color: var(--m-mu); }
  .mo-tl { margin: 0; font-size: 14.5px; color: var(--m-ink-2); max-width: 52ch; }
  .mo-st { grid-column: 2; grid-row: 1 / span 2; display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--m-line); border-bottom: 1px solid var(--m-line); }
  .mo-st div { padding: 12px 12px 12px 0; min-width: 0; }
  .mo-st div + div { padding-left: 12px; border-left: 1px solid var(--m-line); }
  .mo-st b { display: block; font-family: var(--m-serif); font-weight: 400; font-size: 28px; line-height: 1; }
  .mo-st span { display: block; margin-top: 6px; font-size: 12px; line-height: 1.3; color: var(--m-mu); }
  .mo-lk { grid-column: 3; grid-row: 1 / span 2; display: flex; flex-direction: column; align-items: flex-end; gap: 12px; }
  .mo-story { font-size: 13.5px; font-weight: 500; color: var(--m-ink); text-decoration: none; border-bottom: 1px solid var(--m-ink); white-space: nowrap; }
  .mo-as { font-size: 13px; color: var(--m-mu); text-decoration: none; white-space: nowrap; }
  .mo-as:hover { color: var(--m-ink); }
  @media (max-width: 900px) {
    .mo-app { grid-template-columns: 1fr; padding: 18px; }
    .mo-st, .mo-lk, .mo-tl { grid-column: 1; grid-row: auto; }
    .mo-lk { flex-direction: row; justify-content: space-between; align-items: center; }
    .mo-st b { font-size: 24px; }
  }
  /* Each screen sits on a tinted plate, like the case study covers. */
  .mo .screens { grid-template-columns: repeat(auto-fill, minmax(255px, 1fr)); gap: 20px; }
  .mo .shot { background: #fff; border-radius: 4px; box-shadow: inset 0 0 0 1px var(--m-line); overflow: hidden; gap: 0; }
  .mo .plate { padding: 26px 30px 22px; display: flex; justify-content: center; border-bottom: 1px solid var(--m-line); }
  .mo [data-app="dozy"] .plate { background: var(--tint-lilac); }
  .mo [data-app="ritual"] .plate { background: var(--tint-peach); }
  .mo [data-app="fluo"] .plate { background: var(--tint-mint); }
  .mo .phone { width: 100%; margin: 0; box-shadow: 0 0 0 6px #0d0d0f, 0 0 0 7px #3a3a40, 0 22px 34px -20px rgba(0,0,0,.45); }
  .mo .shot-bd { display: flex; flex-direction: column; gap: 8px; padding: 16px 18px 16px; }
  .mo .cap h3 { font-family: var(--m-serif); font-weight: 400; font-size: 22px; letter-spacing: -.01em; }
  .mo .cap button { border-radius: 3px; border: 0; box-shadow: inset 0 0 0 1px var(--m-line), 2px 2px 0 var(--m-line-2); font-family: 'Geist Mono', ui-monospace, monospace; }
  .mo .cap button:hover { box-shadow: inset 0 0 0 1px var(--m-ink), 2px 2px 0 var(--m-hard); }
  .mo .desc { font-size: 14px; color: var(--m-ink-2); }
  .mo details { border-top-color: var(--m-line-2); }
  .mo summary { color: var(--m-mu); }
  .mo .chap { gap: 18px; }
  .mo-dom { margin: 0; display: flex; gap: 10px; align-items: baseline; font-family: var(--m-serif); font-size: 18px; line-height: 1.3; color: var(--m-ink); }
  .mo-dom-k { flex: none; font: 500 11px 'Geist Mono', ui-monospace, monospace; letter-spacing: .06em; text-transform: uppercase; background: var(--m-ink); color: #fff; border-radius: 3px; padding: 2px 6px; transform: translateY(-2px); }
  .mo-end { padding-bottom: 56px; }
</style>
