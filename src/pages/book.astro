---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Emblem from '../components/Emblem.astro';
import { site, reviews, rating, testimonials } from '../data/site';

const steps = [
  { t: 'Your product and goals', d: 'What you are building, who it is for, and what success looks like.' },
  { t: 'A look at what exists', d: 'Bring your product, site or Figma file. We go through it together.' },
  { t: 'Clear next steps', d: 'You leave with a plan for your product, whether we work together or not.' },
];
const quote = reviews[0];
const faces = testimonials.slice(0, 5);
---
<Base
  title="Book a free strategy call | Fackt"
  description="Book a free 30 minute strategy call with Fackt, a UI/UX and product design studio for SaaS and tech companies."
>
  <Nav />
  <main class="container book">
    <div class="left">
      <a class="back" href="/">← Back to Fackt</a>
      <Emblem size={52} id="book" />
      <p class="kicker">Free strategy call</p>
      <h1>Let's talk about your product.</h1>
      <p class="lede">30 minutes with Dom, founder of Fackt. No pitch deck, no pressure.</p>

      <div class="from glass" id="from" hidden>
        <span class="lift k">From your search</span>
        <span class="lift q" id="from-q"></span>
      </div>

      <ol class="steps">
        {steps.map((s, i) => (
          <li><span class="n">0{i + 1}</span><span><b>{s.t}</b><small>{s.d}</small></span></li>
        ))}
      </ol>

      <figure class="quote">
        <blockquote>"{quote.text.split('. ').slice(0, 2).join('. ')}."</blockquote>
        <figcaption>
          <span class="faces" aria-hidden="true">{faces.map((f) => <img src={`/uploads/${f.id}.webp`} alt="" width="32" height="32" loading="lazy" />)}</span>
          <span><b>{quote.name}</b>, {quote.role}<br /><small>Rated {rating.value} out of 5 on {rating.source}</small></span>
        </figcaption>
      </figure>
    </div>

    <div class="right">
      <div class="frame tint-blue">
        <div class="card glass glass-strong">
          <div class="cal lift" id="cal-inline" data-cal-link={site.calLink}>
            <div class="loading" id="cal-loading">
              <span class="spin" aria-hidden="true"></span>
              <span>Loading available times…</span>
            </div>
          </div>
        </div>
      </div>
      <p class="alt">Calendar not loading? <a href={site.booking} target="_blank" rel="noopener">Open it on Cal.com</a> or email <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .book { padding-top: 130px; display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: 64px; align-items: start; }
  .left { position: sticky; top: 110px; display: flex; flex-direction: column; gap: 18px; }
  .back { text-decoration: none; color: var(--muted); font-size: 15px; margin-bottom: 18px; }
  .kicker { margin: 6px 0 0; }
  h1 { margin: 0; font-size: clamp(40px, 5vw, 60px); line-height: 1.02; letter-spacing: -0.045em; font-weight: 500; }
  .lede { margin: 0; font-size: 18px; color: var(--muted); line-height: 1.55; max-width: 440px; }
  .lift { position: relative; z-index: 3; }
  .from { border-radius: 16px; padding: 12px 16px; display: flex; flex-direction: column; gap: 2px; max-width: 440px; }
  .from[hidden] { display: none; }
  .from .k { font-family: var(--mono); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--blue); }
  .from .q { font-size: 16px; }
  .steps { list-style: none; margin: 14px 0 0; padding: 0; display: flex; flex-direction: column; }
  .steps li { display: grid; grid-template-columns: 44px 1fr; padding: 16px 0; border-top: 1px solid var(--line); }
  .steps .n { font-family: var(--mono); font-size: 12px; color: var(--muted-2); padding-top: 3px; }
  .steps b { display: block; font-weight: 500; font-size: 17px; }
  .steps small { display: block; margin-top: 4px; color: var(--muted); font-size: 15px; line-height: 1.5; }
  .quote { margin: 10px 0 0; padding: 22px; border-radius: var(--radius-md); background: #fafbfc; box-shadow: inset 0 0 0 1px var(--line); }
  .quote blockquote { margin: 0; font-size: 16px; line-height: 1.55; }
  .quote figcaption { margin-top: 16px; display: flex; align-items: center; gap: 12px; font-size: 14px; color: var(--muted); }
  .quote b { color: var(--ink); font-weight: 500; }
  .faces { display: flex; flex-shrink: 0; }
  .faces img { width: 32px; height: 32px; border-radius: 50%; object-fit: cover; border: 2px solid #fff; margin-left: -8px; }
  .faces img:first-child { margin-left: 0; }

  .frame { border-radius: var(--radius-lg); padding: 16px; }
  .card { border-radius: var(--radius-md); padding: 8px; background: rgba(255,255,255,.78); }
  .cal { min-height: 680px; border-radius: 18px; overflow: hidden; background: #fff; }
  .loading { height: 680px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px; color: var(--muted); font-size: 15px; }
  .spin { width: 28px; height: 28px; border-radius: 50%; border: 2.5px solid var(--blue-soft); border-top-color: var(--blue); animation: spin .8s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .alt { margin: 14px 4px 0; font-size: 14px; color: var(--muted); }
  .alt a { color: var(--ink); }

  @media (max-width: 960px) {
    /* Calendar right after the headline on small screens, details below it */
    .book { display: flex; flex-direction: column; gap: 18px; }
    .left { display: contents; }
    .back { margin-bottom: 0; }
    .right { order: 2; margin: 10px 0 16px; }
    .steps, .quote { order: 3; }
  }
  @media (max-width: 720px) {
    .book { padding-top: 104px; }
    .frame { padding: 8px; }
    .card { padding: 4px; }
    .cal, .loading { min-height: 620px; }
  }
</style>

<script>
  // Notes typed into the search bar or the "Tell us what you're building" field
  // arrive as ?notes=... and are prefilled into the booking form.
  const params = new URLSearchParams(window.location.search);
  const notes = (params.get('notes') ?? '').trim().slice(0, 500);
  if (notes) {
    const from = document.getElementById('from');
    const q = document.getElementById('from-q');
    if (from && q) { q.textContent = `"${notes.replace(/^Looking for:\s*/i, '')}"`; from.hidden = false; }
  }

  const el = document.getElementById('cal-inline');
  const calLink = el?.dataset.calLink;
  if (el && calLink) {
    // Official Cal.com embed loader.
    (function (C: any, A: string, L: string) {
      const p = (a: any, ar: any) => a.q.push(ar);
      const d = C.document;
      C.Cal = C.Cal || function (...args: any[]) {
        const cal = C.Cal;
        if (!cal.loaded) {
          cal.ns = {}; cal.q = cal.q || [];
          d.head.appendChild(d.createElement('script')).src = A;
          cal.loaded = true;
        }
        if (args[0] === L) {
          const api: any = function (...a: any[]) { p(api, a); };
          const namespace = args[1];
          api.q = api.q || [];
          if (typeof namespace === 'string') {
            cal.ns[namespace] = cal.ns[namespace] || api;
            p(cal.ns[namespace], args);
            p(cal, ['initNamespace', namespace]);
          } else p(cal, args);
          return;
        }
        p(cal, args);
      };
    })(window, 'https://app.cal.com/embed/embed.js', 'init');

    const Cal = (window as any).Cal;
    Cal('init', 'fackt', { origin: 'https://cal.com' });
    const config: Record<string, string> = { layout: 'month_view', theme: 'light' };
    if (notes) config.notes = notes;
    Cal.ns.fackt('inline', { elementOrSelector: '#cal-inline', calLink, config });
    Cal.ns.fackt('ui', {
      theme: 'light',
      hideEventTypeDetails: false,
      layout: 'month_view',
      cssVarsPerTheme: { light: { 'cal-brand': '#12141a' } },
      styles: { branding: { brandColor: '#12141a' } },
    });
    Cal.ns.fackt('on', {
      action: 'linkReady',
      callback: () => document.getElementById('cal-loading')?.remove(),
    });
    // If the embed is blocked (ad blocker, offline), point people to the fallback link.
    setTimeout(() => {
      const loading = document.getElementById('cal-loading');
      if (loading) loading.querySelector('span:last-child')!.textContent = 'Still loading. Use the Cal.com link below if it does not appear.';
    }, 9000);
  }
</script>
