---
// Book a call: agenda on the left, the live Cal.com calendar in the card on the right.
// Notes typed into the homepage ask bar arrive as ?notes=... and are prefilled into the booking.
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

const agenda = [
  { t: 'Your product and goals', d: 'What you are building, who it is for, and what success looks like.' },
  { t: 'A look at what exists', d: 'Bring your product, site or Figma file. We go through it together.' },
  { t: 'Clear next steps', d: 'You leave with a plan for your product, whether we work together or not.' },
];
---
<Base
  image="/og/book.jpg"
  title="Book a free strategy call | Fackt"
  description="Book a free 30 minute strategy call with Fackt, a UI/UX and product design studio for SaaS and tech companies."
  schema={[{ '@context': 'https://schema.org', '@type': 'Service', name: 'Free 30 minute strategy call', serviceType: 'Product design consultation',
    provider: { '@type': 'Organization', name: 'Fackt', url: 'https://fackt.io' }, offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'A free 30 minute call with Dom, founder of Fackt, about your SaaS product, website or brand, with clear next steps whether you work together or not.' }]}
>
  <div class="m-page">
    <Nav />
    <main class="bk">
      <div class="left">
        <span class="crumb"><a href="/">Fackt</a> <span>/</span> <b>Book a call</b></span>
        <h1>Let&#8217;s talk about your product.</h1>
        <p class="lede">30 minutes with Dom, founder of Fackt. No pitch deck, no pressure.</p>

        <div class="from" id="from" hidden>
          <span class="k">From your search</span>
          <span class="q" id="from-q"></span>
        </div>

        <ol>
          {agenda.map((a, i) => <li><i>0{i + 1}</i><div><b>{a.t}</b><span>{a.d}</span></div></li>)}
        </ol>

        <p class="xp">Framer and Rive experts &#183; Based in {site.location}</p>
        <p class="alt">Not ready for a call? <a class="lnk" href="/audit">Get a free audit of your product</a> instead.</p>
      </div>

      <div class="cal">
        <div class="ch"><b>30 min strategy call</b><span>Free</span></div>
        <div class="bd" id="cal-inline" data-cal-link={site.calLink}>
          <div class="loading" id="cal-loading">
            <span class="spin" aria-hidden="true"></span>
            <span>Loading available times...</span>
          </div>
        </div>
        <div class="ft2"><span>Times in your time zone</span><span>Not loading? <a href={site.booking} target="_blank" rel="noopener">Open it on Cal.com</a></span></div>
      </div>

      <section class="qf" aria-labelledby="book-q">
        <h2 id="book-q">Before you book</h2>
        <div>
          <details open><summary>What happens on the call?</summary><p>You walk Dom through your product, your website or your brand and what you want it to do. He asks a few questions about your users and goals, points out what he would change first, and you leave with clear next steps, whether you work together or not.</p></details>
          <details><summary>Do I need to prepare anything?</summary><p>A link to your product or website is enough. If the product sits behind a login, a quick screen share works too. No pitch deck needed.</p></details>
          <details><summary>Is the call really free?</summary><p>Yes. It is 30 minutes, free and without any commitment. If you would like to see how we work first, browse <a href="/work">the case studies</a>.</p></details>
          <details><summary>What does working with Fackt cost?</summary><p>Fixed-scope projects start from $5,000 and a monthly retainer is $6,900. The full breakdown is in <a href="/blog/saas-product-design-cost">how much SaaS product design costs</a>.</p></details>
          <details><summary>Not ready for a call?</summary><p>Send your product for a <a href="/audit">free audit</a> instead: a video walkthrough and a written list of fixes within 2 days, no call needed.</p></details>
        </div>
      </section>
    </main>
    <Footer />
  </div>
</Base>

<style>
  .bk { width: min(960px, 100% - 32px); margin: 0 auto; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: 56px; padding: 48px 0 72px; align-items: start; }
  /* headline and agenda side by side on top, the calendar full width below so Cal.com shows the month and times next to each other */
  .left { display: contents; }
  .crumb, h1, .lede, .from, .xp, .alt { grid-column: 1; }
  .bk > .qf { grid-column: 1 / -1; }
  .qf { margin-top: 48px; padding-top: 28px; border-top: 1px solid #dcdcd8; display: grid; grid-template-columns: 260px 1fr; gap: 40px; }
  .qf h2 { margin: 0; font-family: var(--m-serif); font-weight: 400; font-size: 26px; line-height: 1.15; }
  .qf details { border-bottom: 1px solid #ececea; padding: 16px 0; }
  .qf details:first-child { padding-top: 0; }
  .qf summary { list-style: none; cursor: pointer; font-weight: 500; font-size: 15px; display: flex; justify-content: space-between; gap: 16px; }
  .qf summary::-webkit-details-marker { display: none; }
  .qf summary::after { content: '+'; color: #8a8a86; font-weight: 400; }
  .qf details[open] summary::after { content: '\2212'; }
  .qf p { margin: 8px 0 0; color: #6a6a66; font-size: 14.5px; line-height: 1.6; max-width: 620px; }
  .qf a { color: #111; }
  @media (max-width: 720px) { .qf { grid-template-columns: 1fr; gap: 16px; } }

  ol { grid-column: 2; grid-row: 1 / span 6; align-self: start; margin-top: 0 !important; }
  .cal { grid-column: 1 / -1; margin-top: 36px; }
  .crumb { font-size: 12.5px; color: #8a8a86; display: flex; gap: 8px; align-items: center; }
  .crumb a { color: inherit; text-decoration: none; }
  .crumb b { color: #111; font-weight: 500; }
  h1 { margin: 14px 0 0; font-family: var(--m-serif); font-weight: 400; font-size: 46px; line-height: 1.06; letter-spacing: -.02em; }
  .lede { margin: 14px 0 0; color: #6a6a66; font-size: 16px; max-width: 460px; }
  .from { margin-top: 20px; padding: 10px 14px; border-radius: 3px; background: #f2f2f0; box-shadow: inset 0 0 0 1px #dcdcd8; display: flex; flex-direction: column; gap: 2px; }
  .from[hidden] { display: none; }
  .from .k { font-size: 11px; font-weight: 500; letter-spacing: .04em; text-transform: uppercase; color: #8a8a86; }
  .from .q { font-size: 14.5px; }
  ol { list-style: none; margin: 28px 0 0; padding: 0; border-top: 1px solid #dcdcd8; }
  ol li { display: grid; grid-template-columns: 30px 1fr; gap: 8px; padding: 16px 0; border-bottom: 1px solid #ececea; }
  ol i { font-style: normal; font-size: 12px; color: #8a8a86; padding-top: 2px; font-variant-numeric: tabular-nums; }
  ol b { display: block; font-weight: 500; }
  ol span { font-size: 13.5px; color: #6a6a66; }
  .xp { margin: 22px 0 0; font-size: 12.5px; color: #8a8a86; }
  .alt { margin: 14px 0 0; font-size: 13.5px; color: #6a6a66; }
  .lnk { color: #111; font-weight: 500; text-decoration: none; border-bottom: 1px solid #111; }

  .cal { display: flex; flex-direction: column; background: #fff; box-shadow: 0 0 0 1px #111, 4px 4px 0 #111; border-radius: 3px; overflow: hidden; }
  .cal .ch { padding: 18px 22px; border-bottom: 1px solid #ececea; display: flex; justify-content: space-between; align-items: center; font-size: 15px; }
  .cal .ch b { font-weight: 500; }
  .cal .ch span { font-size: 12px; font-weight: 500; padding: 3px 8px; border-radius: 2px; background: #111; color: #fff; }
  .cal .bd { min-height: 520px; }
  .loading { height: 560px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px; color: #6a6a66; font-size: 14px; }
  .spin { width: 24px; height: 24px; border-radius: 50%; border: 2px solid #dcdcd8; border-top-color: #111; animation: spin .8s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .cal .ft2 { padding: 12px 22px; border-top: 1px solid #ececea; font-size: 12px; color: #8a8a86; display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .cal .ft2 a { color: #111; }

  @media (max-width: 960px) {
    /* calendar right after the headline, the agenda below it */
    .bk { display: flex; flex-direction: column; gap: 0; padding-top: 28px; }
    .cal { order: 2; margin: 24px 0 8px; }
    ol, .xp, .alt { order: 3; }
  }
  @media (max-width: 720px) {
    h1 { font-size: 36px; }
    .lede { font-size: 14.5px; }
    .cal .ch { padding: 14px 16px; }
    .cal .ft2 { padding: 10px 16px; }
    .cal .bd, .loading { min-height: 520px; }
  }
</style>

<script>
  // Notes typed into the search bar or the "Tell us what you're building" field
  // arrive as ?notes=... and are prefilled into the booking form.
  const params = new URLSearchParams(window.location.search);
  const notes = (params.get('notes') ?? '').trim().slice(0, 500);
  if (notes) {
    const from = document.getElementById('from');
    const q = document.getElementById('from-q');
    if (from && q) { q.textContent = `"${notes.replace(/^Looking for:\s*/i, '')}"`; from.hidden = false; }
  }

  const el = document.getElementById('cal-inline');
  const calLink = el?.dataset.calLink;
  if (el && calLink) {
    // Official Cal.com embed loader.
    (function (C: any, A: string, L: string) {
      const p = (a: any, ar: any) => a.q.push(ar);
      const d = C.document;
      C.Cal = C.Cal || function (...args: any[]) {
        const cal = C.Cal;
        if (!cal.loaded) {
          cal.ns = {}; cal.q = cal.q || [];
          d.head.appendChild(d.createElement('script')).src = A;
          cal.loaded = true;
        }
        if (args[0] === L) {
          const api: any = function (...a: any[]) { p(api, a); };
          const namespace = args[1];
          api.q = api.q || [];
          if (typeof namespace === 'string') {
            cal.ns[namespace] = cal.ns[namespace] || api;
            p(cal.ns[namespace], args);
            p(cal, ['initNamespace', namespace]);
          } else p(cal, args);
          return;
        }
        p(cal, args);
      };
    })(window, 'https://app.cal.com/embed/embed.js', 'init');

    const Cal = (window as any).Cal;
    Cal('init', 'fackt', { origin: 'https://cal.com' });
    const config: Record<string, string> = { layout: 'month_view', theme: 'light' };
    if (notes) config.notes = notes;
    const vid = (window as any).facktJourney?.visitorId || (() => { try { return JSON.parse(localStorage.getItem('fj_vid') || 'null'); } catch { return null; } })();
    if (vid) config['metadata[fackt_vid]'] = vid;
    Cal.ns.fackt('inline', { elementOrSelector: '#cal-inline', calLink, config });
    Cal.ns.fackt('ui', {
      theme: 'light',
      hideEventTypeDetails: true,
      layout: 'month_view',
      cssVarsPerTheme: { light: { 'cal-brand': '#111111' } },
      styles: { branding: { brandColor: '#111111' } },
    });
    Cal.ns.fackt('on', {
      action: 'linkReady',
      callback: () => document.getElementById('cal-loading')?.remove(),
    });
    // If the embed is blocked (ad blocker, offline), point people to the fallback link.
    setTimeout(() => {
      const loading = document.getElementById('cal-loading');
      if (loading) loading.querySelector('span:last-child')!.textContent = 'Still loading. Use the Cal.com link below if it does not appear.';
    }, 9000);
  }
</script>
