---
// HOMEPAGE TEST VERSION B (noindex; the worker shows it at fackt.io/ to a third of visitors, see worker/index.js).
// Same design as the live homepage, simplified from the feedback (Figma: Fackt LP Claude, "B v2 / simpler, from feedback"):
// a plain "X for Y" headline, one button with the audit as a quiet link, logos and real results right under the hero,
// fewer options (no Figma button, no stage chips) and much less text: 4 projects as image and name, one line per service,
// no process section, 5 videos and 4 one line quotes, 3 features per plan.

import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import EasterGame from '../components/EasterGame.astro';
import SketchDefs from '../components/home/SketchDefs.astro';
import Step from '../components/home/Step.astro';
import Hero from '../components/home/Hero.astro';
import ProofRow from '../components/home/ProofRow.astro';
import Work from '../components/home/Work.astro';
import Services from '../components/home/Services.astro';
import Proof from '../components/home/Proof.astro';
import Pricing from '../components/home/Pricing.astro';
import EndCta from '../components/home/EndCta.astro';
import PhoneBar from '../components/home/PhoneBar.astro';

const byOrder = <T extends { data: { order: number } }>(a: T, b: T) => a.data.order - b.data.order;
const all = (await getCollection('work')).sort(byOrder).map((e) => ({ slug: e.id, ...e.data }));
import { stageCategories } from '../data/stage';
const bySlug = new Map(all.map((p) => [p.slug, p]));
const stage = stageCategories.flatMap((c, ci) => c.slides.filter((s) => bySlug.has(s.slug)).map((s) => ({ ...bySlug.get(s.slug)!, stageImage: s.image, cat: ci, stageLabel: c.label })));
// Four projects, chosen in Figma. Promote's app case study is the one the 2.5x result belongs to.
const featured = ['firecut', 'communi', 'floxy', 'promote-app'].map((s) => all.find((p) => p.slug === s)).filter((p): p is (typeof all)[number] => !!p);
const quotes = (await getCollection('quotes')).sort(byOrder).map((e) => e.data);
const videos = (await getCollection('videos')).sort(byOrder).map((e) => e.data);
const reviews = (await getCollection('reviews')).sort(byOrder).map((e) => e.data);
// Structured answers for search engines and AI assistants: the "ask anything" answers on the homepage as a FAQ.
import { homeSettings } from '../data/settings';
const faqLd = (homeSettings.ask as any[]).filter((a) => a.type === 'answer' && a.answer);
const _schema = faqLd.length ? [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqLd.map((a) => ({ '@type': 'Question', name: a.question, acceptedAnswer: { '@type': 'Answer', text: a.answer } })) }] : [];
---
<Base title="Fackt: product design for SaaS and AI startups" noindex lcp={stage[0]?.stageImage ?? stage[0]?.image}>
  <div class="m-page">
    <SketchDefs />
    <Nav figmaButton={false} />
    <main>
      <Hero variant="b" chips={false} stage={stage} cats={stageCategories.map((c) => c.label)} all={all} quotes={quotes}
        title="Product design for SaaS and AI startups." text="We redesign confusing products, websites and brands, so new users understand what you built and stay." />
      <ProofRow variant="b" />
      <Step />
      <Work projects={featured} total={all.length} lean resultChips />
      <Step />
      <Services short lean />
      <Step />
      <Proof videos={videos} reviews={reviews} maxVideos={5} short
        highlights={["Best product designer I've ever worked with.", 'Super reliable and easy to work with.', 'We would 100% work with Dominik again.', 'Communication was easy and he has strong visual craft.']} />
      <Step />
      <Pricing variant="b" lean keep={['Weekly check-ins', 'Unlimited design requests', 'Dedicated Slack channel', 'Milestones, 2 to 6 weeks', 'Clearly defined scope', 'End-to-end project support']} />
      <Step />
      <EndCta variant="b" />
    </main>
    <Footer />
    <PhoneBar variant="b" />
    <EasterGame />
  </div>
</Base>
