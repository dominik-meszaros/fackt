---
// Case study. Every section below the hero is optional and only shows when it is filled in
// (CMS: Work > project > Case study fields). With nothing filled in, the markdown body shows instead.
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import WorkCta from '../../components/pages/work/WorkCta.astro';
import NoteFromDom from '../../components/NoteFromDom.astro';
import { site } from '../../data/site';
import { publishedPosts } from '../../data/blog';

export async function getStaticPaths() {
  const all = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  return all.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, next: all[(i + 1) % all.length] } }));
}
const { entry, next } = Astro.props;
const said = (await getCollection('videos')).map((v) => v.data).find((v) => v.video && v.company.toLowerCase() === entry.data.name.toLowerCase());
const { Content } = await render(entry);
const note = (await publishedPosts()).find((b) => b.data.related === entry.id);
const p = entry.data;
// Full-width presentation boards (kind: board) show edge to edge under the write-up; screens show in the column.
const boards = p.gallery.filter((g) => g.kind === 'board');
const shots = p.gallery.filter((g) => g.kind !== 'board');
const body = (entry.body ?? '').trim();
// The starter text in each project is an instruction for the editor, never show it on the site.
const bodyIsStub = !body || /Replace this text/i.test(body);

const blocks = [
  p.challenge || p.challengeTitle ? { id: 'challenge', label: 'The challenge' } : null,
  p.approach || p.approachTitle ? { id: 'approach', label: 'What we did' } : null,
  p.results.length || p.resultsTitle ? { id: 'results', label: 'Results' } : null,
  said ? { id: 'words', label: 'In their words' } : null,
  p.gallery.length ? { id: 'screens', label: 'Screens' } : null,
].filter(Boolean) as { id: string; label: string }[];
// Our own apps with chapters use the chapter layout: build numbers and the challenge up top, then one block per chapter (text and its board).
const app = p.chapters.length > 0;
if (app) blocks.splice(0, blocks.length, ...(p.challenge ? [{ id: 'challenge', label: 'The challenge' }] : []), ...p.chapters.map((c, i) => ({ id: `ch-${i + 1}`, label: c.title })));
const showBody = !app && (blocks.length === 0 || !bodyIsStub);
if (showBody && !bodyIsStub) blocks.unshift({ id: 'overview', label: 'Overview' });
const caseSchema = [
  { '@context': 'https://schema.org', '@type': 'CreativeWork', name: `${p.name}: ${p.service}`, about: p.summary, description: p.summary, url: new URL(`/work/${entry.id}`, site.url).toString(), image: new URL(p.preview ?? p.image, site.url).toString(), creator: { '@type': 'Organization', name: 'Fackt', url: site.url }, genre: p.service },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Fackt', item: site.url },
    { '@type': 'ListItem', position: 2, name: 'Work', item: new URL('/work', site.url).toString() },
    { '@type': 'ListItem', position: 3, name: p.name, item: new URL(`/work/${entry.id}`, site.url).toString() },
  ] },
];
const paras = (t?: string) => (t ?? '').split(/\n\s*\n/).map((s) => s.trim()).filter(Boolean);
---
<Base type="article" schema={caseSchema} title={`${p.name}: ${p.service} case study | Fackt`} description={p.summary} image={`/og/work-${entry.id}.jpg`}>
  <div class="m-page">
    <Nav />
    <main>
      <section class="cs-h">
        <div>
          <span class="crumb"><a href="/work">Work</a> <span>/</span> <b>{p.name}</b></span>
          {p.icon
            ? <div class="appid"><img src={p.icon} alt={`${p.name} app icon`} width="64" height="64" /><div><h1>{p.name}</h1><span class="mu2">{p.service}</span></div></div>
            : <><span class="tag">{p.service}</span><h1>{p.name}</h1></>}
          <p class="lede">{p.summary}</p>
          {p.appStore && (
            <div class="acts"><a class="m-btn dk" href={p.appStore} target="_blank" rel="noopener">View on the App Store &#8599;</a><a class="m-btn lt" href={site.bookPage}>Book a call about your app</a></div>
          )}
        </div>
        <dl class="cs-meta">
          <div><dt>Client</dt><dd>{p.ownApp ? 'Fackt, our own app' : p.name}</dd></div>
          {p.year && <div><dt>Year</dt><dd>{p.year}</dd></div>}
          <div><dt>Services</dt><dd>{p.service}</dd></div>
          {p.platform && <div><dt>Platform</dt><dd>{p.platform}</dd></div>}
          {p.stack && <div class="wide"><dt>Stack</dt><dd>{p.stack}</dd></div>}
          {p.scope && !app && <div class="wide"><dt>Scope</dt><dd>{p.scope}</dd></div>}
        </dl>
      </section>

      <div class:list={['cs-stage', { ph: p.imageKind === 'phone' && !p.preview, pv: !!p.preview }]}>
        <picture>{p.card && <source media="(max-width: 720px)" srcset={p.card} />}<img src={p.preview ?? p.image} alt={`${p.name}, ${p.service.toLowerCase()} by Fackt`} /></picture>
      </div>

      <section class:list={['cs-body', { solo: blocks.length < 2, app }]}>
        {blocks.length > 1 && (
          <nav class="toc" aria-label="On this page" data-toc>
            {app && <span class="eb">Chapters</span>}
            {blocks.map((b, i) => <a class:list={{ on: i === 0 }} href={`#${b.id}`}>{app && b.id.startsWith('ch-') && <i>{b.id.slice(3).padStart(2, '0')}</i>}{b.label}</a>)}
          </nav>
        )}
        <div class="col">
          {app && p.results.length > 0 && (
            <div class="blk nums-top"><span class="eb">{p.resultsTitle ?? 'The build in numbers'}</span><div class="nums four">{p.results.map((r) => <div><b>{r.value}</b><span>{r.label}</span></div>)}</div></div>
          )}
          {app && p.challenge && (
            <div class="blk" id="challenge"><span class="eb">The challenge</span>{paras(p.challenge).map((t) => <p class="big">{t}</p>)}</div>
          )}
          {app && p.chapters.map((c, i) => (
            <div class="blk ch" id={`ch-${i + 1}`}>
              <h2><i>{String(i + 1).padStart(2, '0')}</i>{c.title}</h2>
              {paras(c.text).map((t) => <p>{t}</p>)}
              <figure><img src={c.image} alt={c.caption || `${p.name}: ${c.title}`} loading={i < 1 ? 'eager' : 'lazy'} decoding="async" /></figure>
            </div>
          ))}
          {showBody && !bodyIsStub && (
            <div class="blk prose" id="overview"><span class="eb">Overview</span><Content /></div>
          )}
          {showBody && bodyIsStub && (
            <div class="blk soon">
              <span class="eb">Case study</span>
              <h2>The full write-up is on its way.</h2>
              <p>Want the story behind {p.name} now? Dom can walk you through the project on a free call.</p>
              <a class="lnk" href={site.bookPage}>Book a free call &#8594;</a>
            </div>
          )}
          {!app && (p.challenge || p.challengeTitle) && (
            <div class="blk" id="challenge"><span class="eb">The challenge</span>{p.challengeTitle && <h2>{p.challengeTitle}</h2>}{paras(p.challenge).map((t) => <p>{t}</p>)}</div>
          )}
          {(p.approach || p.approachTitle) && (
            <div class="blk" id="approach"><span class="eb">What we did</span>{p.approachTitle && <h2>{p.approachTitle}</h2>}{paras(p.approach).map((t) => <p>{t}</p>)}</div>
          )}
          {!app && (p.results.length > 0 || p.resultsTitle) && (
            <div class="blk" id="results">
              <span class="eb">Results</span>{p.resultsTitle && <h2>{p.resultsTitle}</h2>}
              {p.results.length > 0 && <div class="nums">{p.results.map((r) => <div><b>{r.value}</b><span>{r.label}</span></div>)}</div>}
            </div>
          )}
          {said && (
            <div class="blk" id="words">
              <span class="eb">In their words</span>
              <h2>{said.name}, {said.role} at {said.company}</h2>
              <div class="said"><video controls playsinline preload="none" poster={said.thumbnail} src={said.video}></video></div>
            </div>
          )}
          {shots.length > 0 && (
            <div class="blk" id={boards.length ? undefined : 'screens'}>
              <span class="eb">Screens</span>
              <div class:list={['gal', { one: shots.length === 1 }]}>
                {shots.map((g) => (
                  <figure>
                    <div class:list={['gst', { ph: g.kind === 'phone' }]}><img src={g.image} alt={g.caption || `${p.name} screen`} loading="lazy" decoding="async" /></div>
                    {g.caption && <figcaption>{g.caption}</figcaption>}
                  </figure>
                ))}
              </div>
            </div>
          )}
          {p.quote && (
            <figure class="quote">
              {p.quotePhoto && <img src={p.quotePhoto} alt="" width="64" height="64" loading="lazy" />}
              <div>
                <blockquote>&#8220;{p.quote}&#8221;</blockquote>
                {p.quoteName && <figcaption><b>{p.quoteName}</b>{p.quoteRole && <>, {p.quoteRole}</>}</figcaption>}
              </div>
            </figure>
          )}
          <NoteFromDom from="Case study" id={entry.id} line={app ? `Building an app like ${p.name}? <i>Two easy next steps:</i>` : `Building something like ${p.name}? <i>Two easy next steps:</i>`} />
        </div>
      </section>
      {boards.length > 0 && (
        <section class="boards" id="screens" aria-label={`${p.name} screens`}>
          {boards.map((g, i) => (
            <figure class="bd">
              {g.video
                ? <video class="bv" data-bv={g.video} poster={g.image} muted loop playsinline preload="none" aria-label={g.caption || `${p.name} animation`}></video>
                : <img src={g.image} alt={g.caption || `${p.name} design`} loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />}
              {g.caption && <figcaption><i>{String(i + 1).padStart(2, '0')}</i>{g.caption}</figcaption>}
            </figure>
          ))}
        </section>
      )}
      {note && (
        <a class="rnote" href={`/blog/${note.id}`}>
          <img src={note.data.cover} alt="" loading="lazy" />
          <span><small>Related note</small><b>{note.data.title}</b></span>
          <span class="ra">Read &#8594;</span>
        </a>
      )}
      <div class="nxw">
          <a class="next" href={`/work/${next.id}`}>
            <span class="mu2">Next case study</span>
            <span class="nx">
              <span class="nt"><b>{next.data.name}</b><span class="mu2">{next.data.service}</span></span>
              <img src={next.data.preview ?? next.data.image} alt="" loading="lazy" />
            </span>
          </a>
      </div>
      <WorkCta title="Want results like this?" />
    </main>
    <Footer />
  </div>
</Base>

<style>
  .cs-h, .cs-body { width: min(960px, 100% - 32px); margin: 0 auto; }
  .cs-h { padding: 48px 0 0; display: grid; grid-template-columns: 1fr 300px; gap: 56px; align-items: end; }
  .crumb { font-size: 12.5px; color: var(--m-mu-2); display: flex; gap: 8px; align-items: center; }
  .crumb a { color: inherit; text-decoration: none; }
  .crumb a:hover { color: var(--m-ink); }
  .crumb b { color: var(--m-ink); font-weight: 500; }
  .tag { display: inline-flex; margin-top: 16px; font-size: 12.5px; font-weight: 500; padding: 4px 9px; border-radius: 2px; box-shadow: inset 0 0 0 1px var(--m-line); background: #fff; }
  h1 { margin: 12px 0 0; font-family: var(--m-serif); font-weight: 400; font-size: 52px; line-height: 1.06; letter-spacing: -.02em; }
  .lede { margin: 14px 0 0; color: var(--m-mu); font-size: 16px; max-width: 560px; }
  .cs-meta { margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 16px 20px; font-size: 13.5px; padding-left: 24px; border-left: 1px solid var(--m-line-2); }
  .cs-meta dt { font-size: 12px; color: var(--m-mu-2); }
  .cs-meta dd { margin: 0; font-weight: 500; }
  .cs-meta .wide { grid-column: 1 / -1; }

  .cs-stage { position: relative; overflow: hidden; width: min(1120px, 100% - 32px); height: 600px; margin: 40px auto 0; background: var(--m-soft); box-shadow: inset 0 0 0 1px var(--m-line); border-radius: 4px; }
  .cs-stage img { position: absolute; left: 50%; top: 60px; width: min(820px, 86%); transform: translateX(-50%); border-radius: 3px; box-shadow: 0 0 0 1px #111, 6px 6px 0 rgba(17, 17, 17, .08); }
  .cs-stage.ph img { width: 250px; top: 50px; border-radius: 24px; }
  .cs-stage.pv { background: #fff; }
  .cs-stage.pv::after { content: ''; position: absolute; inset: 0; border-radius: inherit; box-shadow: inset 0 0 0 1px #e2e2de; pointer-events: none; }
  .cs-stage.pv img { left: 0; top: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; transform: none; border-radius: 0; box-shadow: none; }

  .cs-body { display: grid; grid-template-columns: 220px 1fr; gap: 56px; padding: 64px 0 24px; }
  .cs-body.solo { grid-template-columns: 1fr; max-width: 720px; }
  .toc { position: sticky; top: 96px; font-size: 13.5px; display: flex; flex-direction: column; gap: 10px; border-left: 1px solid var(--m-line-2); padding-left: 14px; align-self: start; }
  .toc a { color: var(--m-mu-2); text-decoration: none; position: relative; }
  .toc a:hover { color: var(--m-ink); }
  .toc a.on { color: var(--m-ink); font-weight: 500; }
  .toc a.on::before { content: ''; position: absolute; left: -15px; top: 2px; bottom: 2px; width: 1.5px; background: var(--m-ink); }
  .col { min-width: 0; }
  .blk { padding-bottom: 40px; scroll-margin-top: 96px; }
  .eb { font-size: 12.5px; color: var(--m-mu-2); display: block; margin-bottom: 10px; }
  .blk h2 { margin: 0; font-family: var(--m-serif); font-weight: 400; font-size: 26px; line-height: 1.15; letter-spacing: -.01em; }
  .blk p, .prose :global(p), .prose :global(li) { font-size: 15.5px; line-height: 1.6; color: var(--m-ink-2); max-width: 620px; }
  .blk p { margin: 12px 0 0; }
  .prose :global(h2), .prose :global(h3) { font-family: var(--m-serif); font-weight: 400; margin: 28px 0 0; }
  .prose :global(h2) { font-size: 26px; }
  .prose :global(img) { max-width: 100%; border-radius: 3px; box-shadow: 0 0 0 1px #111; }
  .prose :global(a) { color: var(--m-ink); font-weight: 500; }
  .soon { padding: 26px 28px 28px; background: #f4f4f2; border-radius: 4px; margin-bottom: 40px; }
  .soon p { margin: 8px 0 14px; color: var(--m-mu); font-size: 14.5px; }
  .lnk { color: var(--m-ink); font-weight: 500; font-size: 14px; text-decoration: none; border-bottom: 1px solid var(--m-ink); }

  .appid { display: flex; gap: 16px; align-items: center; margin-top: 18px; }
  .appid img { width: 64px; height: 64px; flex-shrink: 0; }
  .appid h1 { margin: 0; }
  .acts { display: flex; gap: 12px; margin-top: 20px; flex-wrap: wrap; }
  .cs-body.app { width: min(1280px, 100% - 32px); grid-template-columns: 220px 1fr; gap: 100px; }
  .app .toc { gap: 8px; top: 96px; }
  .app .toc .eb { margin: 0 0 4px; }
  .app .toc a { display: flex; gap: 10px; font-size: 13px; }
  .app .toc a i { font-style: normal; font-family: var(--mono); font-size: 11px; width: 16px; padding-top: 2px; color: var(--m-mu-2); }
  .nums.four { grid-template-columns: repeat(4, 1fr); }
  .nums-top { padding-bottom: 48px; }
  .blk p.big { font-family: var(--m-serif); font-size: 27px; line-height: 1.35; color: var(--m-ink); max-width: 760px; letter-spacing: -.005em; }
  .ch { padding-top: 32px; }
  .ch h2 { display: flex; gap: 12px; align-items: baseline; font-size: 30px; }
  .ch h2 i { font-style: normal; font-family: var(--mono); font-size: 12px; color: var(--m-mu-2); }
  .ch figure { margin: 22px 0 0; }
  .ch img { display: block; width: 100%; height: auto; border-radius: 4px; box-shadow: 0 0 0 1px var(--m-line); background: var(--m-soft); }
  .nums { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 20px; border-top: 1px solid var(--m-line); }
  .nums div { padding: 18px 18px 0 0; }
  .nums div + div { padding-left: 18px; border-left: 1px solid var(--m-line-2); }
  .nums b { display: block; font-family: var(--m-serif); font-weight: 400; font-size: 36px; line-height: 1; }
  .nums span { display: block; margin-top: 8px; font-size: 13px; color: var(--m-mu-2); }

  .boards { width: min(1120px, 100% - 32px); margin: 8px auto 0; display: flex; flex-direction: column; gap: 20px; scroll-margin-top: 96px; }
  .bd { margin: 0; }
  .bd .bv { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 4px; box-shadow: 0 0 0 1px var(--m-line); background: var(--m-soft); }
  .bd img { display: block; width: 100%; height: auto; border-radius: 4px; box-shadow: 0 0 0 1px var(--m-line); background: var(--m-soft); }
  .bd figcaption { display: flex; gap: 10px; margin-top: 10px; font-size: 13px; color: var(--m-mu-2); }
  .bd figcaption i { font-style: normal; color: var(--m-ink); font-variant-numeric: tabular-nums; }
  .nxw { width: min(960px, 100% - 32px); margin: 48px auto 0; }
  .said { margin-top: 18px; max-width: 420px; border-radius: 4px; overflow: hidden; box-shadow: 0 0 0 1px #111, 4px 4px 0 #111; background: #111; }
  .said video { display: block; width: 100%; max-height: 560px; }
  .gal { display: grid; grid-template-columns: 1.4fr 1fr; gap: 16px; margin-top: 8px; }
  .gal.one { grid-template-columns: 1fr; }
  .gal figure { margin: 0; }
  .gst { position: relative; overflow: hidden; height: 340px; background: var(--m-soft); box-shadow: inset 0 0 0 1px var(--m-line); border-radius: 4px; }
  .gst img { position: absolute; left: 50%; top: 36px; width: 86%; transform: translateX(-50%); border-radius: 3px; box-shadow: 0 0 0 1px #111; }
  .gst.ph img { width: 150px; top: 30px; border-radius: 12px; }
  .gal figcaption { font-size: 12.5px; color: var(--m-mu-2); margin-top: 8px; }

  .quote { margin: 8px 0 0; display: grid; grid-template-columns: auto 1fr; gap: 20px; align-items: center; padding: 28px 32px; border-radius: 4px; background: #f4f4f2; }
  .quote > div:only-child { grid-column: 1 / -1; }
  .quote img { width: 64px; height: 64px; border-radius: 3px; object-fit: cover; filter: grayscale(1); }
  .quote blockquote { margin: 0; font-family: var(--m-serif); font-style: italic; font-size: 21px; line-height: 1.35; }
  .quote figcaption { margin-top: 8px; font-size: 13px; color: var(--m-mu-2); }
  .quote figcaption b { color: var(--m-ink); font-weight: 500; }

  .mu2 { color: var(--m-mu-2); font-size: 13px; }
  .next { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 28px 0; border-top: 1px solid var(--m-line); border-bottom: 1px solid var(--m-line); margin-top: 32px; color: inherit; text-decoration: none; }
  .next .nx { display: flex; align-items: center; gap: 18px; }
  .rnote { width: min(960px, 100% - 32px); margin: 48px auto 0; display: flex; align-items: center; gap: 18px; padding: 14px 18px; border-radius: 4px; box-shadow: inset 0 0 0 1px #dcdcd8; color: inherit; text-decoration: none; }
  .rnote:hover { box-shadow: inset 0 0 0 1px #111; }
  .rnote img { width: 120px; height: 68px; object-fit: cover; border-radius: 3px; flex-shrink: 0; }
  .rnote small { display: block; font-size: 12px; color: #767672; }
  .rnote b { display: block; font-weight: 500; margin-top: 2px; }
  .rnote .ra { margin-left: auto; font-weight: 500; white-space: nowrap; }
  .next .nt { text-align: right; }
  .next .nt b { display: block; font-weight: 500; font-size: 18px; }
  .next img { width: 120px; height: 76px; object-fit: cover; object-position: top; border-radius: 3px; box-shadow: 0 0 0 1px #111; transition: transform .4s var(--m-ease); }
  .next:hover img { transform: translateY(-3px); }

  @media (max-width: 720px) {
    .cs-h { grid-template-columns: 1fr; gap: 22px; padding-top: 24px; }
    h1 { font-size: 36px; }
    .lede { font-size: 14.5px; }
    .cs-meta { padding: 16px 0 0; border-left: 0; border-top: 1px solid var(--m-line-2); }
    .cs-stage { height: 250px; margin-top: 24px; }
    .cs-stage img { width: calc(100% - 38px); top: 28px; }
    .cs-stage.ph img { width: 130px; top: 24px; border-radius: 16px; }
    .cs-stage.pv img { width: 100%; top: 0; }
    .cs-body { grid-template-columns: 1fr; gap: 0; padding-top: 36px; }
    .toc { display: none; }
    .blk p, .prose :global(p) { font-size: 14.5px; }
    .nums { grid-template-columns: 1fr; }
    .nums.four { grid-template-columns: 1fr 1fr; }
    .nums.four div { padding: 14px 10px 14px 0; border-left: 0; }
    .nums.four div:nth-child(even) { padding-left: 12px; border-left: 1px solid var(--m-line-2); }
    .cs-body.app { grid-template-columns: 1fr; gap: 0; width: calc(100% - 32px); }
    .blk p.big { font-size: 21px; }
    .ch h2 { font-size: 24px; }
    .appid img { width: 52px; height: 52px; }
    .app .toc { display: flex; flex-direction: row; gap: 6px; position: sticky; top: 0; z-index: 5; margin: 0 -16px; padding: 10px 16px; overflow-x: auto; scrollbar-width: none; background: #fff; border-left: 0; border-bottom: 1px solid var(--m-line-2); }
    .app .toc .eb, .app .toc a i { display: none; }
    .app .toc a { flex-shrink: 0; font-size: 12px; padding: 5px 10px; border-radius: 3px; box-shadow: inset 0 0 0 1px var(--m-line); }
    .app .toc a.on { background: var(--m-ink); color: #fff; box-shadow: none; }
    .app .toc a.on::before { display: none; }
    .nums div, .nums div + div { padding: 14px 0; border-left: 0; border-bottom: 1px solid var(--m-line-2); }
    .gal { grid-template-columns: 1fr; }
    .gst { height: 220px; }
    .quote { grid-template-columns: 1fr; padding: 22px 20px; }
    .quote blockquote { font-size: 18px; }
    .next { flex-direction: column; align-items: flex-start; gap: 14px; }
    .next .nt { text-align: left; }
    .next .nx { flex-direction: row-reverse; }
  }
</style>

<script>
  // Animated boards: load and play an mp4 only while it is on screen, pause it when it leaves.
  // With reduced motion the poster image stays and nothing plays.
  const bvs = Array.from(document.querySelectorAll<HTMLVideoElement>('video[data-bv]'));
  if (bvs.length && 'IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      const v = e.target as HTMLVideoElement;
      if (e.isIntersecting) { if (!v.src) v.src = v.dataset.bv!; v.play().catch(() => {}); }
      else v.pause();
    }), { rootMargin: '200px 0px' });
    bvs.forEach((v) => io.observe(v));
  }

  // Highlight the section you are reading in the side contents.
  const toc = document.querySelector<HTMLElement>('[data-toc]');
  if (toc && 'IntersectionObserver' in window) {
    const links = [...toc.querySelectorAll<HTMLAnchorElement>('a')];
    const set = (id: string) => links.forEach((a) => {
      const on = a.getAttribute('href') === `#${id}`;
      a.classList.toggle('on', on);
      // On phones the chapters are a row of chips: keep the active one in view.
      if (on && toc.scrollWidth > toc.clientWidth) toc.scrollTo({ left: a.offsetLeft - 16, behavior: 'smooth' });
    });
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) set(e.target.id); }), { rootMargin: '-30% 0px -60% 0px' });
    links.forEach((a) => { const el = document.querySelector(a.getAttribute('href')!); if (el) io.observe(el); });
  }
</script>
