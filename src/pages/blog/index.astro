---
// Blog index ("Fackt notes"). Lists published notes only; drafts are hidden until draft is switched off in the CMS.
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import PostCard from '../../components/blog/PostCard.astro';
import { publishedPosts, readTime } from '../../data/blog';

const posts = (await publishedPosts()).map((p) => ({ slug: p.id, ...p.data, time: readTime(p.body, p.data.readTime) }));
const [first, ...rest] = posts;
const cats = [...new Set(posts.map((p) => p.category))];
const blogLd = [{ '@context': 'https://schema.org', '@type': 'Blog', name: 'Fackt notes', url: 'https://fackt.io/blog',
  blogPost: posts.map((p) => ({ '@type': 'BlogPosting', headline: p.title, description: p.description, url: `https://fackt.io/blog/${p.slug}`, datePublished: new Date(p.date).toISOString() })) }];
---
<Base image="/og/blog.jpg" title="Fackt notes: SaaS product design, in practice" description="Short, practical notes on designing SaaS products people pay for. Written by Dom from real client work." noindex={posts.length === 0} schema={blogLd}>
  <div class="m-page">
    <Nav />
    <main class="bl">
      <div class="bl-h">
        <div>
          <span class="crumb"><a href="/">Fackt</a> <span>/</span> <b>Blog</b></span>
          <h1>Fackt notes</h1>
        </div>
        <p>Short, practical notes on designing SaaS products people pay for. Written by Dom, from real client work.</p>
      </div>

      {posts.length === 0 && <p class="empty">The first notes are on their way. Meanwhile, <a href="/audit">get a free audit</a> of your product.</p>}

      {cats.length > 1 && (
        <div class="flt" role="group" aria-label="Filter notes" data-bf>
          <button type="button" class="on" aria-pressed="true" data-c="all">All</button>
          {cats.map((c) => <button type="button" aria-pressed="false" data-c={c}>{c}</button>)}
        </div>
      )}

      {first && (
        <div class="feat" data-cat={first.category}>
          <PostCard slug={first.slug} title={first.title} description={first.description} category={first.category} cover={first.cover} time={first.time} big eager />
        </div>
      )}
      {rest.length > 0 && <div class="grid">{rest.map((p) => <div data-cat={p.category}><PostCard slug={p.slug} title={p.title} category={p.category} cover={p.cover} time={p.time} /></div>)}</div>}

      <div class="sub">
        <div><b>Want this applied to your product?</b><p>Get a free audit: a video walkthrough and a written list of what to fix first.</p></div>
        <a class="m-btn dk" href="/audit">Get a free audit</a>
      </div>
    </main>
    <Footer />
  </div>
</Base>

<style>
  .bl { width: min(960px, 100% - 32px); margin: 0 auto; padding-bottom: 72px; }
  .bl-h { padding: 56px 0 8px; display: flex; justify-content: space-between; align-items: flex-end; gap: 40px; }
  .bl-h p { margin: 0; max-width: 360px; color: #6a6a66; font-size: 14.5px; }
  .crumb { font-size: 12.5px; color: #767672; display: flex; gap: 8px; align-items: center; }
  .crumb a { color: inherit; text-decoration: none; }
  .crumb b { color: #111; font-weight: 500; }
  h1 { margin: 14px 0 0; font-family: var(--m-serif); font-weight: 400; font-size: 52px; line-height: 1.06; letter-spacing: -.02em; }
  .empty { margin: 40px 0 0; color: #6a6a66; }
  .empty a { color: #111; }
  .flt { display: inline-flex; margin-top: 28px; box-shadow: inset 0 0 0 1px #c8c8c4; border-radius: 3px; overflow: hidden; }
  .flt button { all: unset; cursor: pointer; height: 34px; padding: 0 14px; display: inline-flex; align-items: center; font-size: 13px; color: #6f6f6f; }
  .flt button + button { border-left: 1px solid #dcdcd8; }
  .flt button.on { background: #111; color: #fff; }
  .feat { margin-top: 32px; padding-bottom: 40px; border-bottom: 1px solid #ececea; }
  .feat :global(.bc) { display: grid; grid-template-columns: 1.35fr 1fr; column-gap: 32px; align-items: center; }
  .feat :global(.cv) { grid-row: 1 / span 4; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px 24px; margin-top: 40px; }
  [hidden] { display: none !important; }
  .sub { margin-top: 56px; padding: 28px 32px; border-radius: 4px; background: #f4f4f2; display: flex; justify-content: space-between; align-items: center; gap: 24px; }
  .sub b { font-family: var(--m-serif); font-weight: 400; font-size: 22px; }
  .sub p { margin: 4px 0 0; color: #6a6a66; font-size: 14px; }
  @media (max-width: 720px) {
    .bl-h { flex-direction: column; align-items: flex-start; gap: 10px; padding-top: 28px; }
    h1 { font-size: 36px; }
    .feat :global(.bc) { display: block; }
    .grid { grid-template-columns: 1fr; gap: 28px; }
    .sub { flex-direction: column; align-items: flex-start; padding: 22px 20px; }
  }
</style>

<script>
  const btns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-bf] button'));
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-cat]'));
  btns.forEach((b) => b.addEventListener('click', () => {
    btns.forEach((x) => { const on = x === b; x.classList.toggle('on', on); x.setAttribute('aria-pressed', String(on)); });
    items.forEach((el) => { el.hidden = b.dataset.c !== 'all' && el.dataset.cat !== b.dataset.c; });
  }));
</script>
