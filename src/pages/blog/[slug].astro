---
// One note. Drafts are built too (noindex, with a "Draft preview" bar) so you can read them before publishing.
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import PostCard from '../../components/blog/PostCard.astro';
import Mark from '../../components/home/Mark.astro';
import { publishedPosts, readTime } from '../../data/blog';
import { site } from '../../data/site';
import { existsSync } from 'node:fs';

export async function getStaticPaths() {
  return (await getCollection('blog')).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const p = entry.data;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);
const time = readTime(entry.body, p.readTime);
const work = p.related ? (await getCollection('work')).find((w) => w.id === p.related) : undefined;
const more = (await publishedPosts()).filter((x) => x.id !== entry.id).slice(0, 3);
const url = new URL(`/blog/${entry.id}`, site.url).toString();
// Link preview: the drawn 1200x630 version when it exists, otherwise the cover itself.
const og = existsSync(`public/og/blog-${entry.id}.jpg`) ? `/og/blog-${entry.id}.jpg` : p.cover;
const dateLabel = p.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const schema = [
  { '@context': 'https://schema.org', '@type': 'BlogPosting', headline: p.title, description: p.description, url, datePublished: p.date.toISOString(), image: new URL(p.cover, site.url).toString(),
    author: { '@type': 'Person', name: 'Dominik Mészáros', url: site.url }, publisher: { '@type': 'Organization', name: 'Fackt', url: site.url } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Fackt', item: site.url },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog', site.url).toString() },
    { '@type': 'ListItem', position: 3, name: p.title, item: url },
  ] },
];
---
<Base title={`${p.title} | Fackt`} description={p.description} image={og} type="article" schema={schema} noindex={p.draft} lcp={p.cover}>
  <div class="m-page">
    {p.draft && <div class="draft">Draft preview. Only people with this link can see it; switch off "Draft" in the CMS to publish.</div>}
    <Nav />
    <main>
      <header class="ah">
        <span class="crumb"><a href="/">Fackt</a> <span>/</span> <a href="/blog">Blog</a> <span>/</span> <b>{p.category}</b></span>
        <h1>{p.title}</h1>
        <p class="lede">{p.description}</p>
        <div class="by"><span class="av"><Mark size={16} color="#fff" /></span><div><b>Dom</b> <span>&#183; Founder, Fackt &#183; {dateLabel} &#183; {time} read</span></div></div>
      </header>
      <div class="hcv"><img src={p.cover} alt="" width="1600" height="900" loading="eager" fetchpriority="high" decoding="async" /></div>

      <div class="ar">
        {toc.length > 1 && <aside class="toc" aria-label="On this page"><b>On this page</b>{toc.map((h) => <a href={`#${h.slug}`} data-toc={h.slug}>{h.text}</a>)}</aside>}
        <article class="bd">
          <Content />
          {work && (
            <a class="rel" href={`/work/${work.id}`}>
              <img src={work.data.preview ?? work.data.image} alt="" loading="lazy" />
              <span><small>Case study</small><b>{work.data.name}: {work.data.service}</b><em>{work.data.summary}</em></span>
            </a>
          )}
          <aside class="note" aria-label="Next steps">
            <div class="nh"><span class="na"><Mark size={16} color="#fff" /></span><div><b>A note from Dom</b><span>Founder, Fackt</span></div></div>
            <p class="nt">If any of this sounded <i>a little too familiar</i>, two easy next steps:</p>
            <div class="nc">
              <a class="o pri" href="/audit" data-journey={`Blog note: free audit (${entry.id})`}><span class="k"><i>01</i><em aria-hidden="true">&#8599;</em></span><b>Get a free audit</b><span>Send your product. A video and a written audit within 2 days.</span></a>
              <a class="o" href={site.bookPage} data-journey={`Blog note: book a call (${entry.id})`}><span class="k"><i>02</i><em aria-hidden="true">&#8599;</em></span><b>Book a 30 minute call</b><span>Talk it through with me, with clear next steps either way.</span></a>
            </div>
            <span class="ns" aria-hidden="true">Dom</span>
          </aside>
        </article>
      </div>

      {more.length > 0 && (
        <section class="more" aria-label="Keep reading">
          <span class="eb">Keep reading</span>
          <div class="grid">{more.map((x) => <PostCard slug={x.id} title={x.data.title} category={x.data.category} cover={x.data.cover} time={readTime(x.body, x.data.readTime)} />)}</div>
        </section>
      )}
    </main>
    <Footer />
  </div>
</Base>

<style>
  .draft { position: sticky; top: 0; z-index: 60; background: #2335ff; color: #fff; font-size: 13px; text-align: center; padding: 8px 16px; }
  .ah { width: min(720px, 100% - 32px); margin: 0 auto; padding-top: 56px; }
  .crumb { font-size: 12.5px; color: #767672; display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
  .crumb a { color: inherit; text-decoration: none; }
  .crumb b { color: #111; font-weight: 500; }
  h1 { margin: 16px 0 0; font-family: var(--m-serif); font-weight: 400; font-size: 48px; line-height: 1.08; letter-spacing: -.02em; }
  .lede { margin: 16px 0 0; font-size: 18px; line-height: 1.55; color: #6a6a66; }
  .by { display: flex; gap: 12px; align-items: center; margin-top: 26px; font-size: 13.5px; }
  .by .av { width: 40px; height: 40px; border-radius: 3px; background: #111; display: grid; place-items: center; flex-shrink: 0; }
  .by b { font-weight: 500; }
  .by span { color: #767672; }
  .hcv { width: min(960px, 100% - 32px); margin: 36px auto 0; border-radius: 4px; overflow: hidden; box-shadow: inset 0 0 0 1px #e2e2de; }
  .hcv img { display: block; width: 100%; height: auto; }
  .ar { width: min(960px, 100% - 32px); margin: 44px auto 72px; display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: 40px; }
  .ar:not(:has(.toc)) { grid-template-columns: minmax(0, 1fr); max-width: 720px; }
  .toc { position: sticky; top: 96px; align-self: start; font-size: 13px; }
  .toc b { display: block; font-weight: 500; margin-bottom: 10px; }
  .toc a { display: block; padding: 6px 0 6px 12px; color: #6a6a66; text-decoration: none; border-left: 1.5px solid #ececea; }
  .toc a.on { color: #111; border-left-color: #111; font-weight: 500; }
  .bd { max-width: 680px; font-size: 17px; line-height: 1.7; color: #2b2b29; }
  .bd :global(h2) { margin: 40px 0 10px; font-family: var(--m-serif); font-weight: 400; font-size: 28px; line-height: 1.2; color: #111; scroll-margin-top: 96px; }
  .bd :global(h2:first-child) { margin-top: 0; }
  .bd :global(h3) { margin: 28px 0 8px; font-size: 18px; font-weight: 500; color: #111; }
  .bd :global(p) { margin: 0 0 16px; }
  .bd :global(ul), .bd :global(ol) { margin: 0 0 18px; padding-left: 22px; }
  .bd :global(li) { margin: 6px 0; }
  .bd :global(a) { color: #111; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  .bd :global(strong) { font-weight: 500; color: #111; }
  .bd :global(blockquote) { margin: 24px 0; padding: 4px 0 4px 20px; border-left: 2px solid #111; font-family: var(--m-serif); font-style: italic; font-size: 21px; line-height: 1.4; color: #111; }
  .bd :global(table) { width: 100%; border-collapse: collapse; margin: 8px 0 22px; font-size: 14.5px; }
  .bd :global(th) { text-align: left; font-weight: 500; padding: 10px 12px; border-bottom: 1.5px solid #111; }
  .bd :global(td) { padding: 12px; border-bottom: 1px solid #ececea; vertical-align: top; }
  .bd :global(img) { max-width: 100%; border-radius: 4px; }
  .rel { display: grid; grid-template-columns: 140px 1fr; gap: 18px; align-items: center; margin: 32px 0; padding: 14px; border-radius: 4px; box-shadow: inset 0 0 0 1px #dcdcd8; color: inherit; text-decoration: none; }
  .rel:hover { box-shadow: inset 0 0 0 1px #111; }
  .rel img { width: 140px; height: 88px; object-fit: cover; border-radius: 3px; }
  .rel small { display: block; color: #767672; font-size: 12px; }
  .rel b { display: block; font-weight: 500; font-size: 15px; margin-top: 2px; }
  .rel em { display: block; font-style: normal; color: #6a6a66; font-size: 13.5px; line-height: 1.5; margin-top: 4px; }
  .note { margin: 40px 0 0; padding-top: 28px; border-top: 1.5px solid #111; }
  .nh { display: flex; align-items: center; gap: 12px; }
  .na { width: 40px; height: 40px; border-radius: 3px; background: #111; display: grid; place-items: center; flex: none; }
  .nh b { display: block; font-weight: 500; font-size: 14.5px; color: #111; line-height: 1.3; }
  .nh div span { display: block; font-size: 13px; color: #767672; line-height: 1.4; }
  .note .nt { margin: 18px 0 0; font-family: var(--m-serif); font-size: 30px; line-height: 1.15; letter-spacing: -.01em; color: #111; }
  .nc { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 20px; }
  .note .o { display: block; padding: 18px 18px 16px; border-radius: 4px; box-shadow: inset 0 0 0 1px #dcdcd8; color: #111; text-decoration: none; transition: box-shadow .2s, transform .2s; }
  .o .k { display: flex; justify-content: space-between; align-items: center; }
  .o .k i { font: 500 11px 'Geist Mono', ui-monospace, monospace; font-style: normal; color: #8a8a86; }
  .o .k em { font-style: normal; font-size: 16px; color: #8a8a86; transition: transform .2s, color .2s; }
  .o b { display: block; margin-top: 14px; font-weight: 500; font-size: 16px; }
  .o > span:last-child { display: block; margin-top: 4px; font-size: 14px; line-height: 1.5; color: #6a6a66; }
  .note .o.pri { background: #111; color: #fff; box-shadow: 3px 3px 0 #c8c8c4; }
  .o.pri > span:last-child { color: #b2b2ae; }
  .note .o:not(.pri):hover { box-shadow: inset 0 0 0 1px #111, 3px 3px 0 #111; transform: translate(-1px, -1px); }
  .note .o.pri:hover { box-shadow: 4px 4px 0 #8a8a86; transform: translate(-1px, -1px); }
  .o:hover .k em { transform: translate(3px, -3px); color: currentColor; }
  .ns { display: block; margin-top: 18px; font-family: var(--m-serif); font-style: italic; font-size: 22px; color: #111; }
  .more { width: min(960px, 100% - 32px); margin: 0 auto 72px; padding-top: 40px; border-top: 1px solid #ececea; }
  .eb { font-size: 12.5px; color: #767672; }
  .more .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 20px; }
  @media (max-width: 720px) {
    .ah { padding-top: 28px; }
    h1 { font-size: 32px; }
    .lede { font-size: 16px; }
    .hcv { margin-top: 24px; }
    .ar { grid-template-columns: minmax(0, 1fr); gap: 20px; margin-top: 28px; }
    .toc { display: none; }
    .bd { font-size: 16px; }
    .bd :global(h2) { font-size: 24px; }
    .rel { grid-template-columns: 96px 1fr; } .rel img { width: 96px; height: 64px; } .rel em { display: none; }
    .more .grid { grid-template-columns: 1fr; gap: 28px; }
    .nc { grid-template-columns: 1fr; }
    .note .nt { font-size: 26px; }
  }
</style>

<script>
  // Mark the section you are reading in the "On this page" list.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc]'));
  if (links.length) {
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      if (e.isIntersecting) links.forEach((a) => a.classList.toggle('on', a.dataset.toc === e.target.id));
    }), { rootMargin: '0px 0px -70% 0px' });
    links.forEach((a) => { const h = document.getElementById(a.dataset.toc!); if (h) io.observe(h); });
  }
</script>
