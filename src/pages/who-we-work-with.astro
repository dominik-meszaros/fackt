---
// Who we work with. Three parts, each its own layout:
// 1. Match (A/B test of two heroes, see below): a sentence the visitor completes ("We are ... working on ...") with a live result card.
// 2. Teams: four hanging tags on a rail, each with a stamp for how work usually starts.
// 3. Industries: a typographic index; hovering a row shows its work (desktop), thumbnails inline on phones.
// Data: src/data/audience.ts. Stage images: src/data/stage.ts.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SketchDefs from '../components/home/SketchDefs.astro';
import SvcCta from '../components/pages/services/SvcCta.astro';
import { teams, industries } from '../data/audience';
import { stageCategories } from '../data/stage';
import { site } from '../data/site';

const all = await getCollection('work');
const stageImg = new Map(stageCategories.flatMap((c) => c.slides.map((s) => [s.slug, s.image] as [string, string])));
const work = Object.fromEntries(all.map((e) => [e.id, { slug: e.id, name: e.data.name, service: e.data.service, img: stageImg.get(e.id) ?? e.data.preview ?? e.data.image }]));
const inds = industries.map((i) => ({ ...i, items: i.work.map((s) => work[s]).filter(Boolean) }));
const t0 = teams[0];
const first = work[t0.pick];
const data = { teams: teams.map(({ id, pick, start, does }) => ({ id, pick, start, does: does.slice(0, 3) })), industries: industries.map(({ id, work: w, mobile }) => ({ id, work: w, mobile })), work };
const CK = '<svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5L10 17.5L19 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>';
const pad = (n: number) => String(n).padStart(2, '0');
---
<Base
  title="Who we work with: SaaS founders, teams and agencies | Fackt"
  description="Fackt works with early-stage SaaS founders, funded SaaS teams, mobile app startups and agencies, across creator tools, AI, infrastructure, fintech and education."
  schema={[{ '@context': 'https://schema.org', '@type': 'Service', name: 'Product design for SaaS and tech teams', provider: { '@type': 'Organization', name: 'Fackt', url: 'https://fackt.io' },
    audience: teams.map((t) => ({ '@type': 'BusinessAudience', name: t.title })), areaServed: 'Worldwide',
    serviceType: 'SaaS product design, web design, branding', description: 'Design for early-stage SaaS founders, funded SaaS teams, mobile app startups and agencies.' }]}
>
  <div class="m-page">
    <SketchDefs />
    <Nav />
    <main>
      <!-- 1. Match: A/B test. A2 = sentence + wide result card. A4 = the answer written back as a sentence.
           Each visitor gets one at random (kept in localStorage "fackt_ab_who"); ?v=a2 or ?v=a4 forces one for checking (not counted). -->
      <div class="ab-a2" data-ab="a2" hidden>
      <!-- 1. Match (A2: sentence on top, wide result below) -->
      <section class="wrap match2">
        <nav class="crumb" aria-label="Breadcrumb"><a href="/">Fackt</a><span>/</span><b aria-current="page">Who we work with</b></nav>
        <h1>Who we work with</h1>
        <p class="you"><b>You</b> Tell us about your team</p>
          <p class="sent">
            <span>You&#8217;re</span>
            <label class="pick"><span class="sr-only">Your team</span>
              <select data-team>{teams.map((t) => <option value={t.id}>{t.short}</option>)}</select>
              <i aria-hidden="true"></i>
            </label>
            <span>building</span>
            <label class="pick"><span class="sr-only">Your industry</span>
              <select data-ind>
                <option value="">a SaaS product</option>
                {industries.map((i) => <option value={i.id}>{i.short}</option>)}
              </select>
              <i aria-hidden="true"></i>
            </label>
          </p>
        <p class="hint">Pick the words that fit you. We&#8217;ll answer with the closest project we&#8217;ve shipped and how we&#8217;d start with you.</p>
        <div class="res" data-m-card>
          <a class="big" href={`/work/${first.slug}`} data-m-link>
            <img src={first.img} alt="" data-m-img width="2240" height="1120" decoding="async" />
            <span class="cap"><span class="lb">Our closest project</span><b data-m-name>{first.name}</b><span data-m-svc>{first.service}</span><i aria-hidden="true">&#8594;</i></span>
          </a>
          <div class="info">
            <span class="lb">How we&#8217;d start with you</span>
            <span class="stamp" data-m-start>{t0.start}</span>
            <span class="lb gap">What we&#8217;d do first</span>
            <ul data-m-does>{t0.does.slice(0, 3).map((d) => <li><Fragment set:html={CK} />{d}</li>)}</ul>
            <div class="cb"><a class="m-btn dk" href="/audit">Get a free audit</a><a class="m-btn lt" href={site.bookPage}>Book a call</a></div>
          </div>
        </div>
      </section>

      </div>
      <div class="ab-a4" data-ab="a4" hidden>
      <!-- 1. Match (A4: the answer is written back as a sentence) -->
      <section class="wrap match4">
        <nav class="crumb" aria-label="Breadcrumb"><a href="/">Fackt</a><span>/</span><b aria-current="page">Who we work with</b></nav>
        <p class="h1x">Who we work with</p>
        <p class="you"><b>You</b> Tell us about your team</p>
          <p class="sent">
            <span>You&#8217;re</span>
            <label class="pick"><span class="sr-only">Your team</span>
              <select data-team>{teams.map((t) => <option value={t.id}>{t.short}</option>)}</select>
              <i aria-hidden="true"></i>
            </label>
            <span>building</span>
            <label class="pick"><span class="sr-only">Your industry</span>
              <select data-ind>
                <option value="">a SaaS product</option>
                {industries.map((i) => <option value={i.id}>{i.short}</option>)}
              </select>
              <i aria-hidden="true"></i>
            </label>
          </p>
        <div class="ans" data-m-card>
          <span class="who"><b>Fackt</b> replies</span>
          <p class="reply">Then we&#8217;d usually start with <span class="stamp" data-m-start-lc>a {t0.start.toLowerCase()}</span>, beginning with <u data-m-does-first>{/^[A-Z][a-z]/.test(t0.does[0]) ? t0.does[0].charAt(0).toLowerCase() + t0.does[0].slice(1) : t0.does[0]}</u>. The closest thing we&#8217;ve shipped is
            <span class="nw"><a class="pill" href={`/work/${first.slug}`} data-m-link><img src={first.img} alt="" data-m-img width="2240" height="1120" decoding="async" /><b data-m-name>{first.name}</b>&#8594;</a>.</span></p>
          <div class="cb"><a class="m-btn dk" href="/audit">Get a free audit</a><a class="m-btn lt" href={site.bookPage}>Book a call</a></div>
        </div>
        <p class="hint">Change the underlined words and our answer rewrites itself.</p>
      </section>

      </div>
      <script is:inline>(function(){var k="fackt_ab_who",q=new URLSearchParams(location.search).get("v"),v=null,f=false;if(q==="a2"||q==="a4"){v=q;f=true}else{try{v=localStorage.getItem(k)}catch(e){}if(v!=="a2"&&v!=="a4"){v=Math.random()<.5?"a2":"a4";try{localStorage.setItem(k,v)}catch(e){}}}window.__abWho={v:v,forced:f};var el=document.querySelector('[data-ab="'+v+'"]');if(el)el.hidden=false;})();</script>
      <!-- 2. Teams -->
      <section class="wrap tags-sec">
        <div class="sh"><span class="eb">The teams</span><h2>Four kinds of teams, one studio.</h2></div>
        <div class="rail" aria-hidden="true"></div>
        <div class="tags">
          {teams.map((t, i) => (
            <article class="tag" id={t.id} style={`--r:${[-0.9, 0.7, -0.5, 0.9][i]}deg`}>
              <span class="hole" aria-hidden="true"></span>
              <span class="no">{pad(i + 1)}</span>
              <h3>{t.title}</h3>
              <p>{t.text}</p>
              <ul>{t.does.map((d) => <li><Fragment set:html={CK} />{d}</li>)}</ul>
              <div class="ts"><span class="lb">Starts with</span><span class="stamp sm">{t.start}</span></div>
            </article>
          ))}
        </div>
      </section>

      <!-- 3. Industries -->
      <section class="wrap idx-sec" id="industries">
        <div class="sh"><span class="eb">Industries</span><h2>Where we have shipped.</h2></div>
        <ol class="idx" data-idx>
          {inds.map((g, i) => (
            <li class="ir" id={g.id} data-img={g.items[0]?.img}>
              <span class="in">{pad(i + 1)}</span>
              <h3>{g.title}</h3>
              <span class="iw">{g.items.map((p, j) => <>{j > 0 && <span class="sep">/</span>}<a href={`/work/${p.slug}`} data-img={p.img}>{p.name}</a></>)}</span>
              <span class="ic">{g.items.length} {g.items.length === 1 ? 'project' : 'projects'}</span>
              <span class="thumbs">{g.items.map((p) => <a href={`/work/${p.slug}`}><img src={p.img} alt={`${p.name}, ${p.service.toLowerCase()} by Fackt`} loading="lazy" decoding="async" /></a>)}</span>
            </li>
          ))}
        </ol>
        <p class="note">Not on the list? What makes a product clear carries across industries. Tell us about yours on a free call.</p>
        <div class="peek" aria-hidden="true" data-peek><img alt="" data-peek-img /></div>
      </section>

      <SvcCta title="Not sure where you fit?" text="Book a free 30 minute call with Dom, or get a free audit of your product and see how we think first." />
    </main>
    <Footer />
  </div>
  <script type="application/json" id="who-data" set:html={JSON.stringify(data)} />
</Base>

<script>
  type W = { slug: string; name: string; service: string; img: string };
  const el = document.getElementById('who-data');
  if (el) {
    const d = JSON.parse(el.textContent || '{}') as { teams: { id: string; pick: string; start: string; does: string[] }[]; industries: { id: string; work: string[]; mobile?: string }[]; work: Record<string, W> };
    const ab = (window as any).__abWho as { v: string; forced: boolean } | undefined;
    const root: ParentNode = document.querySelector('[data-ab]:not([hidden])') ?? document;
    const q = <T extends Element>(s: string) => root.querySelector<T>(s);
    const dq = <T extends Element>(s: string) => document.querySelector<T>(s);
    const team = q<HTMLSelectElement>('[data-team]'), ind = q<HTMLSelectElement>('[data-ind]');
    const card = q<HTMLElement>('[data-m-card]');
    const CK = '<svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5L10 17.5L19 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>';
    // lower-case the first letter unless it starts an acronym (MVP, UX, iOS stays as is)
    const lc = (x: string) => (/^[A-Z][a-z]/.test(x) ? x.charAt(0).toLowerCase() + x.slice(1) : x);
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    const update = () => {
      const t = d.teams.find((x) => x.id === team!.value)!;
      const i = d.industries.find((x) => x.id === ind!.value);
      const slug = i ? (t.id === 'mobile' && i.mobile ? i.mobile : i.work[0]) : t.pick;
      const w = d.work[slug];
      if (!w) return;
      if (card) { card.classList.remove('flip'); void card.offsetWidth; card.classList.add('flip'); }
      const all = <T extends Element>(sel: string) => root.querySelectorAll<T>(sel);
      all<HTMLImageElement>('[data-m-img]').forEach((im) => { im.removeAttribute('srcset'); im.src = w.img; });
      all<HTMLAnchorElement>('[data-m-link], [data-m-link2]').forEach((a) => { a.href = `/work/${w.slug}`; });
      all('[data-m-name]').forEach((n) => { n.textContent = w.name; });
      all('[data-m-svc]').forEach((n) => { n.textContent = w.service; });
      all('[data-m-start]').forEach((n) => { n.textContent = t.start; });
      all('[data-m-start-lc]').forEach((n) => { n.textContent = `a ${t.start.toLowerCase()}`; });
      all('[data-m-does]').forEach((n) => { n.innerHTML = t.does.map((x) => `<li>${CK}${esc(x)}</li>`).join(''); });
      all('[data-m-does-first]').forEach((n) => { n.textContent = lc(t.does[0]); });
      all('[data-m-does-text]').forEach((n) => { const l = t.does.map((x) => `<u>${esc(x.charAt(0).toLowerCase() + x.slice(1))}</u>`); n.innerHTML = `${l.slice(0, -1).join(', ')} and ${l.at(-1)}`; });
    };
    // Preselect from the hash: /who-we-work-with#mobile or #ai
    const h = location.hash.slice(1);
    if (d.teams.some((t) => t.id === h)) team!.value = h;
    if (d.industries.some((i) => i.id === h)) ind!.value = h;
    // Size each select to its chosen words (field-sizing is not in every browser yet)
    const meas = document.createElement('span');
    meas.style.cssText = 'position:absolute;visibility:hidden;white-space:pre;left:-9999px';
    document.body.appendChild(meas);
    const fit = (sel: HTMLSelectElement | null) => {
      if (!sel) return;
      const cs = getComputedStyle(sel);
      meas.style.font = cs.font; meas.style.letterSpacing = cs.letterSpacing;
      meas.textContent = sel.options[sel.selectedIndex]?.text || '';
      const max = sel.closest('.sent')?.clientWidth ?? 9999;
      sel.style.width = `${Math.min(max, Math.ceil(meas.getBoundingClientRect().width) + parseFloat(cs.paddingRight) + 2)}px`;
    };
    const fitAll = () => { fit(team); fit(ind); };
    // A/B tracking: events land in the visit's "Also" list as "AB who:<variant> ..." and are counted on /admin/stats
    const tag = ab && !ab.forced ? `AB who:${ab.v}` : '';
    let changed = false;
    const track = (label: string) => {
      if (!tag) return;
      const go = () => (window as any).facktJourney?.track(`${tag} ${label}`);
      if ((window as any).facktJourney) go(); else addEventListener('load', go, { once: true });
    };
    track('shown');
    const onChange = () => { if (!changed) { changed = true; track('changed answer'); } };
    if (tag && root instanceof HTMLElement) {
      root.querySelectorAll<HTMLAnchorElement>('[data-m-link], [data-m-link2]').forEach((a) => a.setAttribute('data-journey', `${tag} opened case study`));
      root.querySelectorAll<HTMLAnchorElement>('a[href="/audit"]').forEach((a) => a.setAttribute('data-journey', `${tag} clicked audit`));
      root.querySelectorAll<HTMLAnchorElement>('a[href="/book"]').forEach((a) => a.setAttribute('data-journey', `${tag} clicked call`));
    }
    team?.addEventListener('change', () => { fit(team); update(); onChange(); });
    ind?.addEventListener('change', () => { fit(ind); update(); onChange(); });
    if (h) update();
    fitAll();
    document.fonts?.ready.then(fitAll);
    addEventListener('resize', fitAll);

    // Industry index: a preview that follows the pointer (mouse only)
    const peek = dq<HTMLElement>('[data-peek]'), pimg = dq<HTMLImageElement>('[data-peek-img]');
    const idx = dq<HTMLElement>('[data-idx]');
    if (peek && pimg && idx && matchMedia('(hover: hover) and (min-width: 861px)').matches) {
      idx.addEventListener('pointermove', (e) => {
        const a = (e.target as HTMLElement).closest<HTMLElement>('[data-img]');
        if (!a) { peek.classList.remove('on'); return; }
        const src = a.dataset.img!;
        if (pimg.getAttribute('src') !== src) pimg.src = src;
        peek.style.transform = `translate(${e.clientX + 40}px, ${e.clientY - 170}px)`;
        peek.classList.add('on');
      });
      idx.addEventListener('pointerleave', () => peek.classList.remove('on'));
    }
  }
</script>

<style>
  .wrap { width: min(1040px, 100% - 32px); margin: 0 auto; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .crumb { font-size: 12.5px; color: #8a8a86; display: flex; gap: 8px; align-items: center; }
  .crumb a { color: inherit; text-decoration: none; }
  .crumb b { color: #111; font-weight: 500; }
  .eb { display: block; font-size: 11px; font-weight: 500; letter-spacing: .06em; text-transform: uppercase; color: #8a8a86; }
  .lb { display: block; font-size: 11px; font-weight: 500; letter-spacing: .04em; text-transform: uppercase; color: #8a8a86; margin-bottom: 8px; }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; font-size: 13.5px; }
  ul :global(li) { display: flex; gap: 8px; align-items: center; }
  ul :global(li svg) { flex-shrink: 0; }
  .stamp { display: inline-block; padding: 6px 10px; border: 1.5px solid #111; border-radius: 3px; font: 600 12px Geist, system-ui, sans-serif; letter-spacing: .06em; text-transform: uppercase; transform: rotate(-2deg); box-shadow: inset 0 0 0 2px #fff, inset 0 0 0 3px #111; }
  .stamp.sm { font-size: 10.5px; padding: 5px 9px; }

  /* 1. Match: both test variants, each scoped to its wrapper */
  
  .ab-a2 h1 { margin: 14px 0 0; font-family: var(--m-serif); font-weight: 400; font-size: 20px; line-height: 1.2; color: #6a6a66; }
  .ab-a2 .sent { margin: 8px 0 0; font-family: var(--m-serif); font-size: 46px; line-height: 1.22; letter-spacing: -.02em; }
  .ab-a2 .sent > span { color: #9a9a96; }
  .ab-a2 .pick { position: relative; display: inline-flex; align-items: baseline; }
  .ab-a2 .pick select { appearance: none; -webkit-appearance: none; border: 0; background: none; font: inherit; color: #111; letter-spacing: inherit; padding: 0 30px 0 0; margin: 0 6px 0 0; cursor: pointer; border-bottom: 2px solid #111; border-radius: 0; max-width: 100%; }
  .ab-a2 .pick select:focus-visible { outline: 2px solid #111; outline-offset: 4px; }
  .ab-a2 .pick i { position: absolute; right: 12px; top: 55%; width: 10px; height: 10px; border-right: 2px solid #111; border-bottom: 2px solid #111; transform: translateY(-75%) rotate(45deg); pointer-events: none; }
  .ab-a2 .hint { margin: 16px 0 0; font-size: 14px; color: #6a6a66; max-width: 480px; }
  .ab-a2 .flip { animation: flip .45s var(--m-ease); }
  @keyframes flip { from { opacity: .4; transform: translateY(6px); } }
  .ab-a2 .match2 { padding: 56px 0 72px; }
  .ab-a2 .res { display: grid; grid-template-columns: minmax(0, 1fr) 300px; margin-top: 36px; border-radius: 4px; box-shadow: 0 0 0 1px #111, 6px 6px 0 #111; overflow: hidden; background: #fff; }
  .ab-a2 .big { position: relative; display: block; aspect-ratio: 2 / 1; overflow: hidden; background: #f2f2f0; }
  .ab-a2 .big img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .6s var(--m-ease); }
  .ab-a2 .big:hover img { transform: scale(1.03); }
  .ab-a2 .cap { position: absolute; left: 16px; bottom: 16px; display: flex; align-items: baseline; gap: 8px; padding: 8px 12px; background: #fff; border-radius: 2px; color: #111; box-shadow: inset 0 0 0 1px #dcdcd8; font-size: 13px; }
  .ab-a2 .cap .lb { margin: 0 4px 0 0; }
  .ab-a2 .cap b { font-weight: 500; font-size: 14px; }
  .ab-a2 .cap span:not(.lb) { color: #8a8a86; }
  .ab-a2 .info { padding: 22px; border-left: 1px solid #111; display: flex; flex-direction: column; }
  .ab-a2 .info .gap { margin-top: 22px; }
  .ab-a2 .info .stamp { align-self: flex-start; }
  .ab-a2 .cb { display: grid; gap: 8px; margin-top: auto; padding-top: 20px; }
  .ab-a2 .cb .m-btn { justify-content: center; height: 40px; }
  @media (max-width: 860px) { .ab-a2 .res { grid-template-columns: 1fr; } .ab-a2 .info { border-left: 0; border-top: 1px solid #111; } }
  @media (max-width: 720px) { .ab-a2 .match2 { padding: 28px 0 48px; } .ab-a2 .sent { font-size: 27px; line-height: 1.4; } .ab-a2 .pick select { padding-right: 24px; } .ab-a2 .pick i { right: 9px; width: 8px; height: 8px; } .ab-a2 .big { aspect-ratio: 4 / 3; } .ab-a2 .cap .lb { display: none; } }

  .ab-a2 .you { display: flex; align-items: center; gap: 8px; margin: 22px 0 0; font-size: 13px; color: #6a6a66; }
  .ab-a2 .you b { display: inline-grid; place-items: center; height: 22px; padding: 0 8px; border-radius: 11px; background: #111; color: #fff; font-size: 11.5px; font-weight: 500; }

  
  .ab-a4 h1, .ab-a4 .h1x { margin: 14px 0 0; font-family: var(--m-serif); font-weight: 400; font-size: 20px; line-height: 1.2; color: #6a6a66; }
  .ab-a4 .sent { margin: 8px 0 0; font-family: var(--m-serif); font-size: 46px; line-height: 1.22; letter-spacing: -.02em; }
  .ab-a4 .sent > span { color: #9a9a96; }
  .ab-a4 .pick { position: relative; display: inline-flex; align-items: baseline; }
  .ab-a4 .pick select { appearance: none; -webkit-appearance: none; border: 0; background: none; font: inherit; color: #111; letter-spacing: inherit; padding: 0 30px 0 0; margin: 0 6px 0 0; cursor: pointer; border-bottom: 2px solid #111; border-radius: 0; max-width: 100%; }
  .ab-a4 .pick select:focus-visible { outline: 2px solid #111; outline-offset: 4px; }
  .ab-a4 .pick i { position: absolute; right: 12px; top: 55%; width: 10px; height: 10px; border-right: 2px solid #111; border-bottom: 2px solid #111; transform: translateY(-75%) rotate(45deg); pointer-events: none; }
  .ab-a4 .hint { margin: 16px 0 0; font-size: 14px; color: #6a6a66; max-width: 480px; }
  .ab-a4 .flip { animation: flip .45s var(--m-ease); }
  @keyframes flip { from { opacity: .4; transform: translateY(6px); } }
  .ab-a4 .match4 { padding: 56px 0 72px; }
  .ab-a4 .match4 > * { max-width: 900px; }
  .ab-a4 .ans { position: relative; margin-top: 48px; padding: 28px 30px 26px 30px; background: #fafaf8; border-radius: 4px 18px 18px 18px; box-shadow: 0 0 0 1px #111, 5px 5px 0 #111; }
  .ab-a4 .who { position: absolute; left: 0; top: -30px; display: flex; align-items: center; gap: 8px; font: 500 13px Geist, system-ui, sans-serif; color: #6a6a66; }
  .ab-a4 .who b { display: inline-grid; place-items: center; height: 22px; padding: 0 8px; border-radius: 11px; background: #fff; color: #111; box-shadow: inset 0 0 0 1.5px #111; font-size: 11.5px; font-weight: 500; }
