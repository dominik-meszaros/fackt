---
// Who we work with. Three parts, each its own layout:
// 1. Match: a sentence the visitor completes ("We are ... working on ...") with a live result card.
// 2. Teams: four hanging tags on a rail, each with a stamp for how work usually starts.
// 3. Industries: a typographic index; hovering a row shows its work (desktop), thumbnails inline on phones.
// Data: src/data/audience.ts. Stage images: src/data/stage.ts.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SketchDefs from '../components/home/SketchDefs.astro';
import SvcCta from '../components/pages/services/SvcCta.astro';
import { teams, industries } from '../data/audience';
import { stageCategories } from '../data/stage';
import { site } from '../data/site';

const all = await getCollection('work');
const stageImg = new Map(stageCategories.flatMap((c) => c.slides.map((s) => [s.slug, s.image] as [string, string])));
const work = Object.fromEntries(all.map((e) => [e.id, { slug: e.id, name: e.data.name, service: e.data.service, img: stageImg.get(e.id) ?? e.data.preview ?? e.data.image }]));
const inds = industries.map((i) => ({ ...i, items: i.work.map((s) => work[s]).filter(Boolean) }));
const t0 = teams[0];
const first = work[t0.pick];
const data = { teams: teams.map(({ id, pick, start, does }) => ({ id, pick, start, does: does.slice(0, 3) })), industries: industries.map(({ id, work: w, mobile }) => ({ id, work: w, mobile })), work };
const CK = '<svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5L10 17.5L19 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>';
const pad = (n: number) => String(n).padStart(2, '0');
---
<Base
  title="Who we work with: SaaS founders, product teams, mobile apps and agencies | Fackt"
  description="Fackt works with early-stage SaaS founders, funded SaaS teams, mobile app startups and agencies, across creator tools, AI, infrastructure, fintech and education."
>
  <div class="m-page">
    <SketchDefs />
    <Nav />
    <main>
      <!-- 1. Match -->
      <section class="wrap match" data-match>
        <div class="ml">
          <nav class="crumb" aria-label="Breadcrumb"><a href="/">Fackt</a><span>/</span><b aria-current="page">Who we work with</b></nav>
          <h1>Who we work with</h1>
          <p class="sent">
            <span>We are</span>
            <label class="pick"><span class="sr-only">Your team</span>
              <select data-team>{teams.map((t) => <option value={t.id}>{t.short}</option>)}</select>
              <i aria-hidden="true"></i>
            </label>
            <span>working on</span>
            <label class="pick"><span class="sr-only">Your industry</span>
              <select data-ind>
                <option value="">anything in SaaS</option>
                {industries.map((i) => <option value={i.id}>{i.short}</option>)}
              </select>
              <i aria-hidden="true"></i>
            </label>
          </p>
          <p class="hint">Change the underlined words. The card shows the work closest to yours and how we would start.</p>
        </div>

        <aside class="card" aria-live="polite">
          <span class="eb">Your closest match</span>
          <a class="shot" href={`/work/${first.slug}`} data-m-link>
            <img src={first.img} alt="" data-m-img width="2240" height="1120" decoding="async" />
          </a>
          <a class="cw" href={`/work/${first.slug}`} data-m-link2><b data-m-name>{first.name}</b><span data-m-svc>{first.service}</span><i aria-hidden="true">&#8594;</i></a>
          <div class="cg">
            <div>
              <span class="lb">How we would start</span>
              <span class="stamp" data-m-start>{t0.start}</span>
            </div>
            <div>
              <span class="lb">First things we do</span>
              <ul data-m-does>{t0.does.slice(0, 3).map((d) => <li><Fragment set:html={CK} />{d}</li>)}</ul>
            </div>
          </div>
          <div class="cb">
            <a class="m-btn dk" href="/audit">Get a free audit</a>
            <a class="m-btn lt" href={site.bookPage}>Book a call</a>
          </div>
        </aside>
      </section>

      <!-- 2. Teams -->
      <section class="wrap tags-sec">
        <div class="sh"><span class="eb">The teams</span><h2>Four kinds of teams, one studio.</h2></div>
        <div class="rail" aria-hidden="true"></div>
        <div class="tags">
          {teams.map((t, i) => (
            <article class="tag" id={t.id} style={`--r:${[-0.9, 0.7, -0.5, 0.9][i]}deg`}>
              <span class="hole" aria-hidden="true"></span>
              <span class="no">{pad(i + 1)}</span>
              <h3>{t.title}</h3>
              <p>{t.text}</p>
              <ul>{t.does.map((d) => <li><Fragment set:html={CK} />{d}</li>)}</ul>
              <div class="ts"><span class="lb">Starts with</span><span class="stamp sm">{t.start}</span></div>
            </article>
          ))}
        </div>
      </section>

      <!-- 3. Industries -->
      <section class="wrap idx-sec" id="industries">
        <div class="sh"><span class="eb">Industries</span><h2>Where we have shipped.</h2></div>
        <ol class="idx" data-idx>
          {inds.map((g, i) => (
            <li class="ir" id={g.id} data-img={g.items[0]?.img}>
              <span class="in">{pad(i + 1)}</span>
              <h3>{g.title}</h3>
              <span class="iw">{g.items.map((p, j) => <>{j > 0 && <span class="sep">/</span>}<a href={`/work/${p.slug}`} data-img={p.img}>{p.name}</a></>)}</span>
              <span class="ic">{g.items.length} {g.items.length === 1 ? 'project' : 'projects'}</span>
              <span class="thumbs">{g.items.map((p) => <a href={`/work/${p.slug}`}><img src={p.img} alt={`${p.name}, ${p.service.toLowerCase()} by Fackt`} loading="lazy" decoding="async" /></a>)}</span>
            </li>
          ))}
        </ol>
        <p class="note">Not on the list? What makes a product clear carries across industries. Tell us about yours on a free call.</p>
        <div class="peek" aria-hidden="true" data-peek><img alt="" data-peek-img /></div>
      </section>

      <SvcCta title="Not sure where you fit?" text="Book a free 30 minute call with Dom, or get a free audit of your product and see how we think first." />
    </main>
    <Footer />
  </div>
  <script type="application/json" id="who-data" set:html={JSON.stringify(data)} />
</Base>

<script>
  type W = { slug: string; name: string; service: string; img: string };
  const el = document.getElementById('who-data');
  if (el) {
    const d = JSON.parse(el.textContent || '{}') as { teams: { id: string; pick: string; start: string; does: string[] }[]; industries: { id: string; work: string[]; mobile?: string }[]; work: Record<string, W> };
    const q = <T extends Element>(s: string) => document.querySelector<T>(s);
    const team = q<HTMLSelectElement>('[data-team]'), ind = q<HTMLSelectElement>('[data-ind]');
    const card = q<HTMLElement>('.match .card');
    const CK = '<svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5L10 17.5L19 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>';
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    const update = () => {
      const t = d.teams.find((x) => x.id === team!.value)!;
      const i = d.industries.find((x) => x.id === ind!.value);
      const slug = i ? (t.id === 'mobile' && i.mobile ? i.mobile : i.work[0]) : t.pick;
      const w = d.work[slug];
      if (!w || !card) return;
      card.classList.remove('flip'); void card.offsetWidth; card.classList.add('flip');
      const im = q<HTMLImageElement>('[data-m-img]')!; im.removeAttribute('srcset'); im.src = w.img;
      q<HTMLAnchorElement>('[data-m-link]')!.href = `/work/${w.slug}`;
      q<HTMLAnchorElement>('[data-m-link2]')!.href = `/work/${w.slug}`;
      q('[data-m-name]')!.textContent = w.name;
      q('[data-m-svc]')!.textContent = w.service;
      q('[data-m-start]')!.textContent = t.start;
      q('[data-m-does]')!.innerHTML = t.does.map((x) => `<li>${CK}${esc(x)}</li>`).join('');
    };
    // Preselect from the hash: /who-we-work-with#mobile or #ai
    const h = location.hash.slice(1);
    if (d.teams.some((t) => t.id === h)) team!.value = h;
    if (d.industries.some((i) => i.id === h)) ind!.value = h;
    // Size each select to its chosen words (field-sizing is not in every browser yet)
    const meas = document.createElement('span');
    meas.style.cssText = 'position:absolute;visibility:hidden;white-space:pre;left:-9999px';
    document.body.appendChild(meas);
    const fit = (sel: HTMLSelectElement | null) => {
      if (!sel) return;
      const cs = getComputedStyle(sel);
      meas.style.font = cs.font; meas.style.letterSpacing = cs.letterSpacing;
      meas.textContent = sel.options[sel.selectedIndex]?.text || '';
      const max = sel.closest('.sent')?.clientWidth ?? 9999;
      sel.style.width = `${Math.min(max, Math.ceil(meas.getBoundingClientRect().width) + parseFloat(cs.paddingRight) + 2)}px`;
    };
    const fitAll = () => { fit(team); fit(ind); };
    team?.addEventListener('change', () => { fit(team); update(); });
    ind?.addEventListener('change', () => { fit(ind); update(); });
    if (h) update();
    fitAll();
    document.fonts?.ready.then(fitAll);
    addEventListener('resize', fitAll);

    // Industry index: a preview that follows the pointer (mouse only)
    const peek = q<HTMLElement>('[data-peek]'), pimg = q<HTMLImageElement>('[data-peek-img]');
    const idx = q<HTMLElement>('[data-idx]');
    if (peek && pimg && idx && matchMedia('(hover: hover) and (min-width: 861px)').matches) {
      idx.addEventListener('pointermove', (e) => {
        const a = (e.target as HTMLElement).closest<HTMLElement>('[data-img]');
        if (!a) { peek.classList.remove('on'); return; }
        const src = a.dataset.img!;
        if (pimg.getAttribute('src') !== src) pimg.src = src;
        peek.style.transform = `translate(${e.clientX + 40}px, ${e.clientY - 170}px)`;
        peek.classList.add('on');
      });
      idx.addEventListener('pointerleave', () => peek.classList.remove('on'));
    }
  }
</script>

<style>
  .wrap { width: min(1040px, 100% - 32px); margin: 0 auto; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .crumb { font-size: 12.5px; color: #8a8a86; display: flex; gap: 8px; align-items: center; }
  .crumb a { color: inherit; text-decoration: none; }
  .crumb b { color: #111; font-weight: 500; }
  .eb { display: block; font-size: 11px; font-weight: 500; letter-spacing: .06em; text-transform: uppercase; color: #8a8a86; }
  .lb { display: block; font-size: 11px; font-weight: 500; letter-spacing: .04em; text-transform: uppercase; color: #8a8a86; margin-bottom: 8px; }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; font-size: 13.5px; }
  ul :global(li) { display: flex; gap: 8px; align-items: center; }
  ul :global(li svg) { flex-shrink: 0; }
  .stamp { display: inline-block; padding: 6px 10px; border: 1.5px solid #111; border-radius: 3px; font: 600 12px Geist, system-ui, sans-serif; letter-spacing: .06em; text-transform: uppercase; transform: rotate(-2deg); box-shadow: inset 0 0 0 2px #fff, inset 0 0 0 3px #111; }
  .stamp.sm { font-size: 10.5px; padding: 5px 9px; }

  /* 1. Match */
  .match { display: grid; grid-template-columns: minmax(0, 1fr) 400px; gap: 56px; align-items: center; padding: 56px 0 72px; }
  h1 { margin: 14px 0 0; font-family: var(--m-serif); font-weight: 400; font-size: 20px; line-height: 1.2; color: #6a6a66; }
  .sent { margin: 18px 0 0; font-family: var(--m-serif); font-size: 46px; line-height: 1.22; letter-spacing: -.02em; }
  .sent > span { color: #9a9a96; }
  .pick { position: relative; display: inline-flex; align-items: baseline; }
  .pick select { appearance: none; -webkit-appearance: none; border: 0; background: none; font: inherit; color: #111; letter-spacing: inherit; padding: 0 30px 0 0; margin: 0 6px 0 0; cursor: pointer; border-bottom: 2px solid #111; border-radius: 0; max-width: 100%; }
  .pick select:focus-visible { outline: 2px solid #111; outline-offset: 4px; }
  .pick i { position: absolute; right: 12px; top: 55%; width: 10px; height: 10px; border-right: 2px solid #111; border-bottom: 2px solid #111; transform: translateY(-75%) rotate(45deg); pointer-events: none; }
  .hint { margin: 22px 0 0; font-size: 14px; color: #6a6a66; max-width: 440px; }
  .card { background: #fff; padding: 18px; border-radius: 4px; box-shadow: 0 0 0 1px #111, 6px 6px 0 #111; }
  .card.flip { animation: flip .45s var(--m-ease); }
  @keyframes flip { from { transform: translateY(6px) rotate(-.6deg); box-shadow: 0 0 0 1px #111, 2px 2px 0 #111; } }
  .card .eb { margin-bottom: 12px; }
  .shot { display: block; aspect-ratio: 2 / 1; border-radius: 3px; overflow: hidden; background: #f2f2f0; box-shadow: inset 0 0 0 1px #e2e2de; }
  .shot img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .5s var(--m-ease); }
  .shot:hover img { transform: scale(1.03); }
  .cw { display: flex; align-items: baseline; gap: 8px; margin-top: 12px; color: #111; text-decoration: none; }
  .cw b { font-weight: 500; font-size: 15px; }
  .cw span { font-size: 13px; color: #8a8a86; flex: 1; }
  .cw i { font-style: normal; transition: transform .2s; }
  .cw:hover b { text-decoration: underline; }
  .cw:hover i { transform: translateX(3px); }
  .cg { display: grid; grid-template-columns: auto 1fr; gap: 20px; margin-top: 16px; padding-top: 16px; border-top: 1px dashed #c8c8c4; }
  .cb { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 18px; }
  .cb .m-btn { justify-content: center; height: 40px; }

  /* 2. Teams: tags hanging from a rail */
  .tags-sec { position: relative; padding: 24px 0 40px; }
  .sh h2 { margin: 8px 0 0; font-family: var(--m-serif); font-weight: 400; font-size: 36px; line-height: 1.12; letter-spacing: -.01em; }
  .rail { height: 2px; margin-top: 36px; background: #111; border-radius: 2px; }
  .tags { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
  .tag { position: relative; display: flex; flex-direction: column; margin-top: 34px; padding: 30px 18px 20px; background: #fafaf8; border-radius: 4px 4px 4px 18px; box-shadow: 0 0 0 1px #111, 3px 3px 0 #111; transform: rotate(var(--r)); transform-origin: 50% -34px; transition: transform .5s var(--m-ease); scroll-margin-top: 110px; }
  .tag::before { content: ''; position: absolute; left: 50%; top: -35px; width: 1.5px; height: 46px; background: #111; }
  .tag:hover, .tag:target { transform: rotate(0deg); }
  .hole { position: absolute; left: 50%; top: 9px; width: 10px; height: 10px; margin-left: -5px; border-radius: 50%; background: #fff; box-shadow: 0 0 0 1.5px #111; }
  .no { display: block; font: 500 12px Geist, system-ui, sans-serif; color: #8a8a86; font-variant-numeric: tabular-nums; }
  .tag h3 { margin: 6px 0 0; font-family: var(--m-serif); font-weight: 400; font-size: 24px; line-height: 1.15; }
  .tag p { margin: 10px 0 0; font-size: 13.5px; line-height: 1.5; color: #6a6a66; }
  .tag ul { margin-top: 14px; padding-top: 14px; border-top: 1px dashed #c8c8c4; font-size: 13px; }
  .ts { margin-top: auto; padding-top: 18px; }
  .ts .lb { margin-bottom: 6px; }

  /* 3. Industries index */
  .idx-sec { padding: 56px 0 8px; }
  .idx { list-style: none; margin: 28px 0 0; padding: 0; border-top: 2px solid #111; }
  .ir { display: grid; grid-template-columns: 56px minmax(0, 1fr) auto 110px; align-items: baseline; gap: 20px; padding: 22px 0; border-bottom: 1px solid #dcdcd8; scroll-margin-top: 110px; transition: background .2s, padding .3s var(--m-ease); }
  .ir:hover { background: #f6f6f4; padding-left: 12px; padding-right: 12px; }
  .in { font: 500 12px Geist, system-ui, sans-serif; color: #8a8a86; font-variant-numeric: tabular-nums; }
  .ir h3 { margin: 0; font-family: var(--m-serif); font-weight: 400; font-size: 34px; line-height: 1.1; letter-spacing: -.01em; }
  .iw { font-size: 14px; display: flex; gap: 8px; flex-wrap: wrap; justify-content: flex-end; }
  .iw a { color: #111; font-weight: 500; text-decoration: none; border-bottom: 1px solid #111; }
  .iw .sep { color: #c8c8c4; }
  .ic { font-size: 12.5px; color: #8a8a86; text-align: right; }
  .thumbs { display: none; }
  .note { margin: 18px 0 0; font-size: 14px; color: #6a6a66; }
  .peek { position: fixed; left: 0; top: 0; z-index: 30; width: 300px; aspect-ratio: 2 / 1; border-radius: 3px; overflow: hidden; background: #f2f2f0; box-shadow: 0 0 0 1px #111, 5px 5px 0 #111; pointer-events: none; opacity: 0; transition: opacity .2s; }
  .peek.on { opacity: 1; }
  .peek img { width: 100%; height: 100%; object-fit: cover; display: block; }

  @media (max-width: 960px) {
    .match { grid-template-columns: minmax(0, 1fr); gap: 36px; }
    .card { max-width: 480px; }
    .tags { grid-template-columns: 1fr 1fr; row-gap: 8px; }
    .rail { display: none; }
    .tag::before { height: 34px; top: -26px; }
  }
  @media (max-width: 860px) {
    .ir { grid-template-columns: 40px 1fr; gap: 6px 12px; }
    .iw, .ic { display: none; }
    .thumbs { grid-column: 2; display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 10px; }
    .thumbs a { display: block; aspect-ratio: 2 / 1; border-radius: 3px; overflow: hidden; background: #f2f2f0; box-shadow: inset 0 0 0 1px #e2e2de; }
    .thumbs img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .ir:hover { padding-left: 0; padding-right: 0; background: none; }
  }
  @media (max-width: 720px) {
    .match { padding: 28px 0 48px; }
    .sent { font-size: 27px; line-height: 1.4; }
    .pick select { padding-right: 24px; }
    .pick i { right: 9px; width: 8px; height: 8px; }
    .tags { grid-template-columns: 1fr; }
    .tag { transform: none; margin-top: 26px; }
    .sh h2 { font-size: 28px; }
    .ir h3 { font-size: 24px; }
    .thumbs { grid-template-columns: 1fr 1fr; }
    .cg { grid-template-columns: 1fr; gap: 14px; }
  }
</style>
