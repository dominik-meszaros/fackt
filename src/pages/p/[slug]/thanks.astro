---
// After payment Polar sends buyers here (set as the success URL on the checkout link).
import Base from '../../../layouts/Base.astro';
import Mark from '../../../components/home/Mark.astro';
import { site } from '../../../data/site';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  return (await getCollection('products')).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const r = entry.data;
---
<Base title={`Thanks for buying ${r.title} | Fackt`} description={`Your ${r.title} file is on its way.`} image={r.cover} noindex>
  <div class="ty">
    <header class="top"><a href="/" class="brand"><Mark size={16} /><b>Fackt</b> <span>files</span></a></header>
    <main class="box">
      <span class="k">Payment received</span>
      <h1>Thanks, {r.title.split(' ')[0]} is on its way.</h1>
      <p>Check your inbox for an email from <b>notes@fackt.io</b>. It arrives within a minute and has a button that opens the Figma file. In Figma, click <b>Duplicate</b> to save your own copy.</p>
      <p>The same link is also on your Polar receipt, so you have it twice.</p>
      <p class="small">Nothing after five minutes? Check spam and Promotions, then email <a href={`mailto:${site.email}`}>{site.email}</a> and I will send it myself.</p>
      <div class="next">
        <span class="k">While you are here</span>
        <p>Want the same thinking applied to your own product? <a href="/audit">Get a free audit</a>, I send back a video walkthrough and a list of what to fix first.</p>
      </div>
    </main>
    <footer class="ft"><span>&copy; {new Date().getFullYear()} Fackt Labs LLC</span><a href="/privacy">Privacy</a></footer>
  </div>
</Base>
<style>
  .ty { min-height: 100vh; display: flex; flex-direction: column; }
  .top, .box, .ft { width: min(640px, 100% - 32px); margin-left: auto; margin-right: auto; }
  .top { height: 68px; display: flex; align-items: center; }
  .brand { display: flex; align-items: center; gap: 8px; color: #111; text-decoration: none; font-size: 15px; }
  .brand b { font-weight: 500; } .brand span { color: #8a8a86; }
  .k { font-size: 12px; font-weight: 500; letter-spacing: .12em; text-transform: uppercase; color: #6a6a66; }
  .box { margin-top: 40px; padding: 32px 30px; background: #fff; box-shadow: 0 0 0 1.5px #111, 4px 4px 0 #111; border-radius: 4px; }
  h1 { margin: 12px 0 14px; font-family: var(--m-serif); font-weight: 400; font-size: 38px; line-height: 1.1; letter-spacing: -.02em; text-wrap: balance; }
  .box p { margin: 0 0 12px; font-size: 16px; line-height: 1.6; color: #3a3a37; }
  .box a { color: #111; font-weight: 500; }
  .small { font-size: 14px !important; color: #77776f !important; }
  .next { margin-top: 24px; padding-top: 20px; border-top: 1px solid #ececea; }
  .next p { margin-top: 8px; }
  .ft { margin-top: auto; padding: 22px 0 28px; display: flex; gap: 20px; font-size: 12.5px; color: #8a8a86; }
  .ft a { color: inherit; text-decoration: none; }
  @media (max-width: 600px) { h1 { font-size: 30px; } .box { padding: 24px 20px; } }
</style>
