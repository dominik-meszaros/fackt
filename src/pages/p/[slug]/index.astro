---
// Paid Figma file page: fackt.io/p/<slug>. One job: the purchase. Content in src/content/products/<slug>.md,
// the Figma link and Polar product id in Supabase (shop_products, same slug). The Buy button goes to the
// Polar checkout link; after payment the "shop" edge function emails the file and Polar shows the thanks page.
import Base from '../../../layouts/Base.astro';
import Mark from '../../../components/home/Mark.astro';
import { site } from '../../../data/site';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  return (await getCollection('products')).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const r = entry.data;
const price = new Intl.NumberFormat('en-US', { style: 'currency', currency: r.currency, maximumFractionDigits: 0 }).format(r.price);
const live = Boolean(r.checkoutUrl);
// Only link the free sample once its page is live (draft off in src/content/free/<slug>.md).
const freeEntry = r.freeSlug ? (await getCollection('free')).find((f) => f.id === r.freeSlug && !f.data.draft) : undefined;
const free = freeEntry ? `/free/${freeEntry.id}` : '';
const ld = [{
  '@context': 'https://schema.org', '@type': 'Product', name: r.title, description: r.description,
  image: new URL(r.cover, 'https://fackt.io').toString(), brand: { '@type': 'Organization', name: 'Fackt', url: 'https://fackt.io' },
  offers: { '@type': 'Offer', price: String(r.price), priceCurrency: r.currency, availability: live ? 'https://schema.org/InStock' : 'https://schema.org/PreOrder', url: `https://fackt.io/p/${entry.id}` },
}, ...(r.faq.length ? [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: r.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }] : [])];
---
<Base title={`${r.title} for Figma | Fackt`} description={r.description} image={r.cover} noindex={r.draft} lcp={r.cover} schema={ld}>
  <div class="pp">
    <header class="top">
      <a href="/" class="brand"><Mark size={16} /><b>Fackt</b> <span>files</span></a>
      {r.videoUrl && <a class="vid" href={r.videoUrl} rel="noopener">&#9654; Watch the video</a>}
    </header>
    {r.draft && <p class="draft">Draft: only people with this link can see it. Add the Polar checkout link in the CMS file and switch off Draft to go live.</p>}

    <main class="hero">
      <div class="copy">
        <span class="k">Figma UI kit</span>
        <h1>{r.headline}</h1>
        <p class="lede">{r.lede}</p>
        <div class="buy">
          {live
            ? <a class="m-btn dk go" href={r.checkoutUrl} data-buy={entry.id}>Get {r.title.split(' ')[0]} for {price}</a>
            : <span class="m-btn dk go off" aria-disabled="true">Available soon</span>}
          <p class="terms">One-time payment. The Figma link arrives by email within a minute. Secure checkout by Polar.</p>
        </div>
        {free && <p class="try">Not sure yet? <a href={free}>Get the states sheet free</a> and see how the file is built.</p>}
      </div>
      <figure class="cv">
        <img src={r.cover} alt={`${r.title} cover`} width="1920" height="1080" loading="eager" fetchpriority="high" decoding="async" />
      </figure>
    </main>

    {r.gallery.length > 0 && (
      <section class="gal" aria-label="Screens">
        {r.gallery.map((g, i) => (
          <figure class={i === 0 ? 'wide' : ''}>
            <img src={g.src} alt={g.alt} loading="lazy" decoding="async" />
            {g.caption && <figcaption>{g.caption}</figcaption>}
          </figure>
        ))}
      </section>
    )}

    <section class="more">
      {r.inside.length > 0 && (
        <div>
          <span class="k">What is inside</span>
          <ul>{r.inside.map((x) => <li>{x}</li>)}</ul>
        </div>
      )}
      {r.forWho.length > 0 && (
        <div>
          <span class="k">Who it is for</span>
          <ul>{r.forWho.map((x) => <li>{x}</li>)}</ul>
        </div>
      )}
    </section>

    <section class="cta2">
      <div>
        <b>{r.title}</b>
        <span>{price}, one-time</span>
      </div>
      {live
        ? <a class="m-btn dk go" href={r.checkoutUrl} data-buy={entry.id}>Get the file</a>
        : <span class="m-btn dk go off" aria-disabled="true">Available soon</span>}
    </section>

    {r.faq.length > 0 && (
      <section class="qf">
        <span class="k">Questions</span>
        {r.faq.map((f, i) => <details open={i === 0}><summary>{f.q}</summary><p>{f.a}</p></details>)}
      </section>
    )}

    <section class="me">
      <span class="k">From Dom</span>
      <p>I run Fackt, a product design studio for SaaS teams. Relay is the product I designed for the channel, built the same way I build client products. Want this level of work on your own product? <a href="/audit">Get a free audit</a> or <a href="/book">book a call</a>.</p>
    </section>

    <footer class="ft"><span>&copy; {new Date().getFullYear()} Fackt Labs LLC</span><a href="/privacy">Privacy</a><a href={`mailto:${site.email}`}>{site.email}</a></footer>
  </div>
</Base>
<style>
  .pp { min-height: 100vh; display: flex; flex-direction: column; }
  .top, .hero, .gal, .more, .cta2, .qf, .me, .ft { width: min(1120px, 100% - 32px); margin-left: auto; margin-right: auto; }
  .top { height: 68px; display: flex; align-items: center; justify-content: space-between; }
  .brand { display: flex; align-items: center; gap: 8px; color: #111; text-decoration: none; font-size: 15px; }
  .brand b { font-weight: 500; } .brand span { color: #8a8a86; }
  .vid { font-size: 13.5px; color: #111; text-decoration: none; box-shadow: inset 0 0 0 1px #dcdcd8; padding: 8px 12px; border-radius: 3px; }
  .vid:hover { box-shadow: inset 0 0 0 1px #111; }
  .draft { margin: 0; background: #2335ff; color: #fff; font-size: 13px; text-align: center; padding: 8px 16px; }
  .k { font-size: 12px; font-weight: 500; letter-spacing: .12em; text-transform: uppercase; color: #6a6a66; }

  .hero { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: 56px; align-items: center; padding: 40px 0 64px; }
  h1 { margin: 14px 0 0; font-family: var(--m-serif); font-weight: 400; font-size: 50px; line-height: 1.05; letter-spacing: -.02em; text-wrap: balance; }
  .lede { margin: 16px 0 0; font-size: 17px; line-height: 1.55; color: #55554f; max-width: 470px; }
  .buy { margin-top: 28px; }
  .go { height: 50px; padding: 0 22px; font-size: 15px; }
  .go.off { opacity: .55; cursor: default; transform: none; }
  .terms { margin: 12px 0 0; font-size: 13px; line-height: 1.5; color: #77776f; max-width: 420px; }
  .try { margin: 22px 0 0; font-size: 14px; color: #55554f; } .try a { color: #111; font-weight: 500; text-underline-offset: 2px; }
  .cv { margin: 0; border-radius: 6px; overflow: hidden; box-shadow: 0 0 0 1px #dcdcd8, 0 30px 60px -30px rgba(17,17,17,.25); }
  .cv img { display: block; width: 100%; height: auto; }

  .gal { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px 32px; padding: 8px 0 64px; }
  .gal figure { margin: 0; min-width: 0; }
  .gal figure.wide { grid-column: 1 / -1; }
  .gal img { display: block; width: 100%; height: auto; border-radius: 6px; box-shadow: 0 0 0 1px #e2e2de; background: #f6f6f4; }
  .gal figcaption { margin-top: 12px; font-size: 14.5px; line-height: 1.55; color: #55554f; max-width: 560px; }

  .more { padding: 44px 0 56px; border-top: 1px solid #ececea; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 56px; }
  .more ul { margin: 12px 0 0; padding-left: 20px; font-size: 15.5px; line-height: 1.7; }

  .cta2 { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 22px 24px; margin-bottom: 64px; background: #fff; box-shadow: 0 0 0 1.5px #111, 4px 4px 0 #111; border-radius: 4px; }
  .cta2 b { display: block; font-family: var(--m-serif); font-weight: 400; font-size: 26px; line-height: 1.15; }
  .cta2 span { font-size: 14px; color: #6a6a66; }

  .qf { padding: 0 0 48px; }
  .qf .k { display: block; margin-bottom: 10px; }
  .qf details { border-bottom: 1px solid #ececea; padding: 16px 0; }
  .qf summary { list-style: none; cursor: pointer; font-weight: 500; font-size: 15px; display: flex; justify-content: space-between; gap: 16px; }
  .qf summary::-webkit-details-marker { display: none; }
  .qf summary::after { content: '+'; color: #8a8a86; font-weight: 400; }
  .qf details[open] summary::after { content: '\2212'; }
  .qf p { margin: 8px 0 0; color: #6a6a66; font-size: 14.5px; line-height: 1.6; max-width: 620px; }

  .me { padding: 8px 0 56px; }
  .me p { margin: 12px 0 0; font-size: 15.5px; line-height: 1.6; color: #3a3a37; max-width: 560px; } .me a { color: #111; font-weight: 500; }
  .ft { margin-top: auto; padding: 22px 0 28px; border-top: 1px solid #ececea; display: flex; gap: 20px; font-size: 12.5px; color: #8a8a86; }
  .ft a { color: inherit; text-decoration: none; } .ft a:hover { text-decoration: underline; }

  @media (max-width: 860px) {
    .hero { grid-template-columns: 1fr; gap: 28px; padding: 18px 0 40px; }
    h1 { font-size: 36px; }
    .lede { font-size: 16px; }
    .go { width: 100%; }
    .gal { grid-template-columns: 1fr; gap: 28px; }
    .more { grid-template-columns: 1fr; gap: 28px; }
    .cta2 { flex-direction: column; align-items: stretch; text-align: left; }
    .ft { flex-wrap: wrap; gap: 10px 18px; }
  }
</style>
<script>
  // Carry the video UTM into the checkout so Polar shows where each sale came from, and log the click.
  const q = new URLSearchParams(location.search);
  document.querySelectorAll<HTMLAnchorElement>('a[data-buy]').forEach((a) => {
    try {
      const u = new URL(a.href);
      ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content'].forEach((k) => { const v = q.get(k); if (v) u.searchParams.set(k, v); });
      a.href = u.toString();
    } catch { /* leave the link as is */ }
    a.addEventListener('click', () => (window as any).facktJourney?.track(`Clicked buy: ${a.dataset.buy}`));
  });
</script>
