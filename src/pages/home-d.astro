---
// HOMEPAGE TEST VERSION D (noindex; the worker shows it at fackt.io/ to part of the visitors, see src/data/homeTest.json).
// Same white theme, fonts and global components as the rest of fackt.io (Nav, Work, Proof, Footer, PhoneBar).
// What makes it D: a stepped contour pattern behind the hero, a reel of the work that plays like a video,
// a wall of video and written reviews, the calendar right on the page, and FAQs. No new claims: every number
// and quote comes from src/data and the content collections.

import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import EasterGame from '../components/EasterGame.astro';
import SketchDefs from '../components/home/SketchDefs.astro';
import SectionHead from '../components/home/SectionHead.astro';
import Step from '../components/home/Step.astro';
import Logos from '../components/home/Logos.astro';
import Work from '../components/home/Work.astro';
import Proof from '../components/home/Proof.astro';
import PhoneBar from '../components/home/PhoneBar.astro';
import { site } from '../data/site';
import { stageCategories } from '../data/stage';
import '../styles/faq.css';

const V = 'd';
const byOrder = <T extends { data: { order: number } }>(a: T, b: T) => a.data.order - b.data.order;
const all = (await getCollection('work')).sort(byOrder).map((e) => ({ slug: e.id, ...e.data }));
const bySlug = new Map(all.map((p) => [p.slug, p]));
const reel = stageCategories.flatMap((c) => c.slides.filter((s) => bySlug.has(s.slug)).map((s) => ({ ...bySlug.get(s.slug)!, img: s.image })));
const featured = all.filter((p) => p.featured).slice(0, 6);
const videos = (await getCollection('videos')).sort(byOrder).map((e) => e.data);
const reviews = (await getCollection('reviews')).sort(byOrder).map((e) => e.data);

const faqs = [
  { q: 'What do you design?', a: 'Products, websites and brands for SaaS and AI startups: dashboards, mobile apps, landing pages and the identity around them. Sites are built in Framer, Webflow or code.' },
  { q: 'How much is a monthly retainer?', a: '$6,900 per month. Unlimited requests worked one at a time, 24h turnaround and a dedicated Slack channel. Pause or cancel any time.' },
  { q: 'What does a one-time project cost?', a: 'Fixed-scope projects start from $5,000 and are delivered in milestones, usually over 2 to 6 weeks. Many teams start with a project and move to a retainer later.' },
  { q: 'How does your process work?', a: 'Four steps: a written brief, exploration of flows and directions, the first page designed, then the full delivered file with specs.' },
  { q: 'Can you audit my product for free?', a: 'Yes. Send your product and within 2 days you get a video walkthrough and a written audit of what to fix first.' },
];

// Hero pattern: stepped contour lines, the same step geometry as the F mark and the section dividers. Static.
const PW = 960, PH = 420;
const contours: string[] = [];
for (let i = 0; i * 18 < PH + 50; i++) {
  const base = i * 18 - 20; let d = '';
  for (let x = 0; x <= PW + 40; x += 40) {
    const raw = base + 18 * Math.sin(x / 140 + i * 0.28) + 7 * Math.sin(x / 66 - i * 0.6);
    const y = Math.round(raw / 6) * 6;
    d += d ? ` H${x} V${y}` : `M0 ${y}`;
  }
  contours.push(d);
}
---
<Base title="Fackt: we help SaaS products grow with design" noindex lcp={reel[0]?.img}>
  <div class="m-page">
    <SketchDefs />
    <Nav figmaButton={false} />
    <main>
      <section class="dh">
        <svg class="contours" viewBox={`0 0 ${PW} ${PH}`} preserveAspectRatio="xMidYMin slice" aria-hidden="true">
          {contours.map((d) => <path d={d} />)}
        </svg>
        <h1>We help SaaS products grow.</h1>
        <p class="sub">Product thinking and design for founders who need more signups, activation and retention, not just nicer screens.</p>
        <div class="ctas">
          <a class="m-btn dk" href="#book" data-journey={`Home ${V}: book call (hero)`}>Book a 30 minute call</a>
          <a class="aud" href="/audit" data-journey={`Home ${V}: free audit (hero)`}>or get a free audit first</a>
        </div>

        <div class="player" data-reel>
          {reel.map((p, i) => (
            <a class:list={['slide', { on: i === 0 }]} href={`/work/${p.slug}`} data-i={i} aria-hidden={i === 0 ? undefined : 'true'} tabindex={i === 0 ? 0 : -1} data-journey={`Home ${V}: opened case study ${p.name} (reel)`}>
              <img src={p.img} alt={`${p.name}, ${p.service.toLowerCase()}`} loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} decoding="async" />
            </a>
          ))}
          <div class="ctrl">
            <button type="button" class="ic" data-reel-toggle aria-label="Pause the reel">
              <svg class="i-play" width="11" height="11" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 1l7 4-7 4z" fill="currentColor"></path></svg>
              <svg class="i-pause" width="11" height="11" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 1h2v8H2zM6 1h2v8H6z" fill="currentColor"></path></svg>
            </button>
            <span class="tm" data-reel-time>0:00 / 0:00</span>
            <span class="now" data-reel-label>{reel[0]?.name}, {reel[0]?.service.toLowerCase()}</span>
            <button type="button" class="ic" data-reel-full aria-label="Full screen"><svg width="11" height="11" viewBox="0 0 12 12" aria-hidden="true"><path d="M1 4V1h3M8 1h3v3M11 8v3H8M4 11H1V8" fill="none" stroke="currentColor" stroke-width="1.3"></path></svg></button>
            <span class="track" aria-hidden="true"><i data-reel-bar></i></span>
          </div>
        </div>
      </section>
      <Logos />
      <Step />
      <Work projects={featured} total={all.length} lean resultChips />
      <Step />
      <Proof videos={videos} reviews={reviews} maxVideos={6} short wall
        highlights={["Best product designer I've ever worked with.", 'Super reliable and easy to work with.', 'We would 100% work with Dominik again.']} />
      <Step />
      <section class="m-sec" id="book" aria-label="Book a call">
        <SectionHead icon="calendar" title="Let's look at your product together." lede="30 minutes with Dom. You leave with clear next steps, whether we work together or not." />
        <div class="cal">
          <div class="ch"><b>30 min strategy call</b><span>Free</span></div>
          <div class="bd" id="cal-d" data-cal-link={site.calLink}><span class="loading">Loading the calendar&#8230;</span></div>
          <div class="ft2"><span>Times in your time zone</span><span>Not loading? <a href={site.booking} target="_blank" rel="noopener">Open it on Cal.com</a></span></div>
        </div>
        <a class="aud" href="/audit" data-journey={`Home ${V}: free audit (calendar)`}>or get a free audit first</a>
      </section>
      <Step />
      <section class="faqw" aria-label="Questions">
        <div><span class="eb">Questions</span><h2 class="m-h2">Before you book.</h2></div>
        <div class="faq">
          {faqs.map((f, i) => <details open={i === 0} data-faq={i}><summary>{f.q}</summary><p>{f.a}</p></details>)}
        </div>
      </section>
    </main>
    <Footer />
    <PhoneBar variant={V} />
    <EasterGame />
  </div>
</Base>

<style>
  /* hero: same type and buttons as the live homepage, the contour lines behind it */
  .dh { position: relative; overflow: hidden; display: flex; flex-direction: column; align-items: center; text-align: center; padding: 64px 16px 0; }
  .contours { position: absolute; left: 0; right: 0; top: 0; width: 100%; height: 520px; pointer-events: none;
    mask-image: radial-gradient(60% 75% at 50% 30%, rgba(0,0,0,.08) 0%, rgba(0,0,0,.2) 50%, #000 100%);
    -webkit-mask-image: radial-gradient(60% 75% at 50% 30%, rgba(0,0,0,.08) 0%, rgba(0,0,0,.2) 50%, #000 100%); }
  .contours path { fill: none; stroke: #e6e4df; stroke-width: 1; vector-effect: non-scaling-stroke; }
  .dh > *:not(.contours) { position: relative; }
  h1 { margin: 0; max-width: 960px; font-family: var(--m-serif); font-weight: 400; font-size: 54px; line-height: 1.08; letter-spacing: -.02em; }
  .sub { margin: 14px auto 0; max-width: 520px; font-size: 17px; color: #6f6f6f; }
  .ctas { display: flex; align-items: center; gap: 18px; margin-top: 26px; }
  .aud { font-size: 14px; color: #111; text-decoration: none; border-bottom: 1px solid #111; }
  .aud:hover { border-bottom-width: 2px; }

  /* reel: plays through the work like a video, in the same frame as the live homepage's stage */
  .player { position: relative; width: min(960px, 100%); aspect-ratio: 2 / 1; margin-top: 36px; border-radius: 4px; overflow: hidden; background: #f2f2f0; box-shadow: inset 0 0 0 1px #dcdcd8; }
  .slide { position: absolute; inset: 0; opacity: 0; transition: opacity .7s ease; z-index: 0; }
  .slide.on { opacity: 1; z-index: 1; }
  .slide img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ctrl { position: absolute; left: 0; right: 0; bottom: 0; z-index: 3; display: grid; grid-template-columns: auto auto 1fr auto; align-items: center; gap: 10px; padding: 34px 14px 10px; background: linear-gradient(180deg, rgba(0,0,0,0), rgba(0,0,0,.5)); color: #fff; font-size: 12px; font-weight: 500; text-align: left; }
  .ic { all: unset; cursor: pointer; width: 22px; height: 22px; display: grid; place-items: center; color: #fff; border-radius: 2px; }
  .ic:hover { background: rgba(255,255,255,.14); }
  .ic:focus-visible { outline: 1px solid #fff; }
  .ic .i-play { display: none; } .player.paused .ic .i-play { display: block; } .player.paused .ic .i-pause { display: none; }
  .tm { font-variant-numeric: tabular-nums; }
  .now { color: rgba(255,255,255,.8); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-align: right; font-weight: 400; }
  .track { grid-column: 1 / -1; height: 2px; background: rgba(255,255,255,.3); position: relative; margin-top: 2px; }
  .track i { position: absolute; left: 0; top: 0; bottom: 0; width: 0; background: #fff; }

  /* calendar on the page, the same card as /book */
  .cal { width: min(960px, 100%); margin-top: 36px; display: flex; flex-direction: column; background: #fff; box-shadow: 0 0 0 1px #111, 4px 4px 0 #111; border-radius: 3px; overflow: hidden; text-align: left; }
  .cal .ch { padding: 18px 22px; border-bottom: 1px solid #ececea; display: flex; justify-content: space-between; align-items: center; font-size: 15px; }
  .cal .ch b { font-weight: 500; }
  .cal .ch span { font-size: 12px; font-weight: 500; padding: 3px 8px; border-radius: 2px; background: #111; color: #fff; }
  .cal .bd { min-height: 520px; }
  .loading { display: grid; place-items: center; min-height: 520px; color: #8a8a86; font-size: 14px; }
  .cal .ft2 { padding: 12px 22px; border-top: 1px solid #ececea; font-size: 12px; color: #8a8a86; display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .cal .ft2 a { color: #111; }
  #book > .aud { margin-top: 22px; }

  /* FAQ, the same accordion as the audit and service pages */
  .faqw { width: min(960px, 100% - 32px); margin: 0 auto; display: grid; grid-template-columns: 300px 1fr; gap: 56px; padding: 54px 0 72px; }
  .eb { display: block; font-size: 12.5px; color: #8a8a86; margin-bottom: 8px; }
  .faq { border-top: 1px solid #dcdcd8; }
  .faq details { border-bottom: 1px solid #ececea; padding: 18px 0; }
  .faq summary { list-style: none; display: flex; justify-content: space-between; gap: 20px; font-weight: 500; font-size: 15px; cursor: pointer; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq p { margin: 10px 0 0; color: #6a6a66; font-size: 14px; max-width: 640px; }

  @media (max-width: 720px) {
    .dh { padding-top: 40px; }
    .contours { height: 380px; }
    h1 { font-size: 38px; }
    .sub { font-size: 15px; max-width: 340px; }
    .ctas { flex-direction: column; gap: 14px; width: 100%; max-width: 360px; }
    .ctas .m-btn { width: 100%; justify-content: center; }
    .player { aspect-ratio: 4 / 3; margin-top: 24px; }
    .ctrl { padding: 26px 10px 8px; font-size: 11px; }
    .cal { margin-top: 24px; }
    .cal .ch { padding: 14px 16px; } .cal .ft2 { padding: 10px 16px; }
    .cal .bd, .loading { min-height: 560px; }
    .faqw { grid-template-columns: 1fr; gap: 20px; padding: 40px 0 56px; }
  }
  @media (prefers-reduced-motion: reduce) { .slide { transition: none; } }
</style>

<script>
  import '../scripts/faq';

  // Reel: crossfades through the work (3.2 s each) with time and progress, plays while on screen, pause and full screen.
  const player = document.querySelector<HTMLElement>('[data-reel]');
  if (player) {
    const slides = Array.from(player.querySelectorAll<HTMLAnchorElement>('.slide'));
    const label = player.querySelector<HTMLElement>('[data-reel-label]');
    const time = player.querySelector<HTMLElement>('[data-reel-time]');
    const bar = player.querySelector<HTMLElement>('[data-reel-bar]');
    const btn = player.querySelector<HTMLButtonElement>('[data-reel-toggle]');
    const MS = 3200, TOTAL = MS * slides.length;
    const mmss = (ms: number) => { const s = Math.floor(ms / 1000); return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`; };
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let pos = 0, last = 0, cur = 0, userPaused = reduce, visible = false;
    const show = (i: number) => {
      if (i === cur) return; cur = i;
      slides.forEach((s, k) => { const on = k === i; s.classList.toggle('on', on); s.tabIndex = on ? 0 : -1; if (on) s.removeAttribute('aria-hidden'); else s.setAttribute('aria-hidden', 'true'); });
      const next = slides[(i + 1) % slides.length]?.querySelector('img'); if (next) next.loading = 'eager';
      const img = slides[i]?.querySelector('img'); if (label && img) label.textContent = img.alt;
    };
    const paint = () => { if (time) time.textContent = `${mmss(pos)} / ${mmss(TOTAL)}`; if (bar) bar.style.width = `${(pos / TOTAL) * 100}%`; };
    const playing = () => visible && !userPaused && document.visibilityState === 'visible';
    const frame = (now: number) => {
      if (playing() && last) { pos = (pos + (now - last)) % TOTAL; show(Math.floor(pos / MS)); paint(); }
      last = now; requestAnimationFrame(frame);
    };
    player.classList.toggle('paused', userPaused);
    paint(); requestAnimationFrame(frame);
    btn?.addEventListener('click', () => { userPaused = !userPaused; player.classList.toggle('paused', userPaused); btn.setAttribute('aria-label', userPaused ? 'Play the reel' : 'Pause the reel'); });
    player.querySelector('[data-reel-full]')?.addEventListener('click', () => { if (document.fullscreenElement) document.exitFullscreen(); else player.requestFullscreen?.(); });
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; }, { threshold: 0.4 }).observe(player);
  }

  // Calendar on the page (same Cal.com event and namespace as /book, so bookings are tracked the same way).
  const el = document.getElementById('cal-d');
  const calLink = el?.dataset.calLink;
  let started = false;
  const startCal = () => {
    if (started || !el || !calLink) return; started = true;
    (function (C: any, A: string, L: string) {
      const p = (a: any, ar: any) => a.q.push(ar);
      const d = C.document;
      C.Cal = C.Cal || function (...args: any[]) {
        const cal = C.Cal;
        if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement('script')).src = A; cal.loaded = true; }
        if (args[0] === L) {
          const api: any = function (...a: any[]) { p(api, a); };
          const namespace = args[1]; api.q = api.q || [];
          if (typeof namespace === 'string') { cal.ns[namespace] = cal.ns[namespace] || api; p(cal.ns[namespace], args); p(cal, ['initNamespace', namespace]); } else p(cal, args);
          return;
        }
        p(cal, args);
      };
    })(window, 'https://app.cal.com/embed/embed.js', 'init');
    const Cal = (window as any).Cal;
    Cal('init', 'fackt', { origin: 'https://cal.com' });
    const config: Record<string, string> = { layout: 'month_view', theme: 'light' };
    const vid = (() => { try { return JSON.parse(localStorage.getItem('fj_vid') || 'null'); } catch { return null; } })();
    if (vid) config['metadata[fackt_vid]'] = vid;
    Cal.ns.fackt('inline', { elementOrSelector: '#cal-d', calLink, config });
    Cal.ns.fackt('ui', { theme: 'light', hideEventTypeDetails: true, layout: 'month_view', cssVarsPerTheme: { light: { 'cal-brand': '#111111' } }, styles: { branding: { brandColor: '#111111' } } });
    Cal.ns.fackt('on', { action: 'linkReady', callback: () => el.querySelector('.loading')?.remove() });
  };
  // Load the calendar only when it is close to the screen, so the top of the page stays fast.
  if (el) new IntersectionObserver((es, o) => { if (es.some((e) => e.isIntersecting)) { startCal(); o.disconnect(); } }, { rootMargin: '600px' }).observe(el);
</script>
