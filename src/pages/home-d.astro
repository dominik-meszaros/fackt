---
// HOMEPAGE TEST VERSION D (noindex; the worker shows it at fackt.io/ to part of the visitors, see src/data/homeTest.json).
// Layout modelled on the Intently homepage Dom shared: a dark page on a hairline grid, a short hero with logos,
// a reel of the work, case studies as big images, short client quotes, the calendar right on the page, FAQs,
// and a big pixel wordmark. Same fonts as the rest of fackt.io (Geist, Geist Mono, Newsreader), no new claims:
// every number and quote comes from src/data and the content collections.

import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Mark from '../components/home/Mark.astro';
import { site } from '../data/site';
import { homeSettings } from '../data/settings';
import { stageCategories } from '../data/stage';

const V = 'd';
const byOrder = <T extends { data: { order: number } }>(a: T, b: T) => a.data.order - b.data.order;
const all = (await getCollection('work')).sort(byOrder).map((e) => ({ slug: e.id, ...e.data }));
const bySlug = new Map(all.map((p) => [p.slug, p]));
const reel = stageCategories.flatMap((c) => c.slides.filter((s) => bySlug.has(s.slug)).map((s) => ({ ...bySlug.get(s.slug)!, img: s.image })));
const featured = all.filter((p) => p.featured).slice(0, 6);
const reviews = (await getCollection('reviews')).sort(byOrder).map((e) => e.data);
const rating = homeSettings.rating;
const logos = homeSettings.logos.slice(0, 6);

const faqs = [
  { q: 'What do you design?', a: 'Products, websites and brands for SaaS and AI startups: dashboards, mobile apps, landing pages and the identity around them. Sites are built in Framer, Webflow or code.' },
  { q: 'How much is a monthly retainer?', a: '$6,900 per month. Unlimited requests worked one at a time, 24h turnaround and a dedicated Slack channel. Pause or cancel any time.' },
  { q: 'What does a one-time project cost?', a: 'Fixed-scope projects start from $5,000 and are delivered in milestones, usually over 2 to 6 weeks. Many teams start with a project and move to a retainer later.' },
  { q: 'How does your process work?', a: 'Four steps: a written brief, exploration of flows and directions, the first page designed, then the full delivered file with specs.' },
  { q: 'Can you audit my product for free?', a: 'Yes. Send your product and within 2 days you get a video walkthrough and a written audit of what to fix first.' },
];

// Pixel wordmark, same 5x7 letters as the site footer, drawn as outlined squares.
const FONT: Record<string, string[]> = {
  F: ['11111', '10000', '10000', '11110', '10000', '10000', '10000'],
  A: ['01110', '10001', '10001', '11111', '10001', '10001', '10001'],
  C: ['01111', '10000', '10000', '10000', '10000', '10000', '01111'],
  K: ['10001', '10010', '10100', '11000', '10100', '10010', '10001'],
  T: ['11111', '00100', '00100', '00100', '00100', '00100', '00100'],
};
const px: [number, number][] = [];
[...'FACKT'].forEach((ch, i) => FONT[ch].forEach((row, r) => [...row].forEach((v, c) => { if (v === '1') px.push([i * 6 + c, r]); })));
const year = new Date().getFullYear();
---
<Base title="Fackt: product design for SaaS and AI startups" noindex lcp={featured[0]?.preview ?? featured[0]?.image}>
  <div class="dk">
    <header class="bar">
      <a class="brand" href="/" aria-label="Fackt home"><Mark size={12} />Fackt</a>
      <span class="clock" data-clock aria-label="Time in Bratislava">--:--:--</span>
    </header>

    <main>
      <section class="hero cell">
        <div class="sq" aria-hidden="true"></div>
        <h1>Product Design<br />for SaaS and AI Teams</h1>
        <p class="sub">Your dedicated design team for every product, website and launch.</p>
        <div class="btns">
          <a class="b w" href="#book" data-journey={`Home ${V}: book call (hero)`}>Get in touch</a>
          <a class="b o" href="#work" data-journey={`Home ${V}: see work (hero)`}>See our work</a>
        </div>
        <div class="trust">
          <span class="mono">Trusted by:</span>
          <ul>{logos.map((l) => <li>{l.logo ? <img src={l.logo} alt={l.name} loading="eager" height="14" /> : l.name}</li>)}</ul>
        </div>
      </section>

      <section class="reel-sec cell" aria-label="Reel">
        <div class="rh">
          <div>
            <h2 class="serif">Reel <sup>({year})</sup></h2>
            <p class="dim">{all.length} SaaS and AI projects. Rated {rating.value} out of 5 on {rating.source}.</p>
          </div>
          <a class="b w sm" href="#book" data-journey={`Home ${V}: book call (reel)`}>Get in touch</a>
        </div>
        <div class="player" data-reel>
          <div class="poster" aria-hidden="true"><Mark size={46} /></div>
          {reel.map((p, i) => (
            <a class="slide" href={`/work/${p.slug}`} data-i={i} aria-hidden="true" tabindex="-1">
              <img src={p.img} alt={`${p.name}, ${p.service.toLowerCase()}`} loading="lazy" decoding="async" />
            </a>
          ))}
          <div class="ctrl">
            <button type="button" class="ic" data-reel-toggle aria-label="Play the reel">
              <svg class="i-play" width="11" height="11" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 1l7 4-7 4z" fill="currentColor"></path></svg>
              <svg class="i-pause" width="11" height="11" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 1h2v8H2zM6 1h2v8H6z" fill="currentColor"></path></svg>
            </button>
            <span class="tm" data-reel-time>0:00 / 0:00</span>
            <span class="now" data-reel-label></span>
            <button type="button" class="ic" data-reel-full aria-label="Full screen"><svg width="11" height="11" viewBox="0 0 12 12" aria-hidden="true"><path d="M1 4V1h3M8 1h3v3M11 8v3H8M4 11H1V8" fill="none" stroke="currentColor" stroke-width="1.3"></path></svg></button>
            <span class="track" aria-hidden="true"><i data-reel-bar></i></span>
          </div>
        </div>
      </section>

      <section class="work cell" id="work">
        <span class="eyebrow">Featured work</span>
        <h2 class="serif">Case Studies</h2>
        <div class="grid">
          {featured.map((p) => (
            <a class="card" href={`/work/${p.slug}`} data-journey={`Home ${V}: opened case study ${p.name}`}>
              <img src={p.preview ?? p.image} alt={`${p.name}, ${p.service.toLowerCase()}`} loading="lazy" decoding="async" />
              <span class="nm">{p.name}</span>
              <span class="ar" aria-hidden="true">&#8599;</span>
            </a>
          ))}
        </div>
      </section>

      <section class="quotes cell" aria-label="What founders say">
        <h2 class="serif">Hear it directly from our clients.</h2>
        <p class="dim">Rated {rating.value} out of 5 on {rating.source} by the SaaS and AI founders we design for.</p>
        <a class="b w sm" href="#book" data-journey={`Home ${V}: book call (quotes)`}>Get in touch</a>
        <div class="qnav">
          <button type="button" data-q-prev aria-label="Previous quotes"><svg width="10" height="10" viewBox="0 0 12 12" aria-hidden="true"><path d="M7.5 2.5L4 6l3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.6"></path></svg></button>
          <button type="button" data-q-next aria-label="Next quotes"><svg width="10" height="10" viewBox="0 0 12 12" aria-hidden="true"><path d="M4.5 2.5L8 6 4.5 9.5" fill="none" stroke="currentColor" stroke-width="1.6"></path></svg></button>
        </div>
        <div class="qrow" data-q-row>
          {reviews.map((x) => (
            <figure class="q">
              <p>&#8220;{x.highlight}&#8221;</p>
              <figcaption>
                <span class="who"><b>{x.name}<svg class="vf" width="11" height="11" viewBox="0 0 12 12" aria-label="Verified review"><circle cx="6" cy="6" r="6" fill="#3b82f6"></circle><path d="M3.4 6.2l1.8 1.7 3.4-3.6" fill="none" stroke="#fff" stroke-width="1.4"></path></svg></b><span>{x.role}</span></span>
              </figcaption>
            </figure>
          ))}
        </div>
      </section>

      <section class="touch" id="book" aria-label="Book a call">
        <h2>Get in touch</h2>
        <p class="dim">Pick a time and talk to Dom. 30 minutes, free.</p>
        <div class="calbox">
          <div id="cal-d" data-cal-link={site.calLink}><span class="loading">Loading the calendar&#8230; <a href={site.booking} target="_blank" rel="noopener">Open it on Cal.com</a></span></div>
        </div>
        <a class="b blue" href="/audit" data-journey={`Home ${V}: free audit (calendar)`}><svg width="11" height="11" viewBox="0 0 12 12" aria-hidden="true"><path d="M1.5 6.2L10.5 2 8.6 10.5 5.8 7.6 4.3 9.4 4.2 6.9 8.6 3.6 3.6 6.4z" fill="currentColor"></path></svg>Or get a free audit first</a>
      </section>

      <section class="faq" aria-label="Questions">
        <h2 class="serif">FAQs</h2>
        <div class="qs">
          {faqs.map((f) => (
            <details>
              <summary>{f.q}<span aria-hidden="true">+</span></summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </section>
    </main>

    <footer class="foot">
      <div class="fl cell">
        <span>All rights reserved &#169; {year} Fackt Labs LLC</span>
        <nav aria-label="Social">{site.socials.filter((s) => s.label === 'X' || s.label === 'LinkedIn').map((s) => <a href={s.href} target="_blank" rel="noopener">{s.label}</a>)}</nav>
      </div>
      <svg class="word" viewBox="-1 -1 31 9" aria-label="Fackt" role="img">
        {px.map(([x, y]) => <rect x={x + 0.1} y={y + 0.1} width="0.8" height="0.8" />)}
      </svg>
    </footer>
  </div>
</Base>

<style is:global>
  body:has(.dk) { background: #000; }
  /* cookie banner, dark on this page */
  body:has(.dk) .cs { background: #111 !important; color: #e8e8e6 !important; box-shadow: 0 0 0 1px #2a2a2a !important; }
  body:has(.dk) .cs a { color: #e8e8e6 !important; }
  body:has(.dk) .cs .m-btn.dk { background: #f2f2f0 !important; color: #000 !important; box-shadow: none !important; }
  body:has(.dk) .cs .m-btn.lt { background: #1a1a1a !important; color: #e8e8e6 !important; box-shadow: inset 0 0 0 1px #333 !important; }
</style>
<style>
  .dk { --fg: #f2f2f0; --dim: #7c7c78; --line: #1a1a1a; --line2: #2a2a2a; --card: #111; background: #000; color: var(--fg); font-family: Geist, system-ui, sans-serif; min-height: 100vh; overflow-x: clip; }
  .serif { font-family: Newsreader, Georgia, serif; font-weight: 400; letter-spacing: -.02em; }
  .dim { color: var(--dim); }
  .mono, .b, .clock, .tm, .now { font-family: 'Geist Mono', ui-monospace, monospace; }
  .cell { width: min(600px, calc(100% - 32px)); margin: 0 auto; border-left: 1px solid var(--line); border-right: 1px solid var(--line); position: relative; }
  main > section { position: relative; border-bottom: 1px solid var(--line); }
  main > section::after { content: ''; position: absolute; left: -100vw; right: -100vw; bottom: -1px; border-bottom: 1px solid var(--line); pointer-events: none; }

  .bar { width: min(600px, calc(100% - 32px)); margin: 0 auto; height: 40px; display: flex; align-items: center; justify-content: space-between; border-left: 1px solid var(--line); border-right: 1px solid var(--line); padding: 0 8px; }
  .brand { display: inline-flex; align-items: center; gap: 6px; font-size: 11px; color: var(--fg); text-decoration: none; }
  .clock { font-size: 10.5px; color: var(--dim); font-variant-numeric: tabular-nums; }

  .b { display: inline-flex; align-items: center; justify-content: center; gap: 6px; white-space: nowrap; flex: none; height: 22px; padding: 0 9px; border-radius: 2px; font-size: 9.5px; text-transform: uppercase; letter-spacing: .04em; text-decoration: none; transition: background .2s, color .2s; }
  .b.w { background: var(--fg); color: #000; }
  .b.w:hover { background: #fff; }
  .b.o { color: var(--fg); background: #141414; box-shadow: inset 0 0 0 1px var(--line2); }
  .b.o:hover { background: #1c1c1c; }
  .b.blue { height: 26px; padding: 0 12px; background: #2a72d8; color: #fff; text-transform: none; letter-spacing: 0; font-family: Geist, system-ui, sans-serif; font-size: 11.5px; }
  .b.blue:hover { background: #3b82f6; }

  .hero { padding: 120px 20px 28px; text-align: center; overflow: hidden; }
  .sq { position: absolute; inset: 0; background-image: linear-gradient(#141414 1px, transparent 1px), linear-gradient(90deg, #141414 1px, transparent 1px); background-size: 24px 24px; background-position: center top; mask-image: radial-gradient(75% 70% at 50% 35%, #000 0%, transparent 90%); -webkit-mask-image: radial-gradient(75% 70% at 50% 35%, #000 0%, transparent 90%); pointer-events: none; }
  .hero > *:not(.sq) { position: relative; }
  h1 { margin: 0; font-weight: 400; font-size: 34px; line-height: 1.12; letter-spacing: -.025em; }
  .sub { margin: 14px auto 0; max-width: 300px; font-size: 11.5px; line-height: 1.5; color: var(--dim); }
  .btns { display: flex; justify-content: center; gap: 6px; margin-top: 20px; }
  .trust { margin-top: 30px; display: flex; flex-direction: column; align-items: center; gap: 10px; }
  .trust .mono { font-size: 10.5px; color: var(--dim); letter-spacing: .03em; }
  .trust ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 22px; }
  .trust li { display: flex; align-items: center; min-height: 16px; font-size: 11px; color: var(--fg); }
  .trust img { height: 14px; width: auto; max-width: 84px; object-fit: contain; filter: brightness(0) invert(1); opacity: .9; }

  .reel-sec { padding-top: 18px; }
  .rh { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; padding: 0 6px 14px; }
  .rh h2 { margin: 0; font-size: 22px; line-height: 1; }
  .rh sup { font-family: 'Geist Mono', monospace; font-size: 8px; color: var(--dim); letter-spacing: 0; vertical-align: super; margin-left: 2px; }
  .rh p { margin: 8px 0 0; font-size: 11px; }
  .player { position: relative; aspect-ratio: 16 / 9; background: #000; overflow: hidden; cursor: pointer; }
  .poster { position: absolute; inset: 0; display: grid; place-items: center; color: #fff; z-index: 1; transition: opacity .5s; }
  .player.started .poster { opacity: 0; }
  .slide { position: absolute; inset: 0; opacity: 0; transition: opacity .7s ease; z-index: 0; }
  .slide.on { opacity: 1; z-index: 1; }
  .slide img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ctrl { position: absolute; left: 0; right: 0; bottom: 0; z-index: 3; display: grid; grid-template-columns: auto auto 1fr auto; align-items: center; gap: 8px; padding: 22px 8px 6px; background: linear-gradient(180deg, rgba(0,0,0,0), rgba(0,0,0,.6)); color: #fff; }
  .ic { all: unset; cursor: pointer; width: 18px; height: 18px; display: grid; place-items: center; color: #fff; }
  .ic:focus-visible { outline: 1px solid #fff; }
  .ic .i-pause { display: none; } .player.playing .ic .i-pause { display: block; } .player.playing .ic .i-play { display: none; }
  .tm { font-size: 9.5px; font-variant-numeric: tabular-nums; }
  .now { font-size: 9.5px; color: rgba(255,255,255,.7); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-align: right; }
  .track { grid-column: 1 / -1; height: 2px; background: rgba(255,255,255,.25); position: relative; margin-top: 2px; }
  .track i { position: absolute; left: 0; top: 0; bottom: 0; width: 0; background: #fff; }

  .work { padding: 40px 0 0; text-align: center; }
  .eyebrow { font-size: 10.5px; color: var(--dim); }
  .work h2 { margin: 18px 0 -6px; font-size: 24px; line-height: 1; position: relative; z-index: 2; }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
  .card { position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: var(--card); color: #fff; text-decoration: none; text-align: left; }
  .card img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .7s cubic-bezier(.2,.8,.2,1); }
  .card::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,0) 50%, rgba(0,0,0,.85)); }
  .card:hover img { transform: scale(1.04); }
  .nm, .ar { position: absolute; bottom: 7px; z-index: 2; font-size: 10.5px; }
  .nm { left: 8px; } .ar { right: 8px; opacity: .6; }

  .quotes { padding: 36px 0 8px; text-align: center; }
  .quotes h2 { margin: 0; font-size: 22px; line-height: 1.1; }
  .quotes .dim { margin: 10px auto 12px; max-width: 300px; font-size: 11px; line-height: 1.5; }
  .qnav { display: flex; justify-content: flex-end; gap: 4px; padding: 18px 2px 8px; }
  .qnav button { all: unset; cursor: pointer; width: 18px; height: 18px; display: grid; place-items: center; border-radius: 50%; background: #1e1e1e; color: var(--fg); }
  .qnav button:hover { background: #2a2a2a; }
  .qnav button:focus-visible { outline: 1px solid #fff; }
  .qrow { display: flex; gap: 6px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; text-align: left; }
  .qrow::-webkit-scrollbar { display: none; }
  .q { flex: 0 0 calc((100% - 12px) / 3); scroll-snap-align: start; margin: 0; background: #121212; border-radius: 2px; padding: 10px 10px 9px; display: flex; flex-direction: column; justify-content: space-between; min-height: 106px; }
  .q p { margin: 0; font-size: 10.5px; line-height: 1.45; }
  .q figcaption { margin-top: 14px; padding-top: 9px; border-top: 1px solid #222; }
  .who { display: flex; flex-direction: column; gap: 1px; font-size: 10px; }
  .who b { font-weight: 500; display: inline-flex; align-items: center; gap: 4px; }
  .who span { color: var(--dim); font-size: 9px; }

  .touch { padding: 28px 16px 36px; text-align: center; }
  .touch h2 { margin: 0; font-size: 24px; font-weight: 400; letter-spacing: -.02em; }
  .touch .dim { margin: 6px 0 0; font-size: 11px; }
  .calbox { margin: 16px auto 0; width: min(820px, 100%); border-radius: 6px; background: #141414; box-shadow: 0 0 0 1px #262626; overflow: hidden; text-align: left; }
  .calbox .loading { display: grid; place-items: center; height: 454px; color: var(--dim); font-size: 12px; }
  .calbox .loading a { color: var(--fg); }
  .touch .b.blue { margin-top: 16px; }

  .faq { width: min(640px, calc(100% - 32px)); margin: 0 auto; padding: 40px 0 70px; display: grid; grid-template-columns: 180px 1fr; gap: 16px; }
  .faq h2 { margin: 0; font-size: 22px; line-height: 1; }
  .qs { display: flex; flex-direction: column; gap: 6px; }
  details { background: #141414; border-radius: 2px; }
  summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; gap: 16px; padding: 10px 10px; font-size: 11px; }
  summary::-webkit-details-marker { display: none; }
  summary span { transition: transform .2s; }
  details[open] summary span { transform: rotate(45deg); }
  details p { margin: 0; padding: 0 10px 12px; font-size: 11px; line-height: 1.55; color: var(--dim); }

  .foot { padding-bottom: 20px; }
  .fl { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding: 10px 8px; font-size: 9.5px; color: var(--dim); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .fl nav { display: flex; gap: 10px; }
  .fl a { color: var(--dim); text-decoration: none; }
  .fl a:hover { color: var(--fg); }
  .word { display: block; width: min(600px, calc(100% - 32px)); margin: 50px auto 0; }
  .word rect { fill: none; stroke: #262626; stroke-width: .05; }

  @media (min-width: 721px) {
    /* Cal.com only shows its three panel layout (details, month, times) from about 820px wide.
       Render it at that width and scale it to the card size of the reference. Clicks still land correctly. */
    .calbox { width: 820px; zoom: .62; margin-top: 26px; }
  }
  @media (max-width: 720px) {
    .hero { padding: 80px 16px 28px; }
    h1 { font-size: 30px; }
    .sub { font-size: 13px; }
    .b { height: 30px; font-size: 10.5px; padding: 0 12px; }
    .trust img { height: 13px; }
    .rh { padding: 0 8px 12px; }
    .rh h2 { font-size: 22px; }
    .rh p { font-size: 12px; }
    .grid { grid-template-columns: 1fr; }
    .nm, .ar { font-size: 12px; bottom: 9px; }
    .quotes .dim { font-size: 12.5px; }
    .q { flex-basis: 78%; min-height: 120px; }
    .q p { font-size: 12.5px; } .who { font-size: 11.5px; } .who span { font-size: 10.5px; }
    .calbox .loading { height: 600px; }
    .faq { grid-template-columns: 1fr; padding: 32px 0 56px; }
    summary, details p { font-size: 13px; padding-left: 12px; padding-right: 12px; }
    .fl { font-size: 10.5px; }
  }
  @media (prefers-reduced-motion: reduce) { .slide, .poster { transition: none; } .card img { transition: none; } }
</style>

<script>
  // Live clock in Bratislava time, like the reference's corner clock.
  const clock = document.querySelector<HTMLElement>('[data-clock]');
  if (clock) {
    const f = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Bratislava', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false });
    const tick = () => { clock.textContent = f.format(new Date()); };
    tick(); setInterval(tick, 1000);
  }

  // Reel: a video-style player. Dark poster with the mark, then it plays through the work (3.2 s per project) once it is on screen.
  const player = document.querySelector<HTMLElement>('[data-reel]');
  if (player) {
    const slides = Array.from(player.querySelectorAll<HTMLAnchorElement>('.slide'));
    const label = player.querySelector<HTMLElement>('[data-reel-label]');
    const time = player.querySelector<HTMLElement>('[data-reel-time]');
    const bar = player.querySelector<HTMLElement>('[data-reel-bar]');
    const btn = player.querySelector<HTMLButtonElement>('[data-reel-toggle]');
    const MS = 3200, TOTAL = MS * slides.length;
    const mmss = (ms: number) => { const s = Math.floor(ms / 1000); return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`; };
    let pos = 0, playing = false, last = 0, cur = -1, userPaused = false;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const show = (i: number) => {
      if (i === cur) return; cur = i;
      slides.forEach((s, k) => { const on = k === i; s.classList.toggle('on', on); s.tabIndex = on ? 0 : -1; if (on) s.removeAttribute('aria-hidden'); else s.setAttribute('aria-hidden', 'true'); });
      const img = slides[i]?.querySelector('img'); const next = slides[(i + 1) % slides.length]?.querySelector('img');
      if (next) next.loading = 'eager';
      if (label && img) { const n = img.alt; label.textContent = n.charAt(0).toUpperCase() + n.slice(1); }
    };
    const paint = () => { if (time) time.textContent = `${mmss(pos)} / ${mmss(TOTAL)}`; if (bar) bar.style.width = `${(pos / TOTAL) * 100}%`; };
    const set = (on: boolean) => {
      playing = on; player.classList.toggle('playing', on);
      if (on) { player.classList.add('started'); show(Math.floor(pos / MS) % slides.length); }
      btn?.setAttribute('aria-label', on ? 'Pause the reel' : 'Play the reel');
    };
    const frame = (now: number) => {
      if (playing && last) { pos = (pos + (now - last)) % TOTAL; show(Math.floor(pos / MS)); paint(); }
      last = now; requestAnimationFrame(frame);
    };
    paint(); requestAnimationFrame(frame);
    btn?.addEventListener('click', (e) => { e.preventDefault(); userPaused = playing; set(!playing); });
    player.querySelector('[data-reel-full]')?.addEventListener('click', (e) => { e.preventDefault(); if (document.fullscreenElement) document.exitFullscreen(); else player.requestFullscreen?.(); });
    // plays when on screen (like a muted autoplay video), pauses when scrolled away
    new IntersectionObserver(([e]) => { if (reduce || userPaused) return; set(e.isIntersecting); }, { threshold: 0.5 }).observe(player);
  }

  // Quote carousel arrows.
  const row = document.querySelector<HTMLElement>('[data-q-row]');
  const step = () => (row?.querySelector<HTMLElement>('.q')?.offsetWidth ?? 300) + 10;
  document.querySelector('[data-q-prev]')?.addEventListener('click', () => row?.scrollBy({ left: -step(), behavior: 'smooth' }));
  document.querySelector('[data-q-next]')?.addEventListener('click', () => row?.scrollBy({ left: step(), behavior: 'smooth' }));

  // Calendar on the page (same Cal.com event and namespace as /book, so bookings are tracked the same way).
  const el = document.getElementById('cal-d');
  const calLink = el?.dataset.calLink;
  let started = false;
  const startCal = () => {
    if (started || !el || !calLink) return; started = true;
    (function (C: any, A: string, L: string) {
      const p = (a: any, ar: any) => a.q.push(ar);
      const d = C.document;
      C.Cal = C.Cal || function (...args: any[]) {
        const cal = C.Cal;
        if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement('script')).src = A; cal.loaded = true; }
        if (args[0] === L) {
          const api: any = function (...a: any[]) { p(api, a); };
          const namespace = args[1]; api.q = api.q || [];
          if (typeof namespace === 'string') { cal.ns[namespace] = cal.ns[namespace] || api; p(cal.ns[namespace], args); p(cal, ['initNamespace', namespace]); } else p(cal, args);
          return;
        }
        p(cal, args);
      };
    })(window, 'https://app.cal.com/embed/embed.js', 'init');
    const Cal = (window as any).Cal;
    Cal('init', 'fackt', { origin: 'https://cal.com' });
    const config: Record<string, string> = { layout: 'month_view', theme: 'dark' };
    const vid = (() => { try { return JSON.parse(localStorage.getItem('fj_vid') || 'null'); } catch { return null; } })();
    if (vid) config['metadata[fackt_vid]'] = vid;
    Cal.ns.fackt('inline', { elementOrSelector: '#cal-d', calLink, config });
    Cal.ns.fackt('ui', { theme: 'dark', hideEventTypeDetails: false, layout: 'month_view', cssVarsPerTheme: { dark: { 'cal-brand': '#f2f2f0' } } });
    Cal.ns.fackt('on', { action: 'linkReady', callback: () => el.querySelector('.loading')?.remove() });
  };
  // Load the calendar only when it is close to the screen, so the top of the page stays fast.
  if (el) new IntersectionObserver((es, o) => { if (es.some((e) => e.isIntersecting)) { startCal(); o.disconnect(); } }, { rootMargin: '600px' }).observe(el);
</script>
