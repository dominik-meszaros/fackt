---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Cta from '../../components/Cta.astro';
import Footer from '../../components/Footer.astro';
import { services, industries, site } from '../../data/site';
import { servicePages } from '../../data/servicePages';
const shapes: Record<string, string> = { a: 'M0 0H20V8H8V20H0Z', b: 'M0 0H20V20H12V8H0Z', c: 'M20 0V20H0V12H12V0Z', d: 'M0 0H8V12H20V20H0Z' };
const items = services.map((s) => ({ ...s, page: servicePages.find((p) => p.slug === s.slug)! }));
---
<Base
  title="Services: SaaS product design, web design, motion and branding | Fackt"
  description="Fackt designs SaaS products, websites, motion and brand identities for SaaS and tech companies. Explore our services."
>
  <Nav />
  <main>
    <section class="container top">
      <p class="kicker">Services</p>
      <h1>Everything a SaaS product needs to look and feel world class.</h1>
      <p class="lede">Four services, one team. Most clients start with one and add the rest as they grow.</p>
    </section>
    <section class="container list">
      {items.map((s, i) => (
        <a class={`row tint-${s.page.tint}`} href={`/services/${s.slug}`} data-reveal>
          <div class="card glass">
            <div class="l lift">
              <span class="icon glass" aria-hidden="true"><svg class="lift" width="26" height="26" viewBox="0 0 20 20"><defs><linearGradient id={`si${i}`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#7d89ff" /><stop offset="1" stop-color="#1a28d6" /></linearGradient></defs><path d={shapes[s.shape]} fill={`url(#si${i})`} /></svg></span>
              <span class="n">0{i + 1}</span>
              <h2>{s.title}</h2>
              <p>{s.page.lede}</p>
              <span class="more">Explore {s.title} <span aria-hidden="true">→</span></span>
            </div>
            <ul class="r lift">{s.page.deliverables.map((d) => <li>{d.title}</li>)}</ul>
          </div>
        </a>
      ))}
      <div class="inds"><span class="label">Industries</span>{industries.map((x) => <span class="ind">{x}</span>)}</div>
    </section>
    <Cta />
  </main>
  <Footer />
</Base>

<style>
  .lift { position: relative; z-index: 3; }
  .top { padding-top: 150px; max-width: var(--container); }
  .kicker { margin: 0 0 14px; }
  h1 { margin: 0; font-size: clamp(40px, 5.4vw, 64px); line-height: 1.02; letter-spacing: -0.045em; font-weight: 500; max-width: 900px; }
  .lede { margin: 20px 0 0; font-size: 18px; color: var(--muted); max-width: 560px; line-height: 1.55; }
  .list { padding-top: 64px; display: flex; flex-direction: column; gap: 20px; }
  .row { display: block; border-radius: var(--radius-lg); padding: 18px; text-decoration: none; color: inherit; }
  .card { border-radius: var(--radius-md); padding: 36px; display: grid; grid-template-columns: 1.3fr 1fr; gap: 48px; background: rgba(255,255,255,.78); transition: transform .5s var(--ease-out); }
  .row:hover .card { transform: translateY(-3px); }
  .l { display: flex; flex-direction: column; gap: 14px; }
  .icon { width: 56px; height: 56px; border-radius: 17px; display: flex; align-items: center; justify-content: center; transition: transform .6s var(--ease-spring); }
  .row:hover .icon { transform: rotate(90deg); }
  .n { font-family: var(--mono); font-size: 12px; color: var(--muted-2); }
  h2 { margin: 0; font-size: clamp(28px, 3vw, 36px); letter-spacing: -0.035em; font-weight: 500; }
  p { margin: 0; color: var(--muted); font-size: 16px; line-height: 1.6; max-width: 520px; }
  .more { margin-top: 8px; font-size: 15px; color: var(--blue); display: flex; gap: 6px; }
  .more span { transition: transform .3s var(--ease-spring); }
  .row:hover .more span { transform: translateX(4px); }
  .r { margin: 0; padding: 0; list-style: none; align-self: center; }
  .r li { padding: 13px 0; border-bottom: 1px solid rgba(20,30,90,.08); font-size: 16px; }
  .r li:first-child { border-top: 1px solid rgba(20,30,90,.08); }
  .inds { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-top: 8px; }
  .label { font-family: var(--mono); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--muted-2); margin-right: 8px; }
  .ind { border-radius: 999px; box-shadow: inset 0 0 0 1px var(--line); padding: 7px 12px; font-size: 14px; }
  @media (max-width: 860px) { .card { grid-template-columns: 1fr; gap: 24px; padding: 26px; } }
  @media (max-width: 720px) { .top { padding-top: 112px; } .row { padding: 10px; } .card { padding: 22px; } }
</style>
