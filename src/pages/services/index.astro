---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import SketchDefs from '../../components/home/SketchDefs.astro';
import SvcCta from '../../components/pages/services/SvcCta.astro';
import sketch from '../../generated/sketch.json';
import { services, pricing } from '../../data/site';
import { servicePages } from '../../data/servicePages';

const all = await getCollection('work');
const icon = (slug: string) => ((sketch.services as Record<string, string>)[slug] ?? '').replace('class="sk"', 'class="si"');
const items = services.map((s) => {
  const page = servicePages.find((p) => p.slug === s.slug)!;
  const w = page.work.map((k) => all.find((e) => e.id === k)).find(Boolean);
  return { ...s, page, recent: w ? { slug: w.id, ...w.data } : null };
});
const short = (t: string) => t.split(' &')[0].toLowerCase();
const CK = '<svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5L10 17.5L19 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>';
---
<Base
  image="/og/services.jpg"
  title="Services: SaaS product design, web design, motion and branding | Fackt"
  description="Fackt designs SaaS products, websites, motion and brand identities for SaaS and tech companies. Explore our services."
>
  <div class="m-page">
    <SketchDefs />
    <Nav />
    <main>
      <section class="wrap hd">
        <nav class="crumb" aria-label="Breadcrumb"><a href="/">Fackt</a><span>/</span><b aria-current="page">Services</b></nav>
        <h1>Everything a SaaS product needs<br class="br" /> to look and feel world class.</h1>
        <p class="lede">Four services, one team. Most clients start with one and add the rest as they grow.</p>
      </section>

      <section class="wrap list">
        {items.map((s, i) => (
          <a class="row" href={`/services/${s.slug}`}>
            <Fragment set:html={icon(s.slug)} />
            <div class="tx">
              <span class="n">0{i + 1}</span>
              <h2>{s.title}</h2>
              <p>{s.page.lede}</p>
              <span class="lnk">See {short(s.title)} &#8594;</span>
            </div>
            <ul>{s.page.deliverables.slice(0, 5).map((d) => <li><Fragment set:html={CK} />{d.title}</li>)}</ul>
            <div class="ex">
              <span class="exl">Recent project</span>
              {s.recent ? (
                <>
                  <span class:list={['exi', { ph: s.recent.imageKind === 'phone' && !s.recent.preview, pv: !!s.recent.preview }]}><img src={s.recent.preview ?? s.recent.image} alt={`${s.recent.name}, ${s.recent.service.toLowerCase()} by Fackt`} loading="lazy" decoding="async" /></span>
                  <b>{s.recent.name}</b><small>{s.recent.service}</small>
                </>
              ) : (
                <>
                  <span class="exi none">Examples on request</span>
                  <small>Ask on a free call</small>
                </>
              )}
            </div>
          </a>
        ))}
      </section>

      <section class="wrap pr">
        <span class="eb">Pricing</span>
        <h2 class="h2">Every service, two ways to work.</h2>
        <div class="both">
          <div class="card k">
            <span class="nm">Monthly retainer</span>
            <div class="big">{pricing.retainer.price}<small>{pricing.retainer.period}</small></div>
            <p>Unlimited requests across every service, one active at a time.</p>
          </div>
          <div class="card">
            <span class="nm">One-time project</span>
            <div class="big"><small class="pre">{pricing.project.prefix}</small>{pricing.project.price}</div>
            <p>Fixed scope, milestones over 4 to 12 weeks.</p>
          </div>
        </div>
        <a class="lnk more" href="/#pricing">Compare plans &#8594;</a>
      </section>

      <SvcCta />
    </main>
    <Footer />
  </div>
</Base>

<style>
  .wrap { width: min(960px, 100% - 32px); margin: 0 auto; }
  .hd { padding: 56px 0 8px; }
  .crumb { font-size: 12.5px; color: #8a8a86; display: flex; gap: 8px; align-items: center; }
  .crumb a { color: inherit; text-decoration: none; }
  .crumb a:hover { color: #111; }
  .crumb b { color: #111; font-weight: 500; }
  h1 { margin: 14px 0 0; font-family: var(--m-serif); font-weight: 400; font-size: 52px; line-height: 1.06; letter-spacing: -.02em; }
  .lede { margin: 14px 0 0; color: #6a6a66; font-size: 16px; max-width: 560px; }

  .list { padding-top: 36px; }
  .row { display: grid; grid-template-columns: 72px 1fr 260px 180px; gap: 28px; align-items: start; padding: 32px 0; border-top: 1px solid #dcdcd8; color: inherit; text-decoration: none; }
  .row:last-child { border-bottom: 1px solid #dcdcd8; }
  .row :global(.si) { display: block; width: 64px; height: 64px; overflow: visible; }
  .n { font-size: 12px; color: #8a8a86; display: block; margin-bottom: 6px; }
  .row h2 { margin: 0; font-family: var(--m-serif); font-weight: 400; font-size: 28px; line-height: 1.15; }
  .row p { margin: 8px 0 0; color: #6a6a66; font-size: 14.5px; max-width: 400px; }
  .lnk { display: inline-block; font-weight: 500; font-size: 13.5px; color: #111; text-decoration: none; border-bottom: 1px solid #111; }
  .tx .lnk { margin-top: 14px; }
  .row:hover .lnk { border-bottom-width: 2px; }
  .row:hover h2 { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 7px; font-size: 13.5px; }
  li { display: flex; gap: 8px; align-items: center; }
  li :global(svg) { flex-shrink: 0; }
  .ex { display: flex; flex-direction: column; }
  .exl { font-size: 11px; font-weight: 500; letter-spacing: .04em; text-transform: uppercase; color: #8a8a86; margin-bottom: 8px; }
  .exi { position: relative; display: block; height: 112px; border-radius: 3px; background: #f2f2f0; box-shadow: inset 0 0 0 1px #e2e2de; overflow: hidden; }
  .exi img { position: absolute; left: 16px; top: 16px; width: 200px; border-radius: 2px; box-shadow: 0 0 0 1px #111; transition: transform .4s var(--m-ease); }
  .row:hover .exi img { transform: translateY(-3px); }
  .exi.ph img { left: 50%; width: 62px; translate: -50% 0; border-radius: 8px; }
  .exi.pv { background: #fff; }
  .exi.pv::after { content: ''; position: absolute; inset: 0; border-radius: inherit; box-shadow: inset 0 0 0 1px #e2e2de; pointer-events: none; }
  .exi.pv img, .row:hover .exi.pv img { left: 0; top: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; transform: none; border-radius: 0; box-shadow: none; }
  .exi.none { display: grid; place-items: center; font-size: 12.5px; color: #6a6a66; }
  .ex b { display: block; margin-top: 10px; font-weight: 500; font-size: 13.5px; }
  .ex small { display: block; margin-top: 2px; font-size: 12.5px; color: #8a8a86; }

  .pr { padding-top: 56px; }
  .eb { font-size: 12.5px; color: #8a8a86; display: block; margin-bottom: 10px; }
  .h2 { margin: 0; font-family: var(--m-serif); font-weight: 400; font-size: 30px; line-height: 1.15; letter-spacing: -.01em; }
  .both { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 20px; }
  .card { border-radius: 4px; padding: 26px 28px; background: #f2f2f0; }
  .card.k { background: #111; color: #fff; }
  .nm { font-size: 13.5px; }
  .big { font-family: var(--m-serif); font-size: 36px; line-height: 1; margin-top: 14px; }
  .big small { font-family: Geist, system-ui, sans-serif; font-size: 13px; color: #8a8a86; margin-left: 4px; }
  .big small.pre { margin: 0 6px 0 0; }
  .card p { margin: 10px 0 0; font-size: 14px; color: #6a6a66; }
  .card.k p { color: #b2b2ae; }
  .more { margin-top: 16px; }

  @media (max-width: 1000px) {
    .row { grid-template-columns: 64px 1fr 1fr; }
    .ex { grid-column: 2 / -1; max-width: 320px; }
  }
  @media (max-width: 720px) {
    .hd { padding-top: 28px; }
    h1 { font-size: 36px; }
    .br { display: none; }
    .lede { font-size: 14.5px; }
    .list { padding-top: 24px; }
    .row { grid-template-columns: 1fr; gap: 14px; padding: 24px 0; }
    .row :global(.si) { width: 56px; height: 56px; }
    .ex { grid-column: auto; max-width: none; }
    .exi { height: 150px; }
    .exi img { width: 280px; }
    .exi.ph img { width: 84px; border-radius: 12px; }
    .pr { padding-top: 40px; }
    .h2 { font-size: 26px; }
    .both { grid-template-columns: 1fr; }
  }
</style>
