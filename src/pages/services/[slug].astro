---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Work from '../../components/Work.astro';
import Cta from '../../components/Cta.astro';
import Footer from '../../components/Footer.astro';
import { services, site, reviews, rating, testimonials, pricing } from '../../data/site';
import { servicePages } from '../../data/servicePages';

export function getStaticPaths() {
  return servicePages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}
const { page } = Astro.props;
const card = services.find((s) => s.slug === page.slug)!;
const others = services.filter((s) => s.slug !== page.slug);
const all = await getCollection('work');
const work = page.work
  .map((slug) => all.find((e) => e.id === slug))
  .filter(Boolean)
  .map((e) => ({ slug: e!.id, ...e!.data }));
const review = reviews[page.review];
const faces = testimonials.slice(0, 5);
const shapes: Record<string, string> = { a: 'M0 0H20V8H8V20H0Z', b: 'M0 0H20V20H12V8H0Z', c: 'M20 0V20H0V12H12V0Z', d: 'M0 0H8V12H20V20H0Z' };

const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: card.title,
    serviceType: card.title,
    description: page.seoDescription,
    provider: { '@type': 'ProfessionalService', name: site.name, url: site.url },
    areaServed: 'Worldwide',
    url: new URL(`/services/${page.slug}`, site.url).toString(),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: page.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Base title={page.seoTitle} description={page.seoDescription} image={work[0]?.image}>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <Nav />
  <main>
    <section class="container hero">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Fackt</a><span>/</span><a href="/services">Services</a><span>/</span><span aria-current="page">{card.title}</span></nav>
      <div class="intro">
        <div class="intro-l">
          <span class="icon glass" aria-hidden="true">
            <svg width="30" height="30" viewBox="0 0 20 20"><defs><linearGradient id="svh" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#7d89ff" /><stop offset="1" stop-color="#1a28d6" /></linearGradient></defs><path d={shapes[card.shape]} fill="url(#svh)" /></svg>
          </span>
          <p class="kicker">{card.title}</p>
          <h1>{page.headline}</h1>
        </div>
        <div class="intro-r">
          <p>{page.lede}</p>
          <div class="ctas">
            <a class="btn btn-dark" href={site.bookPage}>Book a strategy call</a>
            {work.length > 0
              ? <a class="btn glass" href="#work"><span class="lift">See the work</span></a>
              : <a class="btn glass" href="/#testimonials"><span class="lift">Hear from clients</span></a>}
          </div>
          <ul class="tags">{card.tags.map((t) => <li>{t}</li>)}</ul>
        </div>
      </div>

      <div class:list={['stage', `tint-${page.tint}`, { single: work.length === 1, motion: work.length === 0 }]}>
        {work.length > 0 ? (
          <>
            {work.slice(0, 2).map((p, i) => (
              <img class:list={['shot', `s${i}`, p.imageKind]} src={p.image} alt={`${p.name}, ${p.service.toLowerCase()} by Fackt`} loading={i === 0 ? 'eager' : 'lazy'} />
            ))}
            <span class="badge glass"><span class="lift"><b>{work[0].name}</b> {work[0].service}</span></span>
          </>
        ) : (
          <div class="orbit" aria-hidden="true">
            {['a', 'b', 'c', 'd'].map((k, i) => (
              <span class={`tile glass t${i}`}><svg class="lift" width="54" height="54" viewBox="0 0 20 20"><defs><linearGradient id={`mo${i}`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#7d89ff" /><stop offset="1" stop-color="#1a28d6" /></linearGradient></defs><path d={shapes[k]} fill={`url(#mo${i})`} /></svg></span>
            ))}
          </div>
        )}
      </div>
    </section>

    <section class="container section">
      <div class="head" data-reveal><p class="kicker">What you get</p><h2 class="h2">Deliverables</h2></div>
      <div class="deliv">
        {page.deliverables.map((d, i) => (
          <div class="dcard" data-reveal style={`transition-delay:${(i % 3) * 60}ms`}>
            <span class="n">0{i + 1}</span>
            <h3>{d.title}</h3>
            <p>{d.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="container section">
      <div class="head" data-reveal><p class="kicker">How it works</p><h2 class="h2">From first call to shipped.</h2></div>
      <ol class="process tint-blue">
        {page.process.map((s, i) => (
          <li class="step glass" data-reveal style={`transition-delay:${i * 70}ms`}>
            <span class="lift n">Step {i + 1}</span>
            <b class="lift">{s.title}</b>
            <span class="lift t">{s.text}</span>
          </li>
        ))}
      </ol>
      <div class="tools"><span class="label">Tools</span>{page.tools.map((t) => <span class="tool">{t}</span>)}</div>
    </section>

    {work.length > 0 && <Work projects={work} total={all.length} title={`${card.title} work`} />}

    <section class="container section proof">
      <figure class="quote" data-reveal>
        <blockquote>"{review.text}"</blockquote>
        <figcaption>
          <span class="faces" aria-hidden="true">{faces.map((f) => <img src={`/uploads/${f.id}.webp`} alt="" width="36" height="36" loading="lazy" />)}</span>
          <span><b>{review.name}</b>, {review.role}<br /><small>Rated {rating.value} out of 5 on {rating.source} · <a href="/#testimonials">Watch 10 video testimonials</a></small></span>
        </figcaption>
      </figure>
      <div class="price tint-peach" data-reveal>
        <div class="glass pin">
          <span class="lift label">Pricing</span>
          <span class="lift big">{pricing.retainer.price}<small> {pricing.retainer.period}</small></span>
          <span class="lift sub">Retainer, pause or cancel any time</span>
          <span class="lift line"></span>
          <span class="lift big2"><small>{pricing.project.prefix} </small>{pricing.project.price}</span>
          <span class="lift sub">One-time project, fixed scope</span>
          <a class="lift link" href="/#pricing">Compare plans →</a>
        </div>
      </div>
    </section>

    <section class="container section faq">
      <div class="head" data-reveal><p class="kicker">FAQ</p><h2 class="h2">Questions about {card.title.toLowerCase()}.</h2></div>
      <div class="qs">
        {page.faq.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}<span class="pm" aria-hidden="true"></span></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="container section">
      <div class="head" data-reveal><p class="kicker">More services</p></div>
      <div class="others">
        {others.map((s) => (
          <a class="other" href={`/services/${s.slug}`}>
            <span class="oi glass" aria-hidden="true"><svg class="lift" width="18" height="18" viewBox="0 0 20 20"><path d={shapes[s.shape]} fill="#2335ff" /></svg></span>
            <span class="ot">{s.title}</span>
            <span class="oa" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </section>

    <Cta />
  </main>
  <Footer />
</Base>

<style>
  .lift { position: relative; z-index: 3; }
  .hero { padding-top: 130px; }
  .crumbs { display: flex; gap: 8px; font-size: 14px; color: var(--muted-2); margin-bottom: 36px; }
  .crumbs a { text-decoration: none; color: var(--muted); }
  .crumbs a:hover { color: var(--ink); }
  .intro { display: flex; justify-content: space-between; align-items: flex-end; gap: 48px; }
  .intro-l { display: flex; flex-direction: column; gap: 16px; max-width: 700px; }
  .icon { width: 64px; height: 64px; border-radius: 20px; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, rgba(255,255,255,.95), rgba(255,255,255,.6)); margin-bottom: 8px; }
  .icon svg { position: relative; z-index: 3; }
  .kicker { margin: 0; }
  h1 { margin: 0; font-size: clamp(40px, 5.2vw, 64px); line-height: 1.02; letter-spacing: -0.045em; font-weight: 500; }
  .intro-r { max-width: 400px; display: flex; flex-direction: column; gap: 20px; padding-bottom: 6px; }
  .intro-r p { margin: 0; color: var(--muted); font-size: 16px; line-height: 1.6; }
  .ctas { display: flex; gap: 10px; flex-wrap: wrap; }
  .tags { margin: 0; padding: 0; list-style: none; display: flex; gap: 6px; flex-wrap: wrap; }
  .tags li { border-radius: 999px; background: #f4f5f8; padding: 6px 11px; font-size: 13px; color: var(--ink-2); }

  .stage { position: relative; margin-top: 56px; height: 560px; border-radius: var(--radius-lg); overflow: hidden; box-shadow: inset 0 0 0 1px rgba(20,30,90,.05); }
  .shot { position: absolute; border-radius: 12px; box-shadow: 0 40px 80px rgba(20,30,90,.16), 0 0 0 1px rgba(20,30,90,.05); }
  .shot.s0 { left: 8%; top: 70px; width: 62%; }
  .shot.s1 { right: 6%; top: 150px; width: 44%; opacity: .98; }
  .shot.phone.s0 { width: 260px; left: 18%; border-radius: 40px; }
  .shot.phone.s1 { width: 230px; right: 18%; border-radius: 36px; }
  .stage.single .shot.s0 { left: 50%; transform: translateX(-50%); width: 66%; }
  .orbit { position: absolute; inset: 0; display: grid; place-items: center; }
  .tile { position: absolute; width: 120px; height: 120px; border-radius: 34px; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, rgba(255,255,255,.85), rgba(255,255,255,.45)); animation: turn 6s var(--ease-spring) infinite; }
  .tile svg { animation: spin4 6s var(--ease-spring) infinite; }
  .t0 { transform: translate(-90px, -90px); }
  .t1 { transform: translate(90px, -90px); animation-delay: -1.5s; }
  .t2 { transform: translate(-90px, 90px); animation-delay: -3s; }
  .t3 { transform: translate(90px, 90px); animation-delay: -4.5s; }
  .t1 svg { animation-delay: -1.5s; } .t2 svg { animation-delay: -3s; } .t3 svg { animation-delay: -4.5s; }
  @keyframes spin4 { 0%, 15% { transform: rotate(0); } 25%, 40% { transform: rotate(90deg); } 50%, 65% { transform: rotate(180deg); } 75%, 90% { transform: rotate(270deg); } 100% { transform: rotate(360deg); } }
  @keyframes turn { 0%, 100% { translate: 0 0; } 50% { translate: 0 -10px; } }
  .badge { position: absolute; left: 24px; bottom: 24px; border-radius: 999px; padding: 10px 16px; font-size: 14px; }
  .badge b { font-weight: 500; margin-right: 6px; }

  .section { padding-top: 120px; }
  .head { margin-bottom: 28px; }
  .head .kicker { margin-bottom: 12px; }
  .deliv { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .dcard { border-radius: var(--radius-md); box-shadow: 0 0 0 1px var(--line); padding: 26px; display: flex; flex-direction: column; gap: 10px; transition: box-shadow .3s; }
  .dcard:hover { box-shadow: 0 0 0 1px var(--line), 0 18px 40px rgba(20,30,90,.07); }
  .dcard .n { font-family: var(--mono); font-size: 12px; color: var(--blue); }
  .dcard h3 { margin: 6px 0 0; font-size: 21px; letter-spacing: -0.02em; font-weight: 500; }
  .dcard p { margin: 0; color: var(--muted); font-size: 15px; line-height: 1.55; }

  .process { margin: 0; padding: 20px; list-style: none; border-radius: var(--radius-lg); display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; counter-reset: s; }
  .step { border-radius: 20px; padding: 24px; display: flex; flex-direction: column; gap: 8px; background: rgba(255,255,255,.72); min-height: 190px; }
  .step .n { font-family: var(--mono); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--muted-2); }
  .step b { font-size: 20px; font-weight: 500; letter-spacing: -0.02em; margin-top: auto; }
  .step .t { color: var(--muted); font-size: 15px; line-height: 1.5; }
  .tools { display: flex; align-items: center; gap: 8px; margin-top: 18px; flex-wrap: wrap; }
  .label { font-family: var(--mono); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--muted-2); margin-right: 8px; }
  .tool { border-radius: 999px; box-shadow: inset 0 0 0 1px var(--line); padding: 7px 12px; font-size: 14px; }

  .proof { display: grid; grid-template-columns: 1.5fr 1fr; gap: 20px; align-items: stretch; }
  .quote { margin: 0; border-radius: var(--radius-lg); background: #fafbfc; box-shadow: inset 0 0 0 1px var(--line); padding: 40px; display: flex; flex-direction: column; justify-content: space-between; gap: 28px; }
  .quote blockquote { margin: 0; font-size: clamp(20px, 2.2vw, 26px); line-height: 1.4; letter-spacing: -0.02em; }
  .quote figcaption { display: flex; align-items: center; gap: 14px; font-size: 15px; color: var(--muted); }
  .quote b { color: var(--ink); font-weight: 500; }
  .quote small a { color: var(--blue); text-decoration: none; }
  .faces { display: flex; flex-shrink: 0; }
  .faces img { width: 36px; height: 36px; border-radius: 50%; object-fit: cover; border: 2px solid #fff; margin-left: -9px; }
  .faces img:first-child { margin-left: 0; }
  .price { border-radius: var(--radius-lg); padding: 18px; display: flex; }
  .pin { flex: 1; border-radius: var(--radius-md); padding: 28px; display: flex; flex-direction: column; gap: 6px; background: rgba(255,255,255,.75); }
  .pin .label { margin-bottom: 10px; }
  .big, .big2 { font-size: 44px; letter-spacing: -0.045em; font-weight: 500; line-height: 1.05; }
  .big small, .big2 small { font-size: 16px; color: #6b7080; letter-spacing: 0; }
  .sub { font-size: 14px; color: var(--muted); }
  .line { height: 1px; background: rgba(20,30,90,.08); margin: 14px 0; }
  .link { margin-top: auto; padding-top: 16px; text-decoration: none; font-size: 14px; color: var(--ink-2); }

  .qs { border-top: 1px solid var(--line); }
  details { border-bottom: 1px solid var(--line); }
  summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 20px; padding: 24px 0; font-size: 20px; letter-spacing: -0.02em; }
  summary::-webkit-details-marker { display: none; }
  .pm { width: 14px; height: 14px; position: relative; flex-shrink: 0; }
  .pm::before, .pm::after { content: ""; position: absolute; left: 0; top: 6px; width: 14px; height: 2px; background: var(--ink); border-radius: 2px; transition: transform .3s var(--ease-spring); }
  .pm::after { transform: rotate(90deg); }
  details[open] .pm::after { transform: rotate(0); }
  details p { margin: -6px 0 24px; max-width: 720px; color: var(--muted); font-size: 17px; line-height: 1.6; }

  .others { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .other { display: flex; align-items: center; gap: 14px; padding: 18px; border-radius: 20px; box-shadow: inset 0 0 0 1px var(--line); text-decoration: none; font-size: 18px; letter-spacing: -0.01em; transition: box-shadow .3s; }
  .other:hover { box-shadow: inset 0 0 0 1px var(--line), 0 14px 30px rgba(20,30,90,.07); }
  .oi { width: 42px; height: 42px; border-radius: 13px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .oa { margin-left: auto; color: var(--muted-2); transition: transform .3s var(--ease-spring); }
  .other:hover .oa { transform: translateX(4px); color: var(--ink); }

  @media (max-width: 960px) {
    .intro { flex-direction: column; align-items: flex-start; gap: 24px; }
    .deliv { grid-template-columns: 1fr 1fr; }
    .process { grid-template-columns: 1fr 1fr; }
    .proof { grid-template-columns: 1fr; }
    .others { grid-template-columns: 1fr; }
  }
  @media (max-width: 720px) {
    .hero { padding-top: 104px; }
    .crumbs { margin-bottom: 24px; }
    .stage { height: 340px; margin-top: 36px; }
    .shot.s0 { width: 92%; left: 4%; top: 40px; }
    .shot.s1 { display: none; }
    .shot.phone.s0 { width: 190px; left: 50%; transform: translateX(-50%); }
    .stage.single .shot.s0 { width: 92%; }
    .tile { width: 84px; height: 84px; border-radius: 24px; }
    .tile svg { width: 38px; height: 38px; }
    .t0 { transform: translate(-56px, -56px); } .t1 { transform: translate(56px, -56px); } .t2 { transform: translate(-56px, 56px); } .t3 { transform: translate(56px, 56px); }
    .section { padding-top: 88px; }
    .deliv, .process { grid-template-columns: 1fr; }
    .process { padding: 10px; gap: 10px; }
    .step { min-height: 0; }
    .quote { padding: 26px; }
    summary { font-size: 18px; }
  }
</style>
