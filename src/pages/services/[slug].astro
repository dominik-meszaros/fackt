---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import SketchDefs from '../../components/home/SketchDefs.astro';
import SvcCta from '../../components/pages/services/SvcCta.astro';
import sketch from '../../generated/sketch.json';
import audit from '../../content/settings/audit.json';
import { services, site, reviews } from '../../data/site';
import { servicePages } from '../../data/servicePages';

export function getStaticPaths() {
  return servicePages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}
const { page } = Astro.props;
const card = services.find((s) => s.slug === page.slug)!;
const all = await getCollection('work');
const work = page.work
  .map((slug) => all.find((e) => e.id === slug))
  .filter(Boolean)
  .slice(0, 4)
  .map((e) => ({ slug: e!.id, ...e!.data }));
const review = reviews[page.review];
const art = ((sketch.services as Record<string, string>)[page.slug] ?? '').replace('class="sk"', 'class="art-i"');
const sentence = card.title.charAt(0) + card.title.slice(1).toLowerCase();
const auditLabel = page.slug === 'product-design' ? 'Get a free UX audit' : 'Get a free audit';
const pad = (n: number) => String(n).padStart(2, '0');

const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: card.title,
    serviceType: card.title,
    description: page.seoDescription,
    provider: { '@type': 'ProfessionalService', name: site.name, url: site.url },
    areaServed: 'Worldwide',
    url: new URL(`/services/${page.slug}`, site.url).toString(),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: page.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Base title={page.seoTitle} description={page.seoDescription} image={work[0]?.image}>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <div class="m-page">
    <SketchDefs />
    <Nav />
    <main>
      <section class="wrap">
        <div class="hero">
          <div>
            <nav class="crumb" aria-label="Breadcrumb"><a href="/services">Services</a><span>/</span><b aria-current="page">{card.title}</b></nav>
            <h1>{page.headline}</h1>
            <p class="lede">{page.lede}</p>
            <div class="bs">
              <a class="m-btn dk" href={site.bookPage}>Book a free call</a>
              <a class="m-btn lt" href="/audit">{auditLabel}</a>
            </div>
          </div>
          <div class="art" aria-hidden="true"><Fragment set:html={art} /></div>
        </div>

        {work.length > 0 && (
          <div class="strip">
            {work.map((p, i) => (
              <a href={`/work/${p.slug}`}>
                <div class:list={['im', { ph: p.imageKind === 'phone' }]}>
                  <img src={p.image} alt={`${p.name}, ${p.service.toLowerCase()} by Fackt`} loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
                </div>
                <span><b>{p.name}</b> <span class="mu">&#183; {p.service}</span></span>
              </a>
            ))}
          </div>
        )}
      </section>

      <section class="wrap sec">
        <span class="eb">What you get</span>
        <h2 class="h2">Everything included.</h2>
        <div class="dlg">
          {page.deliverables.map((d, i) => (
            <div><i>{pad(i + 1)}</i><b>{d.title}</b><p>{d.text}</p></div>
          ))}
        </div>
      </section>

      <section class="wrap sec">
        <span class="eb">How it works</span>
        <h2 class="h2">{page.process.length} steps, short review cycles.</h2>
        <ol class="proc">
          {page.process.map((s, i) => (
            <li><i>Step {pad(i + 1)}</i><b>{s.title}</b><p>{s.text}</p></li>
          ))}
        </ol>
      </section>

      <section class="wrap sec2">
        {review && (
          <figure class="quote">
            <blockquote>&#8220;{review.text}&#8221;</blockquote>
            <figcaption><b>{review.name}</b>, {review.role}</figcaption>
          </figure>
        )}
        <div class="band">
          <div><b>Not sure where to start?</b><p>Get a free audit of your product: a video and a written list of fixes, {audit.turnaround.toLowerCase()}.</p></div>
          <a class="m-btn dk" href="/audit">Get a free audit</a>
        </div>
      </section>

      <section class="wrap faqs">
        <div><span class="eb">Questions</span><h2 class="h2">{sentence}, answered.</h2></div>
        <div class="faq">
          {page.faq.map((f, i) => (
            <details open={i === 0}>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <SvcCta />
    </main>
    <Footer />
  </div>
</Base>

<style>
  .wrap { width: min(960px, 100% - 32px); margin: 0 auto; }
  .crumb { font-size: 12.5px; color: #8a8a86; display: flex; gap: 8px; align-items: center; }
  .crumb a { color: inherit; text-decoration: none; }
  .crumb a:hover { color: #111; }
  .crumb b { color: #111; font-weight: 500; }
  .hero { padding: 48px 0 0; display: grid; grid-template-columns: 1fr 360px; gap: 48px; align-items: center; }
  h1 { margin: 14px 0 0; font-family: var(--m-serif); font-weight: 400; font-size: 48px; line-height: 1.06; letter-spacing: -.02em; }
  .lede { margin: 14px 0 0; color: #6a6a66; font-size: 16px; max-width: 560px; }
  .bs { display: flex; gap: 8px; margin-top: 24px; }
  .bs .m-btn, .band .m-btn { height: 44px; padding: 0 18px; font-size: 14.5px; }
  .art { height: 300px; border-radius: 4px; background: #f2f2f0; box-shadow: inset 0 0 0 1px #dcdcd8; display: grid; place-items: center; }
  .art :global(.art-i) { display: block; width: 170px; height: 170px; overflow: visible; }

  .strip { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-top: 48px; }
  .strip a { color: inherit; text-decoration: none; }
  .im { height: 150px; border-radius: 3px; background: #f2f2f0; box-shadow: inset 0 0 0 1px #e2e2de; position: relative; overflow: hidden; }
  .im img { position: absolute; left: 50%; top: 18px; width: 86%; translate: -50% 0; border-radius: 2px; box-shadow: 0 0 0 1px #111; transition: transform .4s var(--m-ease); }
  .im.ph img { width: 70px; border-radius: 9px; }
  .strip a:hover img { transform: translateY(-4px); }
  .strip a > span { display: block; margin-top: 8px; font-size: 13px; }
  .strip b { font-weight: 500; }
  .mu { color: #8a8a86; }

  .sec { padding-top: 64px; }
  .eb { font-size: 12.5px; color: #8a8a86; display: block; margin-bottom: 10px; }
  .h2 { margin: 0; font-family: var(--m-serif); font-weight: 400; font-size: 30px; line-height: 1.15; letter-spacing: -.01em; }
  .dlg { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 28px; border-top: 1px solid #dcdcd8; }
  .dlg div { padding: 22px 22px 22px 0; border-bottom: 1px solid #ececea; }
  .dlg div:not(:nth-child(3n+1)) { padding-left: 22px; border-left: 1px solid #ececea; }
  .dlg i, .proc i { font-style: normal; font-size: 12px; color: #8a8a86; }
  .dlg b { display: block; margin-top: 8px; font-weight: 500; font-size: 15px; }
  .dlg p, .proc p { margin: 6px 0 0; font-size: 13.5px; color: #6a6a66; }

  /* process: a bar fills left to right and each step lights up as it passes */
  .proc { list-style: none; margin: 28px 0 0; padding: 0; position: relative; display: grid; grid-template-columns: repeat(4, 1fr); }
  .proc li { position: relative; padding: 18px 18px 0 0; border-top: 2px solid #dcdcd8; }
  .proc::after { content: ''; position: absolute; left: 0; top: 0; height: 2px; width: 0; background: #111; animation: pbar 8s linear infinite; }
  .proc li::before { content: ''; position: absolute; left: 0; top: -7px; width: 12px; height: 12px; background: #fff; box-shadow: inset 0 0 0 2px #111; z-index: 1; }
  .proc li:nth-child(1)::before { animation: pd1 8s linear infinite; }
  .proc li:nth-child(2)::before { animation: pd2 8s linear infinite; }
  .proc li:nth-child(3)::before { animation: pd3 8s linear infinite; }
  .proc li:nth-child(4)::before { animation: pd4 8s linear infinite; }
  .proc li:nth-child(1) b { animation: pt1 8s linear infinite; }
  .proc li:nth-child(2) b { animation: pt2 8s linear infinite; }
  .proc li:nth-child(3) b { animation: pt3 8s linear infinite; }
  .proc li:nth-child(4) b { animation: pt4 8s linear infinite; }
  .proc b { display: block; margin-top: 6px; font-weight: 500; }
  @keyframes pbar { 0% { width: 0; opacity: 1 } 85% { width: 100%; opacity: 1 } 96% { width: 100%; opacity: 0 } 100% { width: 0; opacity: 0 } }
  @keyframes pd1 { 0% { background: #111; transform: scale(1.3) } 4% { transform: scale(1) } 92% { background: #111 } 100% { background: #fff } }
  @keyframes pd2 { 0%, 20% { background: #fff; transform: scale(1) } 21% { background: #111; transform: scale(1.3) } 25% { transform: scale(1) } 92% { background: #111 } 100% { background: #fff } }
  @keyframes pd3 { 0%, 41% { background: #fff; transform: scale(1) } 42% { background: #111; transform: scale(1.3) } 46% { transform: scale(1) } 92% { background: #111 } 100% { background: #fff } }
  @keyframes pd4 { 0%, 63% { background: #fff; transform: scale(1) } 64% { background: #111; transform: scale(1.3) } 68% { transform: scale(1) } 92% { background: #111 } 100% { background: #fff } }
  @keyframes pt1 { 0%, 92% { color: #111 } 100% { color: #a3a3a0 } }
  @keyframes pt2 { 0%, 20% { color: #a3a3a0 } 21%, 92% { color: #111 } 100% { color: #a3a3a0 } }
  @keyframes pt3 { 0%, 41% { color: #a3a3a0 } 42%, 92% { color: #111 } 100% { color: #a3a3a0 } }
  @keyframes pt4 { 0%, 63% { color: #a3a3a0 } 64%, 92% { color: #111 } 100% { color: #a3a3a0 } }
  @media (prefers-reduced-motion: reduce) {
    .proc::after { animation: none; width: 100%; }
    .proc li::before, .proc li b { animation: none; }
    .proc li::before { background: #111; }
  }

  .sec2 { padding-top: 56px; }
  .quote { margin: 0; padding: 28px 32px; border-radius: 4px; background: #f4f4f2; }
  .quote blockquote { margin: 0; font-family: var(--m-serif); font-style: italic; font-size: 20px; line-height: 1.4; }
  .quote figcaption { margin-top: 10px; font-size: 13px; color: #8a8a86; }
  .quote figcaption b { color: #111; font-weight: 500; }
  .band { display: flex; justify-content: space-between; align-items: center; gap: 20px; padding: 22px 26px; border-radius: 4px; box-shadow: 0 0 0 1px #111, 4px 4px 0 #111; margin-top: 48px; }
  .band b { font-weight: 500; font-size: 16px; }
  .band p { margin: 4px 0 0; font-size: 13.5px; color: #6a6a66; }

  .faqs { display: grid; grid-template-columns: 300px 1fr; gap: 56px; padding: 56px 0 8px; }
  .faq { border-top: 1px solid #dcdcd8; }
  details { border-bottom: 1px solid #ececea; padding: 18px 0; }
  summary { list-style: none; display: flex; justify-content: space-between; gap: 20px; font-weight: 500; font-size: 15px; cursor: pointer; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; font-weight: 400; color: #8a8a86; }
  details[open] summary::after { content: '\2212'; }
  details p { margin: 10px 0 0; color: #6a6a66; font-size: 14px; max-width: 640px; }

  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; gap: 28px; }
    .art { height: 220px; }
    .strip { grid-template-columns: repeat(2, 1fr); }
    .dlg { grid-template-columns: 1fr 1fr; }
    .dlg div:not(:nth-child(3n+1)) { padding-left: 0; border-left: 0; }
    .dlg div:nth-child(2n) { padding-left: 22px; border-left: 1px solid #ececea; }
    .faqs { grid-template-columns: 1fr; gap: 16px; }
  }
  @media (max-width: 720px) {
    .hero { gap: 24px; padding-top: 24px; }
    h1 { font-size: 34px; }
    .lede { font-size: 14.5px; }
    .bs { flex-direction: column; }
    .art { height: 180px; }
    .art :global(.art-i) { width: 110px; height: 110px; }
    .strip { margin-top: 32px; }
    .im { height: 110px; }
    .im.ph img { width: 54px; top: 14px; }
    .sec { padding-top: 48px; }
    .h2 { font-size: 26px; }
    .dlg { grid-template-columns: 1fr; }
    .dlg div, .dlg div:nth-child(2n) { padding: 16px 0; border-left: 0; }
    .proc { grid-template-columns: 1fr; gap: 18px; }
    .proc::after { display: none; }
    .quote { padding: 22px 20px; }
    .quote blockquote { font-size: 17px; }
    .band { flex-direction: column; align-items: flex-start; }
    .band .m-btn { width: 100%; }
    .faqs { padding-top: 40px; }
  }
</style>
