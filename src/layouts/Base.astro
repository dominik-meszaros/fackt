---
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/mono.css';
import { site } from '../data/site';

interface Props {
  lcp?: string; // main above-the-fold image, preloaded so it starts downloading right away
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  type?: string;
  schema?: Record<string, unknown>[];
}
const { title = site.title, description = site.description, image = '/og/home.jpg', noindex = false, type = 'website', schema = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).toString();
const ld = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  url: site.url,
  email: site.email,
  description: site.description,
  areaServed: 'Worldwide',
  address: { '@type': 'PostalAddress', addressCountry: 'SK' },
  logo: new URL('/icon-512.png', site.url).toString(),
  image: new URL('/og/home.jpg', site.url).toString(),
  founder: { '@type': 'Person', name: 'Dominik Mészáros' },
  sameAs: site.socials.map((s) => s.href),
};
const web = { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: site.url };
// ?v= changes when the preview images are redrawn, so LinkedIn and X fetch the new file instead of their cached copy.
const ogImage = new URL(image, site.url).toString() + (image.startsWith('/og/') ? '?v=3' : '');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico?v=2" sizes="48x48" />
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <meta name="theme-color" content="#ffffff" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:site_name" content="Fackt" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:site" content="@kcinimoDM" />
    <meta name="twitter:image" content={ogImage} />
    {Astro.props.lcp && <link rel="preload" as="image" href={Astro.props.lcp} fetchpriority="high" />}
    <link rel="preload" href="/fonts/geist-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/newsreader-latin-opsz-normal.woff2" as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify([ld, web, ...schema])} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <slot />
    <script>
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => {
            if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
          }),
          { rootMargin: '0px 0px -8% 0px' },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>
