{
  // Cloudflare Workers: the site in ./dist plus the API routes in worker/index.js.
  "name": "fackt",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Send the API to the worker before asset matching, so browser navigations to /api/* are not turned into the 404 page.
    "run_worker_first": ["/api/*"]
  },
  // Public settings live here so every deploy keeps them.
  // Secrets (GITHUB_CLIENT_SECRET, RESEND_API_KEY) stay in Cloudflare > Settings > Variables and secrets.
  "keep_vars": true,
  "vars": {
    "GITHUB_CLIENT_ID": "Ov23liYHGDrgubuGRqqS",
    "FORM_TO": "dominik@fackt.io",
    // Sender for form emails. fackt.io is verified in Resend; the Resend test sender only delivers to the Resend account owner.
    "FORM_FROM": "Fackt site <forms@fackt.io>"
  }
}
