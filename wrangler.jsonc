{
  // Cloudflare Workers: the site in ./dist plus the API routes in worker/index.js.
  "name": "fackt",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  // Public settings live here so every deploy keeps them.
  // Secrets (GITHUB_CLIENT_SECRET, RESEND_API_KEY) stay in Cloudflare > Settings > Variables and secrets.
  "keep_vars": true,
  "vars": {
    "GITHUB_CLIENT_ID": "Ov23liYHGDrgubuGRqqS",
    "FORM_TO": "dominik@fackt.io"
  }
}
